const status = element("model-status");
const enable = element<HTMLButtonElement>("enable-model");
const progress = element<HTMLProgressElement>("model-progress");
const source = element<HTMLSelectElement>("source");
const deck = element<HTMLSelectElement>("deck");
const generate = element<HTMLButtonElement>("generate");
const accept = element<HTMLButtonElement>("accept");
const notes = element<HTMLTextAreaElement>("notes");
const imageField = element<HTMLInputElement>("image");
const preview = element("cards");
const queue = element("queued");
const deckDialog = element<HTMLDialogElement>("deck-dialog");

const hints: Record<SourceKind, string> = {
  selection: "Highlight a passage in the current tab.",
  page: "Use the readable text on the current tab.",
  pdf: "Open a PDF in the current tab.",
  youtube: "Open a YouTube video to use its captions.",
  image: "Choose a file, paste an image, or capture the visible tab.",
  paste: "Use your own notes or copied text.",
};

let cards: Card[] = [];
let image: File | undefined;
let busy = false;
let claiming = false;
let runtime: Awaited<ReturnType<typeof createRuntime>> | undefined;
let downloading = false;

async function refreshStatus() {
  if (downloading) return;
  const current = await createRuntime();
  if (downloading) return;
  runtime = current;
  const { nano } = await current.provider.status();
  if (downloading) return;
  const labels = { available: "On-device ready", downloadable: "Available to download", downloading: "Downloading…", unavailable: "Unavailable" };
  status.textContent = current.mock ? "Demo mode" : labels[nano];
  status.className = `badge ${current.mock ? "neutral" : nano === "available" ? "device" : "neutral"}`;
  enable.hidden = current.mock || (nano !== "downloadable" && nano !== "downloading");
}

enable.addEventListener("click", async () => {
  if (!runtime || downloading) return;
  downloading = true;
  enable.disabled = true;
  progress.hidden = false;
  progress.removeAttribute("value");
  status.textContent = "Downloading…";
  try {
    await runtime.provider.initializeDeviceModel((value) => {
      progress.value = value;
      status.textContent = `Downloading ${Math.round(value * 100)}%`;
    });
  } catch (error) {
    notify(message(error, "On-device AI could not be enabled."), true);
  } finally {
    downloading = false;
    enable.disabled = false;
    progress.hidden = true;
    void refreshStatus().catch(reportError);
  }
});

function showSourceFields() {
  element("paste-fields").hidden = source.value !== "paste";
  element("image-fields").hidden = source.value !== "image";
  element("source-hint").textContent = hints[source.value as SourceKind];
}
source.addEventListener("change", showSourceFields);

function showImage(file?: File) {
  image = file;
  element("image-name").textContent = file?.name || "Pasted image";
  element("chosen-image").hidden = !file;
}

imageField.addEventListener("change", () => showImage(imageField.files?.[0]));
element("clear-image").addEventListener("click", () => {
  imageField.value = "";
  showImage();
});
window.addEventListener("paste", (event) => {
  const file = [...(event.clipboardData?.files ?? [])].find(({ type }) => type.startsWith("image/"));
  if (!file || busy) return;
  event.preventDefault();
  imageField.value = "";
  source.value = "image";
  showSourceFields();
  showImage(file);
});

async function refreshDecks(selected = deck.value) {
  const decks = await listDecks();
  deck.replaceChildren(...decks.map(({ id, name }) => new Option(name, id)));
  if (decks.some(({ id }) => id === selected)) deck.value = selected;
}

element("new-deck").addEventListener("click", () => {
  element<HTMLFormElement>("deck-form").reset();
  element("deck-error").hidden = true;
  deckDialog.showModal();
  element("deck-name").focus();
});
element("cancel-deck").addEventListener("click", () => deckDialog.close());
element("deck-form").addEventListener("submit", async (event) => {
  event.preventDefault();
  try {
    const added = await setDeckName(element<HTMLInputElement>("deck-name").value);
    await refreshDecks(added.id);
    deckDialog.close();
  } catch (error) {
    const hint = element("deck-error");
    hint.textContent = message(error, "Could not create this deck.");
    hint.hidden = false;
  }
});

function editField(labelText: string, value: string, onInput: (value: string) => void, max?: number) {
  const label = document.createElement("label");
  label.textContent = labelText;
  const input = max === undefined ? document.createElement("input") : document.createElement("textarea");
  if (max !== undefined && input instanceof HTMLTextAreaElement) {
    input.rows = 2;
    input.maxLength = max;
    input.required = true;
  } else {
    input.placeholder = "Separate tags with spaces";
  }
  input.value = value;
  input.addEventListener("input", () => onInput(input.value));
  label.append(input);
  return label;
}

function routeBadge(label: string, style: string, reason: string): HTMLElement {
  const details = document.createElement("details");
  details.className = "route";
  const summary = document.createElement("summary");
  summary.className = `badge ${style}`;
  summary.textContent = label;
  summary.title = reason;
  const explanation = document.createElement("p");
  explanation.className = "hint";
  explanation.textContent = reason;
  details.append(summary, explanation);
  return details;
}

function renderCards() {
  preview.replaceChildren();
  accept.hidden = !cards.length;
  element("empty-preview").hidden = !!cards.length;
  cards.forEach((card, index) => {
    const container = document.createElement("article");
    container.className = "surface card";
    const top = document.createElement("div");
    top.className = "row card-top";
    const local = card.route.source === "on_device";
    const badge = routeBadge(local ? "On-device" : "Cloud", local ? "device" : "cloud", card.route.reason);
    const remove = document.createElement("button");
    remove.className = "quiet small";
    remove.type = "button";
    remove.textContent = "Delete";
    remove.setAttribute("aria-label", `Delete card ${index + 1}`);
    remove.addEventListener("click", () => {
      cards = cards.filter(({ id }) => id !== card.id);
      renderCards();
    });
    top.append(badge, remove);
    container.append(
      top,
      editField(card.type === "cloze" ? "Front (cloze)" : "Front", card.front, (value) => { card.front = value; }, MAX_FRONT_LENGTH),
      editField("Back", card.back, (value) => { card.back = value; }, MAX_BACK_LENGTH),
      editField("Tags", (card.tags ?? []).join(" "), (value) => { card.tags = cardTags([value]); }),
    );
    preview.append(container);
  });
}

async function refreshQueue() {
  const entries = await db.all("queue");
  queue.hidden = !entries.length;
  queue.replaceChildren(...entries.map((entry: QueuedJob) => {
    const row = document.createElement("div");
    row.className = "row card-top";
    const title = document.createElement("span");
    title.textContent = entry.job.source?.title || "Capture";
    row.append(routeBadge("Queued", "queued", entry.lastError ?? entry.reason), title);
    return row;
  }));
}

function reportError(error: unknown) {
  notify(message(error, "Margin could not complete this action."), true);
}

function setBusy(value: boolean) {
  busy = value;
  generate.disabled = accept.disabled = deck.disabled = source.disabled = value;
  element<HTMLButtonElement>("new-deck").disabled = value;
  notes.disabled = imageField.disabled = element<HTMLButtonElement>("clear-image").disabled = value;
  preview.inert = value;
}

async function runCapture(request: CaptureRequest) {
  if (busy) return;
  setBusy(true);
  generate.textContent = "Generating…";
  element("toast").hidden = true;
  try {
    await refreshDecks();
    const selectedDeck = deck.value;
    const job = await captureSource(request, selectedDeck, notes.value, request.tabId === undefined ? image : undefined);
    const current = await createRuntime();
    const result = await generateCards(job, current.provider, { ...current, online: navigator.onLine });
    if (result?.queued) {
      await refreshQueue();
      notify("Capture queued. It will retry when you’re back online.");
      return;
    }
    const saved = (await db.all("cards")).filter(({ deckId }) => deckId === selectedDeck);
    const fresh = dedupe(result?.cards ?? [], [...saved, ...cards]);
    cards.push(...fresh);
    renderCards();
    if (!result?.cards?.length) notify("No cards found. Try a longer passage with complete facts.");
    else if (!fresh.length) notify("These cards are already in this deck or preview.");
    else notify(`${fresh.length} ${fresh.length === 1 ? "card" : "cards"} ready to review before saving.`);
  } catch (error) {
    reportError(error);
  } finally {
    setBusy(false);
    generate.textContent = "Generate";
  }
}

element("capture-form").addEventListener("submit", async (event) => {
  event.preventDefault();
  await runCapture({ kind: source.value as SourceKind });
  void claimPending().catch(reportError);
});

accept.addEventListener("click", async () => {
  if (busy) return;
  setBusy(true);
  try {
    const edited = cards.map((card, index) => {
      const valid = validate(card);
      if (!valid) throw new Error(`Card ${index + 1} needs a front and back. Cloze cards also need a {{c1::…}} deletion.`);
      return { ...card, ...valid };
    });
    const saved = await db.saveCards(deck.value, edited);
    const skipped = edited.length - saved;
    cards = [];
    renderCards();
    notify(`Saved ${saved} ${saved === 1 ? "card" : "cards"}.${skipped ? ` Skipped ${skipped} ${skipped === 1 ? "duplicate" : "duplicates"}.` : ""}`);
  } catch (error) {
    reportError(error);
  } finally {
    setBusy(false);
    void claimPending().catch(reportError);
  }
});

async function claimPending() {
  if (claiming || busy) return;
  claiming = true;
  try {
    const { id } = await chrome.windows.getCurrent();
    const prefix = `${PENDING_CAPTURE_PREFIX}${id}.`;
    await navigator.locks.request(prefix, async () => {
      while (!busy) {
        const pending = await chrome.storage.session.get();
        if (busy) return;
        const key = Object.keys(pending).filter((entry) => entry.startsWith(prefix)).sort()[0];
        if (!key) return;
        const request = pending[key] as CaptureRequest;
        source.value = request.kind;
        showSourceFields();
        await runCapture(request);
        await chrome.storage.session.remove(key);
      }
    });
  } finally {
    claiming = false;
  }
}

async function start() {
  await refreshDecks();
  showSourceFields();
  chrome.runtime.onMessage.addListener((msg: { type?: string }) => {
    if (msg.type === "margin.capture") void claimPending().catch(reportError);
  });
  chrome.storage.onChanged.addListener((changes, area) => {
    if (area === "local") void refreshStatus().catch(reportError);
    if (area === "session" && Object.keys(changes).some((key) => key.startsWith(PENDING_CAPTURE_PREFIX))) {
      void claimPending().catch(reportError);
    }
  });
  window.addEventListener("focus", () => {
    if (!busy) void refreshDecks().catch(reportError);
    void refreshQueue().catch(reportError);
  });
  const stop = startQueueDrain(async (job) => {
    const current = await createRuntime();
    const result = await generateCards(job, current.provider, { ...current, online: navigator.onLine }, { queueIfOffline: false });
    return result?.cards;
  }, reportError, () => { void refreshQueue().catch(reportError); });
  window.addEventListener("pagehide", stop, { once: true });
  await Promise.all([refreshStatus(), refreshQueue(), claimPending()]);
}

void start().catch(reportError);
import { drainQueue } from "../ai/queue";
import { createRuntime, generateCards } from "../ai/runtime";
import type { Deck } from "../cards/schema";
import { cardStats, formatBytes } from "../cards/stats";
import { buildTsv } from "../export/tsv";
import { isConfigured, shouldUseMock } from "../firebase/config";
import { db } from "../storage/db";
import { listDecks, setDeckName } from "../storage/decks";
import { inferenceModes, readSettings, type ModeOverride, type Settings } from "../storage/settings";
import { downloadFile, element, message, notify } from "./shared";

const privacy = element<HTMLInputElement>("privacy-mode");
const demo = element<HTMLInputElement>("demo-mode");
const mode = element<HTMLSelectElement>("inference-mode");
const debugToken = element<HTMLInputElement>("debug-token");
const exportDeck = element<HTMLSelectElement>("export-deck");
const tsvButton = element<HTMLButtonElement>("export-tsv");
const apkgButton = element<HTMLButtonElement>("export-apkg");

function showActiveSettings(mock: boolean) {
  element("demo").hidden = !shouldUseMock(mock);
  element("firebase-status").textContent = isConfigured()
    ? "Firebase configuration is present."
    : "Firebase is unconfigured. Margin uses demo mode.";
}

function onError(error: unknown) {
  notify(message(error, "Margin could not complete this action."), true);
}

async function saveSettings(changes: Partial<Settings>, text = "Settings saved.") {
  try {
    await chrome.storage.local.set(changes);
    showActiveSettings(demo.checked);
    notify(text);
  } catch (error) {
    onError(error);
  }
}

async function showRemoteConfig() {
  const { config } = await createRuntime();
  const labels = {
    maxOnDeviceTokens: "On-device token limit",
    cloudModel: "Cloud model",
    longDocModel: "Long-document model",
    sensitivityCheck: "Sensitivity check",
    maxCardsPerChunk: "Cards per chunk",
  };
  element("remote-config").replaceChildren(...Object.entries(config).map(([key, value]) => {
    const row = document.createElement("div");
    const term = document.createElement("dt");
    term.textContent = labels[key as keyof typeof labels];
    const description = document.createElement("dd");
    description.textContent = String(value);
    row.append(term, description);
    return row;
  }));
}

privacy.addEventListener("change", () => {
  mode.disabled = privacy.checked;
  void saveSettings({ privacyMode: privacy.checked });
});
demo.addEventListener("change", () => {
  void saveSettings({ mock: demo.checked }).then(showRemoteConfig).catch(onError);
});
mode.addEventListener("change", () => { void saveSettings({ modeOverride: mode.value as ModeOverride }); });
element("debug-form").addEventListener("submit", (event) => {
  event.preventDefault();
  void saveSettings({ appCheckDebugToken: debugToken.value.trim() }, "App Check token saved. Reopen Margin to apply it.");
});

function deckEditor(deck: Deck): HTMLFormElement {
  const form = document.createElement("form");
  form.className = "deck-editor stack";
  const label = document.createElement("label");
  label.textContent = "Deck name";
  const name = document.createElement("input");
  name.value = deck.name;
  name.maxLength = 80;
  name.required = true;
  label.append(name);
  const buttons = document.createElement("div");
  buttons.className = "actions";

  const rename = document.createElement("button");
  rename.type = "submit";
  rename.className = "secondary small";
  rename.textContent = "Rename";
  const remove = document.createElement("button");
  remove.type = "button";
  remove.className = "quiet danger small";
  remove.textContent = "Delete";
  buttons.append(rename, remove);
  form.append(label, buttons);

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    rename.disabled = remove.disabled = true;
    void setDeckName(name.value, deck).then(async () => {
      await refreshLibrary();
      notify("Deck renamed.");
    }).catch(onError).finally(() => { rename.disabled = remove.disabled = false; });
  });
  remove.addEventListener("click", () => {
    if (!confirm(`Delete “${deck.name}” and its cards, review history, and queued captures?`)) return;
    rename.disabled = remove.disabled = true;
    void navigator.locks.request("margin-decks", () => db.deleteDeck(deck.id)).then(async () => {
      await Promise.all([refreshLibrary(), refreshQueue()]);
      notify("Deck deleted.");
    }).catch(onError).finally(() => { rename.disabled = remove.disabled = false; });
  });
  return form;
}

async function refreshLibrary() {
  const previous = exportDeck.value;
  const [decks, cards] = await Promise.all([listDecks(), db.all("cards")]);
  exportDeck.replaceChildren(new Option("All decks", ""), ...decks.map(({ id, name }) => new Option(name, id)));
  if (decks.some(({ id }) => id === previous)) exportDeck.value = previous;
  element("managed-decks").replaceChildren(...decks.map(deckEditor));
  const stats = cardStats(cards);
  element("on-device-percent").textContent = `${stats.onDevicePercent}%`;
  element("bytes-local").textContent = formatBytes(stats.localBytes);
}

async function exportCards(format: "tsv" | "apkg") {
  tsvButton.disabled = apkgButton.disabled = true;
  try {
    const id = exportDeck.value;
    const [allCards, allDecks] = await Promise.all([db.all("cards"), listDecks()]);
    const cards = allCards.filter((card) => !id || card.deckId === id);
    const decks = allDecks.filter((deck) => !id || deck.id === id);
    if (!cards.length) throw new Error("There are no saved cards to export in this selection.");
    const name = id ? decks[0]?.name ?? "Margin" : "Margin";
    const filename = `${name.replace(/[\\/:*?"<>|]/gu, "-")}.${format}`;
    if (format === "tsv") {
      downloadFile(buildTsv(cards, decks), filename, "text/tab-separated-values;charset=utf-8");
    } else {
      const { buildApkg } = await import("../export/apkg");
      const bytes = await buildApkg(cards, decks);
      downloadFile(Uint8Array.from(bytes), filename, "application/octet-stream");
    }
    notify(`Exported ${cards.length} ${cards.length === 1 ? "card" : "cards"}.`);
  } catch (error) {
    onError(error);
  } finally {
    tsvButton.disabled = apkgButton.disabled = false;
  }
}

tsvButton.addEventListener("click", () => { void exportCards("tsv"); });
apkgButton.addEventListener("click", () => { void exportCards("apkg"); });

async function refreshQueue() {
  const [queue, decks] = await Promise.all([db.all("queue"), db.all("decks")]);
  const list = element("queue-list");
  if (!queue.length) {
    const empty = document.createElement("p");
    empty.className = "hint";
    empty.textContent = "No captures waiting to retry.";
    list.replaceChildren(empty);
    return;
  }

  list.replaceChildren(...queue.sort((a, b) => a.createdAt - b.createdAt).map((entry) => {
    const job = document.createElement("article");
    job.className = "queue-item stack";
    const title = document.createElement("h3");
    title.textContent = entry.job.source?.title || "Untitled capture";
    const badge = document.createElement("span");
    badge.className = "badge queued";
    badge.textContent = "Queued";
    const deck = decks.find(({ id }) => id === entry.job.deckId);
    const reason = document.createElement("p");
    reason.className = "hint";
    reason.textContent = [deck?.name, entry.lastError ?? entry.reason].filter(Boolean).join(" · ");
    const retry = document.createElement("button");
    retry.type = "button";
    retry.className = "secondary small";
    retry.textContent = "Retry";
    const remove = document.createElement("button");
    remove.type = "button";
    remove.className = "quiet danger small";
    remove.textContent = "Remove";
    const actions = document.createElement("div");
    actions.className = "actions";
    actions.append(retry, remove);

    retry.addEventListener("click", async () => {
      if (!navigator.onLine) {
        notify("Reconnect to retry this capture.", true);
        return;
      }
      retry.disabled = remove.disabled = true;
      retry.textContent = "Retrying…";
      try {
        await drainQueue(async (pending) => {
          const current = await createRuntime();
          const result = await generateCards(pending, current.provider, { ...current, online: navigator.onLine }, { queueIfOffline: false });
          return result?.cards;
        }, () => navigator.onLine, db, entry.id);
        const remaining = await db.get("queue", entry.id);
        if (remaining) notify(remaining.lastError ?? "This capture is still queued.", true);
        else notify("Queued capture processed.");
        await Promise.all([refreshLibrary(), refreshQueue()]);
      } catch (error) {
        onError(error);
      } finally {
        retry.disabled = remove.disabled = false;
        retry.textContent = "Retry";
      }
    });
    remove.addEventListener("click", () => {
      void db.delete("queue", entry.id).then(refreshQueue).catch(onError);
    });
    job.append(title, badge, reason, actions);
    return job;
  }));
}

async function start() {
  const settings = await readSettings();
  privacy.checked = settings.privacyMode;
  demo.checked = settings.mock;
  mode.replaceChildren(...inferenceModes.map(([value, label]) => new Option(label, value)));
  mode.value = settings.modeOverride;
  mode.disabled = settings.privacyMode;
  debugToken.value = settings.appCheckDebugToken ?? "";
  showActiveSettings(settings.mock);
  await Promise.all([refreshLibrary(), refreshQueue(), showRemoteConfig()]);
}

void start().catch(onError);
export const element = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

export function message(error: unknown, fallback: string): string {
  return error instanceof Error ? error.message : fallback;
}

export function notify(text: string, error = false): void {
