import { InferenceMode } from "firebase/ai";
import type { RoutingConfig } from "../firebase/remoteConfig";
import type { ContentInput, GenerationJob } from "./provider";
import type { ModeOverride } from "../storage/settings";

export interface RoutingContext extends RoutingConfig {
  nanoAvailable: boolean;
  online: boolean;
  privacyMode: boolean;
  modeOverride?: ModeOverride;
  classifiedSensitive?: boolean;
}

type Decision =
  | { mode: InferenceMode; reason: string; cloudModel: string; chunks?: string[] }
  | { mode: "queue"; reason: string };

const CHARS_PER_TOKEN = 4;
const IMAGE_TOKEN_ALLOWANCE = 1_024;

export function estimateTokens(text: string): number {
  return Math.ceil(text.length / CHARS_PER_TOKEN);
}

export function estimateInputTokens(input: ContentInput): number {
  return estimateTokens(input.text ?? "") + (input.kind === "image" ? IMAGE_TOKEN_ALLOWANCE : 0);
}

export function canRunOnDevice(input: ContentInput): boolean {
  return input.kind === "text" ||
    (input.kind === "image" && ["image/png", "image/jpeg"].includes(input.mimeType));
}

export function chunkText(text: string, budget: number): string[] {
  const limit = budget * CHARS_PER_TOKEN;
  if (!Number.isSafeInteger(limit) || limit < CHARS_PER_TOKEN) throw new RangeError("Invalid token budget.");
  const chunks: string[] = [];
  let start = 0;
  while (text.length - start > limit) {
    const window = text.slice(start, start + limit);
    const boundary = Math.max(window.lastIndexOf("\n"), window.lastIndexOf(" "));
    let length = boundary >= limit / 2 ? boundary + 1 : limit;
    // Keep UTF-16 surrogate pairs together at a hard split.
    if (/[\uD800-\uDBFF]/u.test(window[length - 1])) length--;
    chunks.push(text.slice(start, start + length));
    start += length;
  }
  if (start < text.length) chunks.push(text.slice(start));
  return chunks;
}

const PRIVATE_PATTERNS = [
  /\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b/iu,
  /\b\d{3}-\d{2}-\d{4}\b/u,
  /\b(?:\d[ -]?){12,18}\d\b/u,
  /(?:\+\d{1,3}[ -]?)?(?:\(\d{3}\)[ -]?|\b\d{3}[ .-])\d{3}[ .-]\d{4}\b/u,
  /\b(?:password|api[ _-]?key|access[ _-]?token)\s*[:=]\s*\S+/iu,
  /\b(?:strictly confidential|internal use only|do not distribute)\b/iu,
];

export function hasSensitiveText(text: string): boolean {
  return PRIVATE_PATTERNS.some((pattern) => pattern.test(text));
}

export function isSensitive(job: GenerationJob, ctx: RoutingContext): boolean {
  return job.sensitive === true ||
    (ctx.sensitivityCheck && (ctx.classifiedSensitive === true || hasSensitiveText(job.input.text ?? "")));
}

export function decide(job: GenerationJob, ctx: RoutingContext): Decision {
  const { input } = job;
  const sensitive = isSensitive(job, ctx);
  const privateRoute = ctx.privacyMode || sensitive || ctx.modeOverride === "only-device";
  const supported = canRunOnDevice(input);
  const overBudget = estimateInputTokens(input) > ctx.maxOnDeviceTokens;
  const needsCloud = input.kind === "pdf" ? "PDFs without enough extractable text require cloud inference."
    : input.kind === "youtube" ? "YouTube videos without accessible captions require cloud inference."
    : "This image format requires cloud inference.";

  if (privateRoute) {
    const reason = ctx.privacyMode ? "Privacy mode keeps this content on-device."
      : sensitive ? "Sensitive content stays on-device." : "Your settings require on-device inference.";
    if (input.kind === "pdf") {
      throw new Error(`${reason} Extract the PDF text and try again with the text.`);
    }
    if (input.kind === "youtube") throw new Error(`${reason} Paste the video's transcript to generate cards from it.`);
    if (!supported) throw new Error(`${reason} Convert the image to PNG or JPEG and try again.`);
    if (!ctx.nanoAvailable) throw new Error(`${reason} Gemini Nano is unavailable. Enable the on-device model and try again.`);
    if (overBudget && input.kind !== "text") {
      throw new Error(`${reason} Remove some accompanying text or use a smaller image.`);
    }
    const chunks = overBudget && input.kind === "text" ? chunkText(input.text, ctx.maxOnDeviceTokens) : undefined;
    return {
      mode: InferenceMode.ONLY_ON_DEVICE,
      reason: chunks ? `${reason} The text is split into ${chunks.length} on-device chunks.` : reason,
      cloudModel: ctx.cloudModel,
      chunks,
    };
  }

  const onlyCloud = ctx.modeOverride === "only-cloud";
  if (!ctx.online) {
    if (!onlyCloud && ctx.nanoAvailable && supported && !overBudget) {
      return { mode: InferenceMode.ONLY_ON_DEVICE, reason: "Offline. Gemini Nano can process this on-device.", cloudModel: ctx.cloudModel };
    }
    const why = onlyCloud ? "Your settings require cloud inference." : !supported ? needsCloud : overBudget
      ? "This input exceeds the on-device token budget."
      : "Gemini Nano is unavailable.";
    return { mode: "queue", reason: `Offline. ${why} Queued until a connection is available.` };
  }

  if (!supported) {
    return {
      mode: InferenceMode.ONLY_IN_CLOUD, reason: needsCloud,
      cloudModel: input.kind === "image" ? ctx.cloudModel : ctx.longDocModel,
    };
  }
  if (onlyCloud) {
    return { mode: InferenceMode.ONLY_IN_CLOUD, reason: "Your settings require cloud inference.", cloudModel: overBudget ? ctx.longDocModel : ctx.cloudModel };
  }
  if (overBudget) {
    if (ctx.modeOverride === "prefer-device" && ctx.nanoAvailable && input.kind === "text") {
      const chunks = chunkText(input.text, ctx.maxOnDeviceTokens);
      return { mode: InferenceMode.ONLY_ON_DEVICE, reason: `Your settings prefer on-device inference. The text is split into ${chunks.length} chunks.`, cloudModel: ctx.cloudModel, chunks };
    }
    return { mode: InferenceMode.ONLY_IN_CLOUD, reason: "This input exceeds the on-device token budget.", cloudModel: ctx.longDocModel };
  }
  if (ctx.modeOverride === "prefer-cloud") {
    return { mode: InferenceMode.PREFER_IN_CLOUD, reason: "Your settings prefer cloud inference.", cloudModel: ctx.cloudModel };
  }
  return {
    mode: InferenceMode.PREFER_ON_DEVICE,
    reason: ctx.nanoAvailable
      ? "This input fits the on-device token budget. Prefer Gemini Nano."
      : "Gemini Nano is unavailable. Cloud inference is available.",
    cloudModel: ctx.cloudModel,
  };
}
import type { InferenceMode, InferenceSource } from "firebase/ai";
import type { Card } from "../cards/schema";

export type MediaInput =
  | { kind: "pdf"; mimeType: "application/pdf"; data: string }
  | { kind: "image"; mimeType: string; data: string };

export type ContentInput =
  | { kind: "text"; text: string }
  | { kind: "youtube"; url: string; text?: never }
  | (MediaInput & { text?: string });

export interface GenerationJob {
  input: ContentInput;
  deckId: string;
  sensitive?: boolean;
  source?: Card["source"];
}

export type InferenceTask =
  | { kind: "cards"; input: ContentInput }
  | { kind: "grade"; question: string; expected: string; answer: string }
  | { kind: "sensitivity"; text: string };

export type LocalAvailability = "available" | "downloadable" | "downloading" | "unavailable";

export interface InferenceRequest {
  task: InferenceTask;
  mode: InferenceMode;
  reason: string;
  cloudModel: string;
  repair?: boolean;
}

export interface InferenceResult {
  text: string;
  source: InferenceSource;
  reason: string;
}

export interface AIProvider {
  status(): Promise<{ nano: LocalAvailability }>;
  initializeDeviceModel(onProgress?: (progress: number) => void): Promise<void>;
  generate(request: InferenceRequest): Promise<InferenceResult>;
}
import { InferenceMode, InferenceSource } from "firebase/ai";
import { dedupe } from "../cards/dedupe";
import { parseCardResponse } from "../cards/parse";
import type { Card } from "../cards/schema";
import { shouldUseMock } from "../firebase/config";
import { initializeFirebase } from "../firebase/init";
import { loadRemoteConfig, type RoutingConfig } from "../firebase/remoteConfig";
import { readSettings, type ModeOverride } from "../storage/settings";
import { FirebaseProvider } from "./firebaseProvider";
import { MockProvider } from "./mockProvider";
import type { AIProvider, GenerationJob, InferenceRequest } from "./provider";
import { enqueue, type QueuedJob } from "./queue";
import { chunkText, decide, estimateInputTokens, isSensitive, type RoutingContext } from "./router";

export async function createRuntime() {
  const settings = await readSettings();
  const mock = shouldUseMock(settings.mock);
  const app = mock ? undefined : initializeFirebase(settings);
  // Reuse the settings snapshot for one job so its privacy decisions stay consistent.
  const config = await loadRemoteConfig(app);
  const provider = app ? new FirebaseProvider(app, config) : new MockProvider(config);
  return { mock, provider, config, privacyMode: settings.privacyMode, modeOverride: settings.modeOverride };
}

export interface GenerationContext {
  config: RoutingConfig;
  privacyMode: boolean;
  online: boolean;
  modeOverride?: ModeOverride;
}

type GenerationOutcome =
  | { cards: Card[]; queued?: never }
  | { cards?: never; queued: QueuedJob };

