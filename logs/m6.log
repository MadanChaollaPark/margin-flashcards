    const path = prefix + entry.name;
    const url = new URL(path + (entry.isDirectory() ? \"/\" : \"\"), dist);
    if (entry.isDirectory()) await addFiles(url, path + \"/\");
    else if (entry.isFile()) files[path] = await readFile(url);
  }
}

