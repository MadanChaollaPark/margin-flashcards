  element("firebase-status").textContent = isConfigured()
    ? "Firebase configuration is present."
    : "Firebase is unconfigured. Margin uses demo mode.";
}

function onError(error: unknown) {
  notify(message(error, "Margin could not complete this action."), true);
}

async function saveSettings(changes: Partial<Settings>, text = "Settings saved.") {
  try {
    await chrome.storage.local.set(changes);
    showActiveSettings(demo.checked);
    notify(text);
  } catch (error) {
    onError(error);
  }
}

async function showRemoteConfig() {
  const { config } = await createRuntime();
  const labels = {
    maxOnDeviceTokens: "On-device token limit",
    cloudModel: "Cloud model",
    longDocModel: "Long-document model",
    sensitivityCheck: "Sensitivity check",
    maxCardsPerChunk: "Cards per chunk",
  };
  element("remote-config").replaceChildren(...Object.entries(config).map(([key, value]) => {
    const row = document.createElement("div");
    const term = document.createElement("dt");
    term.textContent = labels[key as keyof typeof labels];
    const description = document.createElement("dd");
    description.textContent = String(value);
    row.append(term, description);
    return row;
  }));
}

