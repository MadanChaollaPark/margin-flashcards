import { defineConfig } from "@playwright/test";

export default defineConfig({
  testDir: "./test/e2e",
  reporter: "list",
});
import type { FirebaseOptions } from "firebase/app";

declare const __MARGIN_MOCK__: boolean;

// PLACEHOLDER ONLY. Supply your own Firebase web app configuration locally.
// Keep real project configuration and App Check debug tokens out of Git.
export const firebaseConfig: FirebaseOptions = {
  apiKey: "REPLACE_ME",
  appId: "REPLACE_ME",
  projectId: "REPLACE_ME",
};

export function isConfigured(config = firebaseConfig): boolean {
  return [config.apiKey, config.appId, config.projectId].every(
    (value) => !!value?.trim() && value.trim() !== "REPLACE_ME",
  );
}

export function shouldUseMock(settingsMock: boolean): boolean {
  const mockBuild = typeof __MARGIN_MOCK__ !== "undefined" && __MARGIN_MOCK__;
  return mockBuild || settingsMock || !isConfigured();
}
import { getApps, initializeApp, type FirebaseApp } from "firebase/app";
import { CustomProvider, initializeAppCheck } from "firebase/app-check";
import type { Settings } from "../storage/settings";
import { firebaseConfig, isConfigured } from "./config";

let initializedApp: FirebaseApp | undefined;

export function initializeFirebase(settings: Pick<Settings, "appCheckDebugToken">): FirebaseApp {
  if (!isConfigured()) throw new Error("Fill in the Firebase configuration before enabling Firebase.");

  if (!initializedApp) {
    const scope = self as typeof self & { FIREBASE_APPCHECK_DEBUG_TOKEN?: boolean | string };
    scope.FIREBASE_APPCHECK_DEBUG_TOKEN = settings.appCheckDebugToken || true;

    const app = getApps().find(({ name }) => name === "margin") ?? initializeApp(firebaseConfig, "margin");
    initializeAppCheck(app, {
      // App Check bypasses this provider when a debug token is enabled.
      // A production extension needs its own token issuer for CustomProvider.
      provider: new CustomProvider({
        getToken: async () => { throw new Error("Configure an App Check token issuer for production."); },
      }),
      isTokenAutoRefreshEnabled: true,
    });
    initializedApp = app;
  }
  return initializedApp;
}
import type { FirebaseApp } from "firebase/app";
import { fetchAndActivate, getBoolean, getNumber, getRemoteConfig, getString, isSupported } from "firebase/remote-config";
import { MAX_CARDS } from "../cards/schema";

export const DEFAULTS = {
  maxOnDeviceTokens: 6_000,
  cloudModel: "gemini-3.5-flash-lite",
  longDocModel: "gemini-3.8-flash",
  sensitivityCheck: true,
  maxCardsPerChunk: 12,
};

export type RoutingConfig = typeof DEFAULTS;
const TIMEOUT_MS = 1_500;
// Leave room in Nano's 9,216-token context for the generation prompt and schema.
const MAX_INPUT_BUDGET = 8_000;

function boundedInteger(value: number, max: number, fallback: number): number {
  return Number.isSafeInteger(value) && value > 0 && value <= max ? value : fallback;
}

export async function loadRemoteConfig(app?: FirebaseApp): Promise<RoutingConfig> {
  if (!app) return { ...DEFAULTS };

  let timer: ReturnType<typeof setTimeout> | undefined;
  try {
    const timeout = new Promise<RoutingConfig>((resolve) => {
      timer = setTimeout(() => resolve({ ...DEFAULTS }), TIMEOUT_MS);
    });
    return await Promise.race([readRemoteConfig(app), timeout]);
  } catch {
    return { ...DEFAULTS };
  } finally {
    clearTimeout(timer);
  }
}

async function readRemoteConfig(app: FirebaseApp): Promise<RoutingConfig> {
  if (!await isSupported()) return { ...DEFAULTS };

  const remote = getRemoteConfig(app);
  remote.defaultConfig = { ...DEFAULTS };
  remote.settings.fetchTimeoutMillis = TIMEOUT_MS;
  await fetchAndActivate(remote);
  return {
    maxOnDeviceTokens: boundedInteger(getNumber(remote, "maxOnDeviceTokens"), MAX_INPUT_BUDGET, DEFAULTS.maxOnDeviceTokens),
    cloudModel: getString(remote, "cloudModel").trim() || DEFAULTS.cloudModel,
    longDocModel: getString(remote, "longDocModel").trim() || DEFAULTS.longDocModel,
    sensitivityCheck: getBoolean(remote, "sensitivityCheck"),
    maxCardsPerChunk: boundedInteger(getNumber(remote, "maxCardsPerChunk"), MAX_CARDS, DEFAULTS.maxCardsPerChunk),
  };
}

