});

test("the optional on-device sensitivity gate precedes any cloud-capable generation", async () => {
  const mock = new MockProvider();
  const calls: InferenceRequest[] = [];
  const provider: AIProvider = {
    status: () => mock.status(),
    initializeDeviceModel: () => mock.initializeDeviceModel(),
    generate: (req) => { calls.push(req); return mock.generate(req); },
  };
  const privateJob: GenerationJob = {
    ...job, input: { kind: "text", text: "This is a confidential memo for the legal team." },
  };
  const result = await generateCards(privateJob, provider, { config: DEFAULTS, online: true, privacyMode: false });
  assert.deepEqual(calls.map(({ task, mode }) => [task.kind, mode]), [
    ["sensitivity", InferenceMode.ONLY_ON_DEVICE], ["cards", InferenceMode.ONLY_ON_DEVICE],
  ]);
  assert.equal(result?.cards?.[0].route.source, "on_device");
  assert.match(result?.cards?.[0].route.reason ?? "", /sensitive/i);
});

test("the offline queue retains failures and atomically saves cards on retry", async () => {
  const database = createMemoryDatabase();
  const entry = await enqueue(job, "Offline.", database);
  let runs = 0;
  await drainQueue(async () => { runs++; return []; }, () => false, database);
  assert.equal(runs, 0);

  await drainQueue(async () => { throw new Error("Try again."); }, () => true, database);
  assert.equal((await database.get("queue", entry.id))?.lastError, "Try again.");
  assert.equal((await database.get("queue", entry.id))?.attempts, 1);

  await drainQueue(async (queued) => {
    const result = await generateCards(queued, new MockProvider(), { config: DEFAULTS, online: true, privacyMode: false });
    return result?.cards;
  }, () => true, database);

  assert.equal(await database.get("queue", entry.id), undefined);
  assert.equal((await database.all("cards")).length, 2);
});

test("a malformed model response gets one repair attempt in the same inference mode", async () => {
  const mock = new MockProvider();
  const calls: InferenceRequest[] = [];
  const provider: AIProvider = {
    status: () => mock.status(),
    initializeDeviceModel: () => mock.initializeDeviceModel(),
    async generate(req) {
      calls.push(req);
      const output = await mock.generate(req);
      return req.repair ? output : { ...output, text: "Unparseable result." };
    },
  };
  const result = await generateCards(job, provider, { config: DEFAULTS, online: true, privacyMode: true });
  assert.deepEqual(calls.map(({ mode, repair }) => [mode, repair]), [
    [InferenceMode.ONLY_ON_DEVICE, false], [InferenceMode.ONLY_ON_DEVICE, true],
  ]);
  assert.equal(result?.cards?.length, 2);
});
import assert from "node:assert/strict";
import { test } from "node:test";
import { InferenceMode } from "firebase/ai";
import { chunkText, decide, estimateTokens, hasSensitiveText } from "../../src/ai/router";
import type { ContentInput, GenerationJob } from "../../src/ai/provider";
import { DEFAULTS } from "../../src/firebase/remoteConfig";

const ctx = { ...DEFAULTS, nanoAvailable: true, online: true, privacyMode: false };
const text = "Plants use sunlight to produce sugar.";
const long = text.repeat(2_223);
const asJob = (input: ContentInput): GenerationJob => ({ input, deckId: "notes" });
const notes = asJob({ kind: "text", text });
const longDoc = asJob({ kind: "text", text: long });
const pdf = asJob({ kind: "pdf", mimeType: "application/pdf", data: "cGRm" });
const image = (mimeType: string) => asJob({ kind: "image", mimeType, data: "aW1hZ2U=" });

function route(job = notes, overrides: Partial<typeof ctx> & { classifiedSensitive?: boolean } = {}) {
  const decision = decide(job, { ...ctx, ...overrides });
  assert.ok(decision.reason.trim());
  return decision;
}

test("uses hybrid for short text, PNG and JPEG, including when Nano is unavailable", () => {
  assert.equal(route().mode, InferenceMode.PREFER_ON_DEVICE);
  assert.equal(route(notes, { nanoAvailable: false }).mode, InferenceMode.PREFER_ON_DEVICE);
  for (const mimeType of ["image/png", "image/jpeg"]) {
    assert.equal(route(image(mimeType)).mode, InferenceMode.PREFER_ON_DEVICE);
  }
  assert.equal(route(image("image/webp")).mode, InferenceMode.ONLY_IN_CLOUD);
  assert.equal(route(image("image/png"), { maxOnDeviceTokens: 1_023 }).mode, InferenceMode.ONLY_IN_CLOUD);
});

test("routes PDF bytes to the cloud and suggests text extraction in privacy mode", () => {
  const decision = route(pdf);
  if (decision.mode === "queue") assert.fail("expected cloud");
  assert.equal(decision.mode, InferenceMode.ONLY_IN_CLOUD);
  assert.equal(decision.cloudModel, DEFAULTS.longDocModel);
  assert.throws(() => route(pdf, { privacyMode: true }), /extract the PDF text/i);
});

test("sends roughly 20k tokens to the long-doc model and chunks sensitive text", () => {
  assert.ok(estimateTokens(long) >= 20_000);
  const cloud = route(longDoc);
  if (cloud.mode === "queue") assert.fail("expected cloud");
  assert.equal(cloud.mode, InferenceMode.ONLY_IN_CLOUD);
  assert.equal(cloud.cloudModel, DEFAULTS.longDocModel);

  for (const privacyMode of [false, true]) {
    const local = route({ ...longDoc, sensitive: !privacyMode }, { privacyMode });
    if (local.mode === "queue") assert.fail("expected local");
    assert.equal(local.mode, InferenceMode.ONLY_ON_DEVICE);
    assert.ok(local.chunks && local.chunks.length > 1);
    assert.equal(local.chunks.join(""), long);
    assert.ok(local.chunks.every((chunk) => estimateTokens(chunk) <= DEFAULTS.maxOnDeviceTokens));
  }

  const unicode = "aaa🌱bbb cc";
  assert.equal(chunkText(unicode, 1).join(""), unicode);
  assert.ok(!chunkText(unicode, 1).some((chunk) => /[\uD800-\uDBFF]$/u.test(chunk)));
});

test("privacy mode stays local and reports when Nano is unavailable", () => {
  assert.equal(route(notes, { privacyMode: true }).mode, InferenceMode.ONLY_ON_DEVICE);
  assert.throws(() => route(notes, { privacyMode: true, nanoAvailable: false }), /Gemini Nano is unavailable/i);
  assert.throws(() => route(image("image/gif"), { privacyMode: true }), /PNG or JPEG/i);
});

test("PII, explicit labels and Nano classifications pin content on-device", () => {
  for (const value of ["learner@example.invalid", "123-45-6789", "(555) 010-0123",
    "access_token = fake-example", "strictly confidential", "4111 1111 1111 1111"]) {
    assert.ok(hasSensitiveText(value), value);
    assert.equal(route(asJob({ kind: "text", text: value })).mode, InferenceMode.ONLY_ON_DEVICE);
  }
  assert.equal(route(notes, { classifiedSensitive: true }).mode, InferenceMode.ONLY_ON_DEVICE);
  assert.equal(route(notes, { classifiedSensitive: true, sensitivityCheck: false }).mode, InferenceMode.PREFER_ON_DEVICE);
  assert.equal(route({ ...notes, sensitive: true }, { sensitivityCheck: false }).mode, InferenceMode.ONLY_ON_DEVICE);
  assert.throws(() => route({ ...notes, sensitive: true }, { nanoAvailable: false }), /sensitive content stays on-device/i);
});

test("runs compatible jobs locally while offline and queues cloud jobs", () => {
  assert.equal(route(notes, { online: false }).mode, InferenceMode.ONLY_ON_DEVICE);
  assert.equal(route(notes, { online: false, nanoAvailable: false }).mode, "queue");
  assert.equal(route(pdf, { online: false }).mode, "queue");
  assert.equal(route(longDoc, { online: false }).mode, "queue");
  assert.equal(route({ ...longDoc, sensitive: true }, { online: false }).mode, InferenceMode.ONLY_ON_DEVICE);
  assert.throws(() => route({ ...notes, sensitive: true }, { online: false, nanoAvailable: false }), /Nano is unavailable/i);
});

test("honors overrides while preserving privacy and sensitivity and queues offline cloud-only jobs", () => {
  assert.equal(decide(notes, { ...ctx, modeOverride: "only-cloud" }).mode, InferenceMode.ONLY_IN_CLOUD);
  assert.equal(decide(notes, { ...ctx, modeOverride: "only-cloud", online: false }).mode, "queue");
  assert.equal(decide(notes, { ...ctx, modeOverride: "prefer-cloud" }).mode, InferenceMode.PREFER_IN_CLOUD);
  assert.equal(decide(notes, { ...ctx, modeOverride: "only-device" }).mode, InferenceMode.ONLY_ON_DEVICE);
  assert.equal(decide(longDoc, { ...ctx, modeOverride: "prefer-device" }).mode, InferenceMode.ONLY_ON_DEVICE);
  assert.equal(decide(notes, { ...ctx, modeOverride: "only-cloud", privacyMode: true }).mode, InferenceMode.ONLY_ON_DEVICE);
  assert.equal(decide({ ...notes, sensitive: true }, { ...ctx, modeOverride: "only-cloud" }).mode, InferenceMode.ONLY_ON_DEVICE);
  const video = asJob({ kind: "youtube", url: "https://www.youtube.com/watch?v=dQw4w9WgXcQ" });
  assert.equal(decide(video, ctx).mode, InferenceMode.ONLY_IN_CLOUD);
  assert.throws(() => decide(video, { ...ctx, privacyMode: true }), /paste the video's transcript/iu);
});
import { readFile, mkdtemp, rm } from "node:fs/promises";
import { createServer } from "node:http";
import { tmpdir } from "node:os";
import { resolve } from "node:path";
import { chromium, expect, test as base, type BrowserContext, type Page, type Worker } from "@playwright/test";
import { strFromU8, unzipSync } from "fflate";

const fixtureDir = resolve("test/fixtures");
const piiSample = "The practice account contact is learner@example.invalid. The workshop starts at nine in the morning.";

type Margin = {
  context: BrowserContext;
  worker: Worker;
  extension: string;
  site: string;
  errors: string[];
};

const test = base.extend<{ margin: Margin }>({
  margin: async ({}, use) => {
    const paths: Record<string, string> = { "/article.html": "text/html", "/text.pdf": "application/pdf", "/scan.pdf": "application/pdf" };
    const server = createServer(async (request, response) => {
      const path = request.url ?? "/";
      if (!paths[path]) {
        response.writeHead(204).end();
        return;
      }
      try {
        const bytes = await readFile(resolve(fixtureDir, path.slice(1)));
        response.writeHead(200, { "Content-Type": paths[path], "Content-Length": bytes.length }).end(bytes);
      } catch {
        response.writeHead(500).end();
      }
    });
    await new Promise<void>((done) => server.listen(0, "127.0.0.1", done));
    const address = server.address();
    if (!address || typeof address === "string") throw new Error("Fixture server has no port.");

    const profile = await mkdtemp(resolve(tmpdir(), "margin-playwright-"));
    const dist = resolve("dist");
    try {
      const context = await chromium.launchPersistentContext(profile, {
        channel: "chromium",
        headless: false,
        args: ["--headless=new", `--disable-extensions-except=${dist}`, `--load-extension=${dist}`],
      });
      try {
        const errors: string[] = [];
        context.on("console", (message) => {
          if (message.type() === "error") errors.push(message.text());
        });
        context.on("weberror", (error) => errors.push(error.error().message));
        const worker = context.serviceWorkers()[0] ?? await context.waitForEvent("serviceworker");
        const workerUrl = new URL(worker.url());
        expect(workerUrl.protocol).toBe("chrome-extension:");
        expect(workerUrl.pathname).toBe("/background.js");

        const extension = `chrome-extension://${workerUrl.host}`;
        await worker.evaluate(() => chrome.storage.local.set({ mock: true }));
        await use({ context, worker, extension, site: `http://127.0.0.1:${address.port}`, errors });
      } finally {
        await context.close();
      }
    } finally {
      await rm(profile, { recursive: true, force: true });
      await new Promise<void>((done, reject) => server.close((error) => error ? reject(error) : done()));
    }
  },
});

async function extensionPage(margin: Margin, path: string): Promise<Page> {
  const page = await margin.context.newPage();
  await page.goto(`${margin.extension}/${path}`);
  return page;
}

async function sendCapture(margin: Margin, url: string, kind: "page" | "pdf" | "selection" | "image") {
  await margin.worker.evaluate(async ({ url, kind }) => {
    const [tab] = await chrome.tabs.query({ url });
    if (tab?.id === undefined) throw new Error("Could not find the fixture tab.");
    const key = `margin.capture.${tab.windowId}.${Date.now()}.${crypto.randomUUID()}`;
    await chrome.storage.session.set({ [key]: { kind, tabId: tab.id } });
    await chrome.runtime.sendMessage({ type: "margin.capture", windowId: tab.windowId }).catch(() => {});
  }, { url, kind });
}

