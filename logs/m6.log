  availability(options: LanguageModelCreateOptions): Promise<LocalAvailability>;
};

const englishText: LanguageModelExpected = { type: "text", languages: ["en"] };
const deviceOptions: LanguageModelCreateOptions = {
  expectedInputs: [{ ...englishText }, { type: "image" }],
  expectedOutputs: [{ ...englishText }],
};
const SDK_TOKEN_LIMIT = 9_216;

function browserModel(): PromptAPI | undefined {
  return (globalThis as typeof globalThis & { LanguageModel?: PromptAPI }).LanguageModel;
}

export class FirebaseProvider implements AIProvider {
  private readonly ai: AI;

  constructor(app: FirebaseApp, private readonly config: RoutingConfig) {
    this.ai = getAI(app, { backend: new GoogleAIBackend() });
  }

  async status(): Promise<{ nano: LocalAvailability }> {
    try {
      return { nano: await browserModel()?.availability(deviceOptions) ?? "unavailable" };
    } catch {
      return { nano: "unavailable" };
    }
  }

  // Call directly from the extension page's model enable button.
  async initializeDeviceModel(onProgress?: (progress: number) => void): Promise<void> {
    if (!browserModel()) throw new Error("Gemini Nano is unavailable in this browser.");
    const model = getGenerativeModel(this.ai, {
      mode: InferenceMode.ONLY_ON_DEVICE,
      inCloudParams: { model: this.config.cloudModel },
      onDeviceParams: { createOptions: deviceOptions },
    });
    await model.initializeDeviceModel(onProgress);
  }

  async generate({ task, mode, cloudModel, reason, repair }: InferenceRequest): Promise<InferenceResult> {
    const { prompt, schema } = createPrompt(task, this.config.maxCardsPerChunk, repair);
    const input = task.kind === "cards" ? task.input : undefined;
    const supported = !input || canRunOnDevice(input);
    const inputTokens = input ? estimateInputTokens(input)
      : estimateTokens(task.kind === "sensitivity" ? task.text : prompt);
    const extraMediaTokens = input ? inputTokens - estimateTokens(input.text ?? "") : 0;
    const fits = inputTokens <= this.config.maxOnDeviceTokens &&
      estimateTokens(prompt) + extraMediaTokens <= SDK_TOKEN_LIMIT;

    if (mode === InferenceMode.ONLY_ON_DEVICE) {
      if (!supported || !fits) throw new Error("This request exceeds Gemini Nano's supported formats or token budget.");
      // Without a document-side adapter the SDK can dispatch directly to cloud.
      if ((await this.status()).nano !== "available" || typeof window === "undefined") {
        throw new Error("Gemini Nano is unavailable. Enable the on-device model and try again.");
      }
    }

    const effectiveMode = supported && fits ? mode : InferenceMode.ONLY_IN_CLOUD;
    const model = getGenerativeModel(this.ai, {
      mode: effectiveMode,
      onDeviceParams: { createOptions: deviceOptions, promptOptions: { responseConstraint: schema } },
      inCloudParams: {
        model: effectiveMode === mode ? cloudModel : this.config.longDocModel,
        generationConfig: { responseMimeType: "application/json", responseSchema: firebaseSchema(schema) },
      },
    });
    const parts: Part[] = [{ type: "text", text: prompt }];
    if (input?.kind === "youtube") {
      parts.push({ type: "fileData", fileData: { mimeType: "video/mp4", fileUri: input.url } });
    } else if (input && input.kind !== "text") {
      parts.push({ type: "inlineData", inlineData: { mimeType: input.mimeType, data: input.data } });
    }
    const { response } = await model.generateContent({ contents: [{ role: "user", parts }] });
    const source = response.inferenceSource;
    if (source !== InferenceSource.ON_DEVICE && source !== InferenceSource.IN_CLOUD) {
      throw new Error("Firebase did not report where inference ran.");
    }
    if (effectiveMode === InferenceMode.ONLY_ON_DEVICE && source !== InferenceSource.ON_DEVICE) {
      throw new Error("Firebase reported an unexpected inference source for a local request.");
    }
    const actualReason = effectiveMode !== mode
      ? "The request exceeds the on-device format or token limits. Used cloud inference."
      : source === InferenceSource.IN_CLOUD && mode === InferenceMode.PREFER_ON_DEVICE
        ? `${reason} Firebase used cloud inference.` : reason;
    return { text: response.text(), source, reason: actualReason };
  }
}
import { InferenceMode, InferenceSource } from "firebase/ai";
import { dedupe } from "../cards/dedupe";
import { validate, type CardDraft } from "../cards/schema";
import { DEFAULTS } from "../firebase/remoteConfig";
import type { AIProvider, InferenceRequest, InferenceResult, LocalAvailability } from "./provider";
import { canRunOnDevice, estimateInputTokens, hasSensitiveText } from "./router";

interface MockOptions {
  nano?: LocalAvailability;
  online?: boolean;
  maxCardsPerChunk?: number;
  maxOnDeviceTokens?: number;
}

function generateCards(text: string, maxCards: number): CardDraft[] {
  const passages = text.split(/(?<=[.!?])\s+|\n+/u);
  const cards: CardDraft[] = [];
  for (const passage of passages) {
    const sentence = passage.trim().replace(/^[-*•]\s+/u, "");
    if (sentence.length < 12) continue;

    const definition = sentence.match(/^(.{2,80}?)\s+(?:is defined as|refers to|means|is|are)\s+(.+)$/iu) ??
      sentence.match(/^([^:]{2,80}):\s+(.+)$/u);
    const words = sentence.split(/\s+/u);
    if (!definition && words.length < 4 && !/[.!?]$/u.test(sentence)) continue;
    const firstPhrase = words.slice(0, 5).join(" ").replace(/[.!?]$/u, "");
    const card = validate({
      type: "basic",
      front: definition ? `What is the definition of ${definition[1]}?` : `What does the source say about “${firstPhrase}”?`,
      back: definition?.[2] ?? sentence,
    });
    if (card) cards.push(card);
  }
  return dedupe(cards).slice(0, maxCards);
}

function words(text: string): string[] {
  return text.toLowerCase().match(/[\p{L}\p{N}]+/gu) ?? [];
}

function grade(expected: string, answer: string) {
  const expectedWords = [...new Set(words(expected))];
  const answerWords = new Set(words(answer));
  const missing = expectedWords.filter((word) => !answerWords.has(word));
  if (!answerWords.size || missing.length === expectedWords.length) {
    return { verdict: "incorrect", missing, suggestedRating: 1 };
  }
  if (missing.length) return { verdict: "partial", missing, suggestedRating: 2 };
  return { verdict: "correct", missing, suggestedRating: 3 };
}

export class MockProvider implements AIProvider {
  private nano: LocalAvailability;
  private readonly online: boolean;
  private readonly maxCards: number;
  private readonly maxTokens: number;

  constructor(options: MockOptions = {}) {
    this.nano = options.nano ?? "available";
    this.online = options.online ?? true;
    this.maxCards = options.maxCardsPerChunk ?? DEFAULTS.maxCardsPerChunk;
    this.maxTokens = options.maxOnDeviceTokens ?? DEFAULTS.maxOnDeviceTokens;
  }

  async status(): Promise<{ nano: LocalAvailability }> {
    return { nano: this.nano };
  }

  async initializeDeviceModel(onProgress?: (progress: number) => void): Promise<void> {
    if (this.nano === "unavailable") throw new Error("Gemini Nano is unavailable in this browser.");
    if (this.nano !== "available" && !this.online) throw new Error("Connect to the internet to download Gemini Nano.");
    this.nano = "available";
    onProgress?.(1);
  }

  async generate({ task, mode, reason }: InferenceRequest): Promise<InferenceResult> {
    const compatible = task.kind !== "cards" ||
      (canRunOnDevice(task.input) && estimateInputTokens(task.input) <= this.maxTokens);
    const local = compatible && this.nano === "available";
    if (mode === InferenceMode.ONLY_ON_DEVICE && !local) {
      throw new Error("Gemini Nano is unavailable for this request.");
    }
    const cloud = mode === InferenceMode.ONLY_IN_CLOUD ||
      (mode === InferenceMode.PREFER_IN_CLOUD ? this.online || !local : !local);
    if (cloud && !this.online) throw new Error("Cloud inference is unavailable while offline.");

    let result: unknown;
    switch (task.kind) {
      case "cards":
        if (task.input.kind !== "text") {
          const examples = {
            pdf: "OCR means optical character recognition. A searchable PDF contains a layer of machine-readable text.",
            image: "A pixel is the smallest addressable element of a raster image. PNG uses lossless compression.",
            youtube: "Captions are timed text synchronized with a video's audio. A transcript is a text record of what was said.",
          };
          result = generateCards(examples[task.input.kind], this.maxCards);
          reason = `${reason} Demo example cards for this attachment.`;
        } else {
          result = generateCards(task.input.text, this.maxCards);
        }
        break;
      case "grade":
        result = grade(task.expected, task.answer);
        break;
      case "sensitivity":
        result = { sensitive: hasSensitiveText(task.text) || /\b(?:private correspondence|confidential memo|medical record)\b/iu.test(task.text) };
        break;
    }
    return {
      text: JSON.stringify(result),
      source: cloud ? InferenceSource.IN_CLOUD : InferenceSource.ON_DEVICE,
      reason: cloud && mode === InferenceMode.PREFER_ON_DEVICE ? `${reason} Simulated cloud inference.` : reason,
    };
  }
}
import { InferenceMode, InferenceSource } from "firebase/ai";
import type { AIProvider } from "./provider";

export interface AnswerGrade {
  verdict: "correct" | "partial" | "incorrect";
  missing: string[];
  suggestedRating: 1 | 2 | 3 | 4;
}

export function parseGrade(text: string): AnswerGrade {
  const value = JSON.parse(text.trim().replace(/^```(?:json)?\s*|\s*```$/giu, "")) as Partial<AnswerGrade> | null;
  if (!value || !Array.isArray(value.missing) || !value.missing.every((point) => typeof point === "string")) {
    throw new Error("Answer feedback was incomplete.");
  }
  const { verdict, missing } = value;
  if (verdict === "incorrect") return { verdict, missing, suggestedRating: 1 };
  if (verdict === "partial") return { verdict, missing, suggestedRating: 2 };
  if (verdict === "correct") return { verdict, missing, suggestedRating: value.suggestedRating === 4 ? 4 : 3 };
  throw new Error("Answer feedback was incomplete.");
}

export async function checkAnswer(
  provider: AIProvider, cloudModel: string, question: string, expected: string, answer: string,
): Promise<AnswerGrade> {
  if ((await provider.status()).nano !== "available") {
    throw new Error("Enable on-device AI in the side panel to check typed answers. You can still reveal the answer and rate yourself.");
  }
  const result = await provider.generate({
    task: { kind: "grade", question, expected, answer },
    mode: InferenceMode.ONLY_ON_DEVICE,
    reason: "Typed answers are graded on-device.",
    cloudModel,
  });
  if (result.source !== InferenceSource.ON_DEVICE) throw new Error("On-device answer feedback is unavailable.");
  return parseGrade(result.text);
}

