  | { kind: "sensitivity"; text: string };

export type LocalAvailability = "available" | "downloadable" | "downloading" | "unavailable";

export interface InferenceRequest {
  task: InferenceTask;
  mode: InferenceMode;
  reason: string;
  cloudModel: string;
  repair?: boolean;
