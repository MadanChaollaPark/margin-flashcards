import type { InferenceSource } from "firebase/ai";
import type { Schedule } from "../srs/fsrs";

export const MAX_CARDS = 50;
export const MAX_FRONT_LENGTH = 500;
export const MAX_BACK_LENGTH = 1_500;

export interface CardDraft {
  type: "basic" | "cloze";
  front: string;
  back: string;
}

export interface Route {
  source: InferenceSource;
  reason: string;
  tokensEst: number;
  ms: number;
  localBytes?: number;
  runId?: string;
}

export interface Card extends CardDraft {
  id: string;
  deckId: string;
  createdAt: number;
  route: Route;
  tags?: string[];
  schedule?: Schedule;
  source?: { url?: string; title?: string };
}

export interface Deck {
  id: string;
  name: string;
  createdAt: number;
}

export interface Review {
  id: string;
  cardId: string;
  reviewedAt: number;
  rating: 1 | 2 | 3 | 4;
}

export function validate(value: unknown): CardDraft | undefined {
  if (typeof value !== "object" || value === null) return;
  const { front, back, type = "basic" } = value as Partial<CardDraft>;
  if (type !== "basic" && type !== "cloze") return;
  if (typeof front !== "string" || typeof back !== "string") return;

  const question = front.trim();
  const answer = back.trim();
  if (!question || !answer || question.length > MAX_FRONT_LENGTH || answer.length > MAX_BACK_LENGTH) return;
  if (type === "cloze" && !question.match(/\{\{c1::([^{}]+)\}\}/u)?.[1].trim()) return;
  return { type, front: question, back: answer };
}
import type { Card } from "./schema";

export function cardStats(cards: Card[]) {
  const local = cards.filter((card) => card.route.source === "on_device");
  const runs = new Map<string, number>();
  for (const card of local) {
    if (card.route.localBytes) runs.set(card.route.runId ?? card.id, card.route.localBytes);
  }
  return {
    onDevicePercent: cards.length ? Math.round(local.length / cards.length * 100) : 0,
    localBytes: [...runs.values()].reduce((sum, bytes) => sum + bytes, 0),
  };
}

export function formatBytes(bytes: number): string {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 ** 2) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / 1024 ** 2).toFixed(1)} MB`;
}

