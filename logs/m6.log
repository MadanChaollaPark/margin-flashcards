import { enqueue, type QueuedJob } from "./queue";
import { chunkText, decide, estimateInputTokens, isSensitive, type RoutingContext } from "./router";

export async function createRuntime() {
  const settings = await readSettings();
  const mock = shouldUseMock(settings.mock);
  const app = mock ? undefined : initializeFirebase(settings);
  // Reuse the settings snapshot for one job so its privacy decisions stay consistent.
  const config = await loadRemoteConfig(app);
  const provider = app ? new FirebaseProvider(app, config) : new MockProvider(config);
  return { mock, provider, config, privacyMode: settings.privacyMode, modeOverride: settings.modeOverride };
}

export interface GenerationContext {
  config: RoutingConfig;
  privacyMode: boolean;
  online: boolean;
  modeOverride?: ModeOverride;
}

type GenerationOutcome =
  | { cards: Card[]; queued?: never }
  | { cards?: never; queued: QueuedJob };

export async function generateCards(
  job: GenerationJob,
  provider: AIProvider,
  { config, privacyMode, online, modeOverride }: GenerationContext,
  { queueIfOffline = true } = {},
): Promise<GenerationOutcome | undefined> {
  const ctx: RoutingContext = {
    ...config, privacyMode, online, modeOverride, nanoAvailable: (await provider.status()).nano === "available",
  };
  const initial = decide(job, ctx);
  const canGoToCloud = initial.mode !== InferenceMode.ONLY_ON_DEVICE;
  if (canGoToCloud && ctx.sensitivityCheck && ctx.nanoAvailable && !isSensitive(job, ctx)) {
    ctx.classifiedSensitive = await classify(job.input.text ?? "", provider, config);
  }

  const decision = decide(job, ctx);
  if (decision.mode === "queue") {
    return queueIfOffline ? { queued: await enqueue(job, decision.reason) } : undefined;
  }

  const inputs = decision.chunks?.map((text) => ({ kind: "text" as const, text })) ?? [job.input];
  const cards: Card[] = [];
  for (const input of inputs) {
    const started = performance.now();
    const request: InferenceRequest = {
      task: { kind: "cards", input },
      mode: decision.mode,
      reason: decision.reason,
      cloudModel: decision.cloudModel,
    };
    const { drafts, result } = await cardResponse(provider, request, config.maxCardsPerChunk);
    const route = {
      source: result.source, reason: result.reason, tokensEst: estimateInputTokens(input),
      ms: Math.round(performance.now() - started),
      runId: crypto.randomUUID(),
      localBytes: result.source === InferenceSource.ON_DEVICE
        ? new TextEncoder().encode(input.text ?? "").length + (input.kind === "image" ? Math.floor(input.data.replace(/=+$/u, "").length * 3 / 4) : 0)
        : 0,
    };
    for (const draft of drafts) {
      cards.push({ ...draft, id: crypto.randomUUID(), deckId: job.deckId, createdAt: Date.now(), source: job.source, route });
    }
  }
  return { cards: dedupe(cards) };
}

async function cardResponse(provider: AIProvider, request: InferenceRequest, limit: number) {
  for (const repair of [false, true]) {
    const result = await provider.generate({ ...request, repair });
    if (request.mode === InferenceMode.ONLY_ON_DEVICE && result.source !== InferenceSource.ON_DEVICE) {
      throw new Error("The provider returned a cloud result for an on-device request.");
    }
    const drafts = parseCardResponse(result.text, limit);
    if (drafts) return { drafts, result };
  }
  throw new Error("The model did not return valid flashcards.");
}

async function classify(text: string, provider: AIProvider, config: RoutingConfig): Promise<boolean> {
  for (const chunk of chunkText(text, config.maxOnDeviceTokens)) {
    if (!chunk.trim()) continue;
    const result = await provider.generate({
      task: { kind: "sensitivity", text: chunk },
      mode: InferenceMode.ONLY_ON_DEVICE,
      reason: "Check for sensitive content on-device before allowing cloud inference.",
      cloudModel: config.cloudModel,
    });
    if (result.source !== InferenceSource.ON_DEVICE) throw new Error("The sensitivity check must run on-device.");
    const classification: unknown = JSON.parse(result.text);
    if (typeof classification !== "object" || !classification || !("sensitive" in classification) ||
        typeof classification.sensitive !== "boolean") {
      throw new Error("The on-device model could not determine whether this content is sensitive.");
    }
    if (classification.sensitive) return true;
  }
  return false;
}
import type { Card } from "../cards/schema";
import { db, type Database } from "../storage/db";
import type { GenerationJob } from "./provider";

export interface QueuedJob {
  id: string;
  job: GenerationJob;
  reason: string;
  createdAt: number;
  attempts: number;
  lastError?: string;
}

export async function enqueue(job: GenerationJob, reason: string, database = db): Promise<QueuedJob> {
  const entry = { id: crypto.randomUUID(), job, reason, createdAt: Date.now(), attempts: 0 };
  await database.put("queue", entry);
  return entry;
}

type ProcessJob = (job: GenerationJob) => Promise<Card[] | undefined>;

export async function drainQueue(
  process: ProcessJob,
  online: () => boolean,
  database: Database = db,
  onlyId?: string,
): Promise<void> {
  const drain = async () => {
    if (!online()) return;
    const entries = (await database.all("queue")).filter((entry) => !onlyId || entry.id === onlyId);
    entries.sort((first, second) => first.createdAt - second.createdAt);
    for (const entry of entries) {
      if (!online()) break;
      try {
        const cards = await process(entry.job);
        if (cards === undefined) continue;
        await database.completeQueuedJob(entry.id, cards);
      } catch (error) {
        await database.updateQueuedJob({
          ...entry,
          attempts: entry.attempts + 1,
          lastError: error instanceof Error ? error.message : "Generation failed.",
        });
      }
    }
  };

  // Extension pages share this lock and cannot drain the same job concurrently.
  if (globalThis.navigator?.locks) await navigator.locks.request("margin-offline-queue", drain);
  else await drain();
}

export function startQueueDrain(process: ProcessJob, onError = console.error, onComplete?: () => void): () => void {
  const drain = () => { void drainQueue(process, () => navigator.onLine).then(onComplete).catch(onError); };
  window.addEventListener("online", drain);
  drain();
  return () => window.removeEventListener("online", drain);
}

