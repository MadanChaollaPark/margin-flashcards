import type { GenerationJob } from "../ai/provider";
import { captureImage, readImage } from "./image";
import { extractPage } from "./page";
import { pdfInput } from "./pdf";
import type { CaptureRequest } from "./request";
import { readSelection, textFragmentUrl } from "./selection";
import { fetchTranscript, readCaptionTracks, youtubeVideoUrl } from "./youtube";

export async function captureSource(
  request: CaptureRequest, deckId: string, notes: string, image?: File,
): Promise<GenerationJob> {
  const { kind, tabId, frameId, selectionText } = request;
  if (kind === "paste") {
    if (!notes.trim()) throw new Error("Paste some notes to generate flashcards.");
    return { deckId, input: { kind: "text", text: notes.trim() }, source: { title: "Pasted notes" } };
  }
  if (kind === "image" && image) {
    return { deckId, input: await readImage(image), source: { title: image.name || "Pasted image" } };
  }

  const tab = tabId === undefined
    ? (await chrome.tabs.query({ active: true, currentWindow: true }))[0]
    : await chrome.tabs.get(tabId);
  if (tab?.id === undefined || !tab.url) throw new Error("Open a source tab first, then try again.");
  const source = { url: tab.url, title: tab.title };
  const target = { tabId: tab.id, ...(frameId !== undefined && { frameIds: [frameId] }) };

  switch (kind) {
    case "selection": {
      const [result] = await chrome.scripting.executeScript({ target, func: readSelection }).catch((error: unknown) => {
        if (!selectionText) throw error;
        return [];
      });
      const text = selectionText || result?.result?.text;
      if (!text) throw new Error("Highlight text in the source tab, then generate again.");
      return {
        deckId, input: { kind: "text", text },
        source: { url: textFragmentUrl(result?.result?.url ?? request.frameUrl ?? tab.url, text), title: result?.result?.title || tab.title },
      };
    }
    case "page": {
      const [result] = await chrome.scripting.executeScript({ target, func: extractPage });
      if (!result?.result) throw new Error("This page has no readable text. Try selecting a passage or pasting notes.");
      const paragraph = result.result.split("\n").find((line) => line.length >= 32);
      if (paragraph) source.url = textFragmentUrl(request.frameUrl ?? tab.url, paragraph);
      return { deckId, source, input: { kind: "text", text: result.result } };
    }
    case "pdf":
      return { deckId, source, input: await pdfInput(tab.url) };
    case "youtube": {
      const url = youtubeVideoUrl(tab.url);
      if (!url) throw new Error("Open a YouTube video before generating from captions.");
      const [result] = await chrome.scripting.executeScript({ target, world: "MAIN", func: readCaptionTracks });
      const text = await fetchTranscript(result?.result ?? []);
      return { deckId, source, input: text ? { kind: "text", text } : { kind: "youtube", url } };
    }
    case "image": {
      if (request.imageUrl && /^https?:/u.test(request.imageUrl)) {
        try {
          const response = await fetch(request.imageUrl, { credentials: "include" });
          if (response.ok) return { deckId, source, input: await readImage(await response.blob()) };
        } catch {
          // Capture the visible tab when the image resource is inaccessible.
        }
      }
      return { deckId, source, input: await captureImage(tab) };
    }
  }
}
import type { ContentInput } from "../ai/provider";
import { encodeBase64 } from "./image";

export async function extractPdfText(bytes: Uint8Array, assetUrl?: (path: string) => string): Promise<string> {
  const { getDocument, GlobalWorkerOptions } = await import("pdfjs-dist/legacy/build/pdf.mjs");
  if (assetUrl) GlobalWorkerOptions.workerSrc = assetUrl("pdf.worker.min.mjs");
  const task = getDocument({
    data: bytes.slice(),
    useSystemFonts: !assetUrl,
    ...(assetUrl && {
      cMapUrl: assetUrl("cmaps/"),
      cMapPacked: true,
      standardFontDataUrl: assetUrl("standard_fonts/"),
    }),
  });
  try {
    const pdf = await task.promise;
    const pages: string[] = [];
    for (let index = 1; index <= pdf.numPages; index++) {
      const page = await pdf.getPage(index);
      const { items } = await page.getTextContent();
      pages.push(items.map((item) => "str" in item ? item.str + (item.hasEOL ? "\n" : " ") : "").join("").trim());
      page.cleanup();
    }
    return pages.filter(Boolean).join("\n\n");
  } finally {
    await task.destroy();
  }
}

export async function pdfInput(url: string): Promise<ContentInput> {
  const response = await fetch(url, { credentials: "include" });
  if (!response.ok) throw new Error(`Could not download the PDF (HTTP ${response.status}).`);
  const bytes = new Uint8Array(await response.arrayBuffer());
  if (!new TextDecoder().decode(bytes.subarray(0, 1024)).includes("%PDF-")) {
    throw new Error("This tab did not return a PDF. Open the PDF directly, then try again.");
  }
  const text = await extractPdfText(bytes, (path) => chrome.runtime.getURL(path)).catch(() => "");
  if ((text.match(/[\p{L}\p{N}]/gu)?.length ?? 0) >= 40) return { kind: "text", text };
  return { kind: "pdf", mimeType: "application/pdf", data: encodeBase64(bytes), text };
}
export type SourceKind = "selection" | "page" | "pdf" | "youtube" | "image" | "paste";

export interface CaptureRequest {
  kind: SourceKind;
  tabId?: number;
  frameId?: number;
  selectionText?: string;
  frameUrl?: string;
  imageUrl?: string;
}

export const PENDING_CAPTURE_PREFIX = "margin.capture.";
import { PENDING_CAPTURE_PREFIX, type CaptureRequest } from "./sources/request";

const menus = [
  { id: "margin-selection", title: "Make flashcards from selection", contexts: ["selection"] },
  { id: "margin-page", title: "Make flashcards from this page", contexts: ["page"] },
  { id: "margin-image", title: "Make flashcards from image", contexts: ["image"] },
] satisfies chrome.contextMenus.CreateProperties[];

chrome.runtime.onInstalled.addListener(() => {
  chrome.contextMenus.removeAll(() => {
    for (const menu of menus) chrome.contextMenus.create(menu);
  });
});

chrome.contextMenus.onClicked.addListener((info, tab) => {
  if (tab?.id === undefined || !menus.some(({ id }) => id === info.menuItemId)) return;
  const kind = String(info.menuItemId).slice("margin-".length) as CaptureRequest["kind"];
  const request: CaptureRequest = {
    kind, tabId: tab.id, frameId: info.frameId, frameUrl: info.frameUrl,
    selectionText: info.selectionText, imageUrl: info.srcUrl,
  };
  const key = `${PENDING_CAPTURE_PREFIX}${tab.windowId}.${Date.now()}.${crypto.randomUUID()}`;
  const open = chrome.sidePanel.open({ windowId: tab.windowId });
  const store = chrome.storage.session.set({ [key]: request });
  void Promise.all([open, store])
    .then(() => chrome.runtime.sendMessage({ type: "margin.capture", windowId: tab.windowId }).catch(() => {}))
    .catch((error: unknown) => console.error("Margin could not open the side panel.", error));
});

