  }

  // Call directly from the extension page's model enable button.
  async initializeDeviceModel(onProgress?: (progress: number) => void): Promise<void> {
    if (!browserModel()) throw new Error("Gemini Nano is unavailable in this browser.");
    const model = getGenerativeModel(this.ai, {
      mode: InferenceMode.ONLY_ON_DEVICE,
      inCloudParams: { model: this.config.cloudModel },
      onDeviceParams: { createOptions: textOptions },
    });
    await model.initializeDeviceModel(onProgress);
  }

  async generate({ task, mode, cloudModel, reason, repair }: InferenceRequest): Promise<InferenceResult> {
    const { prompt, schema } = createPrompt(task, this.config.maxCardsPerChunk, repair);
    const input = task.kind === "cards" ? task.input : undefined;
    const supported = !input || canRunOnDevice(input);
    const inputTokens = input ? estimateInputTokens(input)
      : estimateTokens(task.kind === "sensitivity" ? task.text : prompt);
    const extraMediaTokens = input ? inputTokens - estimateTokens(input.text ?? "") : 0;
    const fits = inputTokens <= Math.min(this.config.maxOnDeviceTokens, MAX_INPUT_BUDGET) &&
      estimateTokens(prompt) + estimateTokens(JSON.stringify(schema)) + extraMediaTokens <= NANO_CONTEXT_TOKENS - NANO_OUTPUT_RESERVE;

    if (mode === InferenceMode.ONLY_ON_DEVICE) {
      if (!supported || !fits) throw new Error("This request exceeds Gemini Nano's supported formats or token budget.");
      // Without a document-side adapter the SDK can dispatch directly to cloud.
      const { nano } = await this.status(input);
      if (nano !== "available" || typeof window === "undefined") {
        throw new Error(nanoHint(nano));
      }
    }

    const effectiveMode = mode === InferenceMode.PREFER_ON_DEVICE && (!supported || !fits)
      ? InferenceMode.ONLY_IN_CLOUD : mode;
    const model = getGenerativeModel(this.ai, {
      mode: effectiveMode,
      onDeviceParams: {
        createOptions: input?.kind === "image" ? imageOptions : textOptions,
        promptOptions: { responseConstraint: schema },
      },
      inCloudParams: {
        model: effectiveMode === mode ? cloudModel : this.config.longDocModel,
        generationConfig: { responseMimeType: "application/json", responseSchema: firebaseSchema(schema) },
      },
    });
    const parts: Part[] = [{ type: "text", text: prompt }];
    if (input?.kind === "youtube") {
      parts.push({ type: "fileData", fileData: { mimeType: "video/mp4", fileUri: input.url } });
    } else if (input && input.kind !== "text") {
      parts.push({ type: "inlineData", inlineData: { mimeType: input.mimeType, data: input.data } });
    }
    const { response } = await model.generateContent({ contents: [{ role: "user", parts }] });
    const source = response.inferenceSource ??
      (effectiveMode === InferenceMode.ONLY_IN_CLOUD ? InferenceSource.IN_CLOUD : undefined);
    if (source !== InferenceSource.ON_DEVICE && source !== InferenceSource.IN_CLOUD) {
      throw new Error("Firebase did not report where inference ran.");
    }
    if (effectiveMode === InferenceMode.ONLY_ON_DEVICE && source !== InferenceSource.ON_DEVICE) {
      throw new Error("Firebase reported an unexpected inference source for a local request.");
    }
    const actualReason = effectiveMode !== mode
      ? "The request exceeds the on-device format or token limits. Used cloud inference."
      : routeReason(mode, source, reason);
    return { text: response.text(), source, reason: actualReason };
  }
}
import { InferenceMode, InferenceSource } from "firebase/ai";
import { dedupe } from "../cards/dedupe";
import { parseCardResponse } from "../cards/parse";
import type { Card } from "../cards/schema";
import { shouldUseMock } from "../firebase/config";
import { initializeFirebase } from "../firebase/init";
import { loadRemoteConfig, MAX_INPUT_BUDGET, type RoutingConfig } from "../firebase/remoteConfig";
import { normalizeAnchorText, pageFragmentUrl } from "../sources/selection";
import { readSettings, type ModeOverride } from "../storage/settings";
import { FirebaseProvider } from "./firebaseProvider";
import { MAX_DEMO_CARDS, MockProvider } from "./mockProvider";
import type { AIProvider, GenerationJob, InferenceRequest } from "./provider";
import { enqueue, type QueuedJob } from "./queue";
import { chunkText, decide, estimateInputTokens, isSensitive, type RoutingContext } from "./router";

export async function createRuntime() {
  const settings = await readSettings();
  const mock = shouldUseMock(settings.mock);
  const app = mock ? undefined : initializeFirebase(settings);
  // Reuse the settings snapshot for one job so its privacy decisions stay consistent.
  const config = await loadRemoteConfig(app);
  const provider = app ? new FirebaseProvider(app, config) : new MockProvider(config);
  return { mock, provider, config, privacyMode: settings.privacyMode, modeOverride: settings.modeOverride };
}

export interface GenerationContext {
  config: RoutingConfig;
  privacyMode: boolean;
  online: boolean;
  modeOverride?: ModeOverride;
}

type GenerationOutcome =
  | { cards: Card[]; queued?: never; confirm?: never }
  | { cards?: never; queued: QueuedJob; confirm?: never }
  | { cards?: never; queued?: never; confirm: string };

export async function generateCards(
  job: GenerationJob,
  provider: AIProvider,
  { config, privacyMode, online, modeOverride }: GenerationContext,
  { queueIfOffline = true, confirmCloud }: {
    queueIfOffline?: boolean;
    confirmCloud?: (reason: string) => Promise<boolean>;
  } = {},
): Promise<GenerationOutcome | undefined> {
  const ctx: RoutingContext = {
    ...config, privacyMode, online, modeOverride, nano: (await provider.status(job.input)).nano,
  };
  let decision = decide(job, ctx);
  if (decision.mode === "confirm") {
    if (!confirmCloud) return { confirm: decision.reason };
    if (!await confirmCloud(decision.reason)) return;
    ctx.confirmedCloud = true;
    decision = decide(job, ctx);
  }
  if (decision.mode !== "queue" && decision.mode !== "confirm" && decision.mode !== InferenceMode.ONLY_ON_DEVICE &&
      ctx.sensitivityCheck && !!job.input.text?.trim() && !ctx.confirmedCloud &&
      !isSensitive(job, ctx) && (await provider.status()).nano === "available") {
    ctx.classifiedSensitive = await classify(job.input.text ?? "", provider, config);
    decision = decide(job, ctx);
  }
  if (decision.mode === "confirm") return { confirm: decision.reason };
  if (decision.mode === "queue") {
    const reason = provider instanceof MockProvider ? `Simulated — ${decision.reason}` : decision.reason;
    return queueIfOffline ? { queued: await enqueue(job, reason) } : undefined;
  }

  const inputs = decision.chunks?.map((text) => ({ kind: "text" as const, text })) ?? [job.input];
  const pageUrl = job.anchorPage ? job.source?.url : undefined;
  const pageText = pageUrl ? normalizeAnchorText(job.input.text ?? "").toLowerCase() : "";
  const sentences = pageUrl && inputs.length > 1 ? new Intl.Segmenter(undefined, { granularity: "sentence" }) : undefined;
  const cards: Card[] = [];
  for (const input of inputs) {
    const started = performance.now();
    const request: InferenceRequest = {
      task: { kind: "cards", input, ...(pageUrl && { quoteSource: true }) },
      mode: decision.mode,
      reason: decision.reason,
      cloudModel: decision.cloudModel,
    };
    const { drafts, result } = await cardResponse(provider, request, config.maxCardsPerChunk);
    const route = {
      source: result.source, reason: result.reason, tokensEst: estimateInputTokens(input),
      ms: Math.round(performance.now() - started),
      runId: crypto.randomUUID(),
      simulated: result.simulated ?? false,
      localBytes: result.source === InferenceSource.ON_DEVICE
        ? new TextEncoder().encode(input.text ?? "").length + (input.kind === "image" ? Math.floor(input.data.replace(/=+$/u, "").length * 3 / 4) : 0)
        : 0,
    };
    const chunk = pageUrl ? normalizeAnchorText(input.text ?? "") : "";
    const firstSentence = sentences?.segment(input.text ?? "")[Symbol.iterator]().next().value?.segment;
    const chunkUrl = pageUrl && firstSentence ? pageFragmentUrl(pageUrl, pageText, chunk, firstSentence) : undefined;
    for (const { sourceQuote, ...draft } of drafts) {
      const url = pageUrl && sourceQuote ? pageFragmentUrl(pageUrl, pageText, chunk, sourceQuote) : undefined;
      const source = pageUrl ? { ...job.source, url: url ?? chunkUrl ?? pageUrl } : job.source;
      cards.push({ ...draft, id: crypto.randomUUID(), deckId: job.deckId, createdAt: Date.now(), source, route });
    }
  }
  const unique = dedupe(cards);
  return { cards: provider instanceof MockProvider ? unique.slice(0, MAX_DEMO_CARDS) : unique };
}

async function cardResponse(provider: AIProvider, request: InferenceRequest, limit: number) {
  for (const repair of [false, true]) {
    const result = await provider.generate({ ...request, repair });
    if (request.mode === InferenceMode.ONLY_ON_DEVICE && result.source !== InferenceSource.ON_DEVICE) {
      throw new Error("The provider returned a cloud result for an on-device request.");
    }
    const drafts = parseCardResponse(result.text, limit, request.task.kind === "cards" && request.task.quoteSource);
    if (drafts) return { drafts, result };
  }
  throw new Error("The model did not return valid flashcards.");
}

async function classify(text: string, provider: AIProvider, config: RoutingConfig): Promise<boolean> {
  for (const chunk of chunkText(text, Math.min(config.maxOnDeviceTokens, MAX_INPUT_BUDGET))) {
    if (!chunk.trim()) continue;
    try {
      const result = await provider.generate({
        task: { kind: "sensitivity", text: chunk },
        mode: InferenceMode.ONLY_ON_DEVICE,
        reason: "Check for sensitive content on-device before allowing cloud inference.",
        cloudModel: config.cloudModel,
      });
      if (result.source !== InferenceSource.ON_DEVICE) return true;
      const json = result.text.match(/\{[\s\S]*\}/u)?.[0];
      if (!json || !/^\{\s*"sensitive"\s*:\s*false\s*,?\s*\}$/u.test(json)) return true;
    } catch {
      return true;
    }
  }
  return false;
}
export const inferenceModes = [
  ["auto", "Auto router"], ["prefer-device", "Prefer on-device"], ["prefer-cloud", "Prefer cloud"],
  ["only-device", "Only on-device"], ["only-cloud", "Only cloud"],
] as const;

export type ModeOverride = typeof inferenceModes[number][0];

export interface Settings {
  mock: boolean;
  privacyMode: boolean;
  modeOverride: ModeOverride;
  appCheckDebugToken?: string;
}

export async function readSettings(): Promise<Settings> {
  const { mock, privacyMode, modeOverride, appCheckDebugToken } = await chrome.storage.local.get<Partial<Settings>>([
    "mock", "privacyMode", "modeOverride", "appCheckDebugToken",
  ]);
  return {
    mock: mock === true,
    privacyMode: privacyMode === true,
    modeOverride: modeOverride && inferenceModes.some(([mode]) => mode === modeOverride) ? modeOverride : "auto",
    appCheckDebugToken: typeof appCheckDebugToken === "string" ? appCheckDebugToken.trim() : undefined,
  };
}
import type { Deck } from "../cards/schema";
import { db } from "./db";

const byName = (a: Deck, b: Deck) => a.name.localeCompare(b.name);

export async function listDecks(): Promise<Deck[]> {
  const initialize = async () => {
    const decks = await db.all("decks");
    if (decks.length) return decks.sort(byName);
    const deck = { id: "default", name: "Inbox", createdAt: Date.now() };
    await db.put("decks", deck);
    return [deck];
  };
  return navigator.locks.request("margin-decks", initialize);
}

export async function setDeckName(name: string, existing?: Deck): Promise<Deck> {
  const clean = name.replace(/\s+/gu, " ").trim();
  if (!clean || clean.length > 80) throw new Error("Enter a deck name of 1–80 characters.");
  return navigator.locks.request("margin-decks", async () => {
    const decks = await db.all("decks");
    if (existing && !decks.some(({ id }) => id === existing.id)) throw new Error("This deck was deleted.");
    if (decks.some((deck) => deck.id !== existing?.id && deck.name.toLowerCase() === clean.toLowerCase())) {
      throw new Error("A deck with that name already exists.");
    }
    const deck = { id: existing?.id ?? crypto.randomUUID(), name: clean, createdAt: existing?.createdAt ?? Date.now() };
    await db.put("decks", deck);
    return deck;
  });
}
import type { QueuedJob } from "../ai/queue";
import type { Card, CardDraft, Deck, Review } from "../cards/schema";
import { dedupe } from "../cards/dedupe";
import type { Schedule } from "../srs/fsrs";

interface Records {
  cards: Card;
  decks: Deck;
  reviews: Review;
  queue: QueuedJob;
}

type Store = keyof Records;
const STORES = ["cards", "decks", "reviews", "queue"] as const;

export interface Database {
  get<S extends Store>(store: S, id: string): Promise<Records[S] | undefined>;
  all<S extends Store>(store: S): Promise<Records[S][]>;
  put<S extends Store>(store: S, value: Records[S]): Promise<void>;
  delete(store: Store, id: string): Promise<void>;
  saveCards(deckId: string, cards: Card[]): Promise<number>;
  updateCard(id: string, deckId: string, draft: CardDraft): Promise<Card>;
  deleteCard(id: string): Promise<void>;
  recordReview(card: Card, schedule: Schedule, review: Review): Promise<boolean>;
  deleteDeck(id: string): Promise<void>;
  completeQueuedJob(id: string, cards: Card[]): Promise<void>;
  updateQueuedJob(entry: QueuedJob): Promise<void>;
}

function sameSchedule(current: Card | undefined, expected: Card): current is Card {
  return !!current && current.schedule?.reps === expected.schedule?.reps &&
    current.schedule?.last_review?.getTime() === expected.schedule?.last_review?.getTime();
}

function editedCard(current: Card | undefined, deck: Deck | undefined, draft: CardDraft): Card {
  if (!current) throw new Error("This card was deleted.");
  if (!deck) throw new Error("Choose an existing deck to save this card.");
  return { ...current, ...draft, tags: draft.tags, deckId: deck.id };
}

export function createMemoryDatabase(): Database {
  const stores: { [S in Store]: Map<string, Records[S]> } = {
    cards: new Map(), decks: new Map(), reviews: new Map(), queue: new Map(),
  };
  return {
    async get(store, id) { return structuredClone(stores[store].get(id)); },
    async all(store) { return Array.from(stores[store].values(), (value) => structuredClone(value)); },
    async put(store, value) { stores[store].set(value.id, structuredClone(value)); },
    async delete(store, id) { stores[store].delete(id); },
    async saveCards(deckId, cards) {
      if (!stores.decks.has(deckId)) throw new Error("Choose an existing deck to save these cards.");
      const fresh = dedupe(cards, [...stores.cards.values()].filter((card) => card.deckId === deckId));
      for (const card of fresh) stores.cards.set(card.id, structuredClone({ ...card, deckId }));
      return fresh.length;
    },
    async updateCard(id, deckId, draft) {
      const card = editedCard(stores.cards.get(id), stores.decks.get(deckId), draft);
      stores.cards.set(id, structuredClone(card));
      return structuredClone(card);
    },
    async deleteCard(id) {
      stores.cards.delete(id);
      for (const review of stores.reviews.values()) if (review.cardId === id) stores.reviews.delete(review.id);
    },
    async recordReview(card, schedule, review) {
      const current = stores.cards.get(card.id);
      if (!sameSchedule(current, card)) return false;
      stores.cards.set(card.id, structuredClone({ ...current, schedule }));
      stores.reviews.set(review.id, structuredClone(review));
      return true;
    },
    async deleteDeck(id) {
      const cards = [...stores.cards.values()].filter((card) => card.deckId === id);
      const ids = new Set(cards.map((card) => card.id));
      stores.decks.delete(id);
      for (const card of cards) stores.cards.delete(card.id);
      for (const review of stores.reviews.values()) if (ids.has(review.cardId)) stores.reviews.delete(review.id);
      for (const entry of stores.queue.values()) if (entry.job.deckId === id) stores.queue.delete(entry.id);
    },
    async completeQueuedJob(id, cards) {
      const entry = stores.queue.get(id);
      if (!entry) return;
      const copies = structuredClone(dedupe(cards, [...stores.cards.values()].filter((card) => card.deckId === entry.job.deckId)));
      for (const card of copies) stores.cards.set(card.id, card);
      stores.queue.delete(id);
    },
    async updateQueuedJob(entry) {
      if (stores.queue.has(entry.id)) stores.queue.set(entry.id, structuredClone(entry));
    },
  };
}

function request<T>(operation: IDBRequest<T>): Promise<T> {
  return new Promise((resolve, reject) => {
    operation.onsuccess = () => resolve(operation.result);
    operation.onerror = () => reject(operation.error);
  });
}

function completion(transaction: IDBTransaction): Promise<void> {
  return new Promise((resolve, reject) => {
    transaction.oncomplete = () => resolve();
    transaction.onabort = () => reject(transaction.error ?? new Error("Database transaction aborted."));
  });
}

function createIndexedDatabase(): Database {
  let opening: Promise<IDBDatabase> | undefined;

  function connect(): Promise<IDBDatabase> {
    if (!opening) {
      const operation = indexedDB.open("margin", 1);
      operation.onupgradeneeded = () => {
        for (const store of STORES) {
          if (!operation.result.objectStoreNames.contains(store)) {
            operation.result.createObjectStore(store, { keyPath: "id" });
          }
        }
      };
      opening = request(operation).then((connection) => {
        connection.onversionchange = () => {
          connection.close();
          opening = undefined;
        };
        return connection;
      }).catch((error: unknown) => {
        opening = undefined;
        throw error;
      });
    }
    return opening;
  }

  async function write<T>(
    stores: Store[],
    apply: (transaction: IDBTransaction) => T | Promise<T>,
  ): Promise<T> {
    const transaction = (await connect()).transaction(stores, "readwrite");
    const done = completion(transaction);
    let result: T;
    try {
      result = await apply(transaction);
    } catch (error) {
      try { transaction.abort(); } catch { /* The transaction may have already aborted. */ }
      await done.catch(() => {});
      throw error;
    }
    await done;
    return result;
  }

  return {
    async get(store, id) {
      const transaction = (await connect()).transaction(store, "readonly");
      return request(transaction.objectStore(store).get(id));
    },
    async all(store) {
      const transaction = (await connect()).transaction(store, "readonly");
      return request(transaction.objectStore(store).getAll());
    },
    async put(store, value) {
      await write([store], (transaction) => { transaction.objectStore(store).put(value); });
    },
    async delete(store, id) {
      await write([store], (transaction) => { transaction.objectStore(store).delete(id); });
    },
    saveCards(deckId, candidates) {
      return write(["decks", "cards"], async (transaction) => {
        const cards = transaction.objectStore("cards");
        const [deck, existing] = await Promise.all([
          request<Deck | undefined>(transaction.objectStore("decks").get(deckId)),
          request<Card[]>(cards.getAll()),
        ]);
        if (!deck) throw new Error("Choose an existing deck to save these cards.");
        const fresh = dedupe(candidates, existing.filter((card) => card.deckId === deckId));
        for (const card of fresh) cards.put({ ...card, deckId });
        return fresh.length;
      });
    },
    updateCard(id, deckId, draft) {
      return write(["cards", "decks"], async (transaction) => {
        const cards = transaction.objectStore("cards");
        const [current, deck] = await Promise.all([
          request<Card | undefined>(cards.get(id)),
          request<Deck | undefined>(transaction.objectStore("decks").get(deckId)),
        ]);
        const card = editedCard(current, deck, draft);
        cards.put(card);
        return card;
      });
    },
    deleteCard(id) {
      return write(["cards", "reviews"], async (transaction) => {
        const reviews = transaction.objectStore("reviews");
        for (const review of await request<Review[]>(reviews.getAll())) {
          if (review.cardId === id) reviews.delete(review.id);
        }
        transaction.objectStore("cards").delete(id);
      });
    },
    recordReview(card, schedule, review) {
      return write(["cards", "reviews"], async (transaction) => {
        const cards = transaction.objectStore("cards");
        const current = await request<Card | undefined>(cards.get(card.id));
        if (!sameSchedule(current, card)) return false;
        cards.put({ ...current, schedule });
        transaction.objectStore("reviews").put(review);
        return true;
      });
    },
    async deleteDeck(id) {
      await write(["decks", "cards", "reviews", "queue"], async (transaction) => {
        const cards = transaction.objectStore("cards");
        const reviews = transaction.objectStore("reviews");
        const queue = transaction.objectStore("queue");
        const [allCards, allReviews, entries] = await Promise.all([
          request<Card[]>(cards.getAll()), request<Review[]>(reviews.getAll()), request<QueuedJob[]>(queue.getAll()),
        ]);
        const ids = new Set(allCards.filter((card) => card.deckId === id).map((card) => card.id));
        for (const cardId of ids) cards.delete(cardId);
        for (const review of allReviews) if (ids.has(review.cardId)) reviews.delete(review.id);
        for (const entry of entries) if (entry.job.deckId === id) queue.delete(entry.id);
        transaction.objectStore("decks").delete(id);
      });
    },
    async completeQueuedJob(id, cards) {
      await write(["cards", "queue"], async (transaction) => {
        const queue = transaction.objectStore("queue");
        const store = transaction.objectStore("cards");
        const [entry, existing] = await Promise.all([
          request<QueuedJob | undefined>(queue.get(id)), request<Card[]>(store.getAll()),
        ]);
        if (!entry) return;
        const fresh = dedupe(cards, existing.filter((card) => card.deckId === entry.job.deckId));
        for (const card of fresh) store.put(card);
        queue.delete(id);
      });
    },
    async updateQueuedJob(entry) {
      await write(["queue"], async (transaction) => {
        const queue = transaction.objectStore("queue");
        if (await request(queue.getKey(entry.id))) queue.put(entry);
      });
    },
  };
}

export const db = typeof indexedDB === "undefined" ? createMemoryDatabase() : createIndexedDatabase();
import type { InferenceSource } from "firebase/ai";
import type { Schedule } from "../srs/fsrs";

export const MAX_CARDS = 50;
export const MAX_FRONT_LENGTH = 500;
export const MAX_BACK_LENGTH = 1_500;

export interface CardDraft {
  type: "basic" | "cloze";
  front: string;
  back: string;
  tags?: string[];
}

export interface Route {
  source: InferenceSource;
  reason: string;
  tokensEst: number;
  ms: number;
  localBytes?: number;
  simulated?: boolean;
  runId?: string;
}

export interface Card extends CardDraft {
  id: string;
  deckId: string;
  createdAt: number;
  route: Route;
  schedule?: Schedule;
  source?: { url?: string; title?: string };
}

export interface Deck {
  id: string;
  name: string;
  createdAt: number;
}

export interface Review {
  id: string;
  cardId: string;
  reviewedAt: number;
  rating: 1 | 2 | 3 | 4;
}

export function cardTags(tags: string[] = []): string[] {
  return [...new Set(tags.flatMap((tag) => tag.split(/\s+/u)).filter(Boolean))];
}

export function validate(value: unknown): CardDraft | undefined {
  if (typeof value !== "object" || value === null) return;
  const { front, back, tags, type = "basic" } = value as Partial<CardDraft>;
  if (type !== "basic" && type !== "cloze") return;
  if (typeof front !== "string" || typeof back !== "string") return;

  const question = front.trim();
  const answer = back.trim();
  if (!question || !answer || question.length > MAX_FRONT_LENGTH || answer.length > MAX_BACK_LENGTH) return;
  if (type === "cloze" && !question.match(/\{\{c1::([^{}]+)\}\}/u)?.[1].trim()) return;
  const cleanTags = Array.isArray(tags)
    ? cardTags(tags.filter((tag) => typeof tag === "string")).filter((tag) => tag.length <= 80).slice(0, 16)
    : [];
  return { type, front: question, back: answer, ...(cleanTags.length && { tags: cleanTags }) };
}

