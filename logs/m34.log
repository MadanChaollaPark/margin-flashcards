import assert from \"node:assert/strict\";
import { test } from \"node:test\";
import { Rating, State } from \"ts-fsrs\";
import { checkAnswer, parseGrade } from \"../../src/ai/grade\";
import { MockProvider } from \"../../src/ai/mockProvider\";
import { renderFront } from \"../../src/cards/cloze\";
import type { Card, Review } from \"../../src/cards/schema\";
import { dueCards, nextIntervals, nextSchedule } from \"../../src/srs/fsrs\";
import { createMemoryDatabase } from \"../../src/storage/db\";

const start = new Date(\"2026-11-20T09:00:00Z\");
const card: Card = {
  id: \"one\", deckId: \"bio\", type: \"basic\", front: \"What does chlorophyll absorb?\", back: \"Light\",
  createdAt: start.getTime(), route: { source: \"on_device\", reason: \"Local.\", ms: 0, tokensEst: 5 },
};

test(\"FSRS Good reviews increase intervals and Again sends a review card to relearning\", () => {
  const first = nextSchedule(card, Rating.Good, start);
  const second = nextSchedule({ ...card, schedule: first }, Rating.Good, first.due);
  const third = nextSchedule({ ...card, schedule: second }, Rating.Good, second.due);
  assert.ok(second.scheduled_days > first.scheduled_days);
  assert.ok(third.scheduled_days > second.scheduled_days);
  const lapse = nextSchedule({ ...card, schedule: third }, Rating.Again, third.due);
  assert.equal(lapse.state, State.Relearning);
  assert.equal(lapse.lapses, 1);
  assert.ok(lapse.due.getTime() - third.due.getTime() < 3_600_000);
  assert.equal(nextIntervals(card, start).length, 4);
  assert.equal(nextIntervals(card, start)[2].milliseconds, first.due.getTime() - start.getTime());
});

test(\"the grade verdict maps to a consistent rating and typed answers stay on-device\", async () => {
  assert.equal(parseGrade('{\"verdict\":\"partial\",\"missing\":[\"light\"],\"suggestedRating\":4}').suggestedRating, 2);
  assert.equal(parseGrade('{\"verdict\":\"incorrect\",\"missing\":[],\"suggestedRating\":3}').suggestedRating, 1);
  assert.equal(parseGrade('{\"verdict\":\"correct\",\"missing\":[],\"suggestedRating\":4}').suggestedRating, 4);
  assert.throws(() => parseGrade('{\"verdict\":\"unknown\",\"missing\":[]}'), /incomplete/iu);

  const provider = new MockProvider();
  const grade = await checkAnswer(provider, \"demo\", card.front, card.back, \"Light\");
  assert.deepEqual(grade, { verdict: \"correct\", missing: [], suggestedRating: 3 });
  await assert.rejects(checkAnswer(new MockProvider({ nano: \"unavailable\" }), \"demo\", card.front, card.back, \"Light\"), /enable on-device/iu);
});

test(\"cloze blanks and hints hide the answer until reveal\", () => {
  const front = \"{{c1::Chlorophyll::pigment}} absorbs {{c1::light}}.\";
  assert.equal(renderFront(front, false), \"[pigment] absorbs […].\");
  assert.equal(renderFront(front, true), \"Chlorophyll absorbs light.\");
});

test(\"saving deduplicates against the deck and each review updates its schedule once\", async () => {
  const database = createMemoryDatabase();
  await database.put(\"decks\", { id: card.deckId, name: \"Biology\", createdAt: card.createdAt });
  assert.equal(await database.saveCards(card.deckId, [card]), 1);
  assert.equal(await database.saveCards(card.deckId, [{ ...card, id: \"duplicate\" }]), 0);
  assert.deepEqual(dueCards(await database.all(\"cards\"), card.deckId, start.getTime()), [card]);
  const schedule = nextSchedule(card, Rating.Good, start);
  const review: Review = { id: \"review\", cardId: card.id, reviewedAt: start.getTime(), rating: Rating.Good };
  assert.equal(await database.recordReview(card, schedule, review), true);
  assert.equal(await database.recordReview(card, schedule, { ...review, id: \"duplicate-review\" }), false);
  assert.equal(dueCards(await database.all(\"cards\"), null, start.getTime()).length, 0);
  await database.deleteDeck(card.deckId);
  assert.deepEqual(await database.all(\"cards\"), []);
  assert.deepEqual(await database.all(\"reviews\"), []);
});
EOF
cat > test/unit/export.test.ts <<'EOF'
import assert from \"node:assert/strict\";
import { test } from \"node:test\";
import { strFromU8, unzipSync } from \"fflate\";
import { JSDOM } from \"jsdom\";
import initSqlJs from \"sql.js\";
import type { Card, Deck } from \"../../src/cards/schema\";
import { buildApkg } from \"../../src/export/apkg\";
import { buildTsv } from \"../../src/export/tsv\";

const deck: Deck = { id: \"bio\", name: 'Biology::\"Plant science\"', createdAt: 1 };
const card: Card = {
  id: \"example-basic\", deckId: deck.id, type: \"basic\", createdAt: 1,
  front: '# Read \"light\" & <energy>\\t中文', back: 'Line 1\\nLine 2\\r\\n\"quoted\".',
  tags: [\"plants\", \"light\", \"plants\"],
  route: { source: \"on_device\", reason: \"Short text.\", ms: 0, tokensEst: 10 },
};
const cloze: Card = { ...card, id: \"example-cloze\", type: \"cloze\", front: \"Plants absorb {{c1::light}}.\", back: \"Chlorophyll.\" };

test(\"Anki TSV headers map the deck, note type and tags, with escaped fields round-tripping\", () => {
  const tsv = buildTsv([card, cloze], [deck]);
  const lines = tsv.trimEnd().split(\"\\n\");
  assert.deepEqual(lines.slice(0, 5), [\"#separator:tab\", \"#html:true\", \"#deck column:3\", \"#notetype column:4\", \"#tags column:5\"]);
  const rows = lines.slice(6).map((line) => line.split(\"\\t\").map((field) =>
    field.startsWith('\"') ? field.slice(1, -1).replace(/\"\"/gu, '\"') : field,
  ));
  const dom = new JSDOM();
  try {
    const decode = (field: string) => {
      const span = dom.window.document.createElement(\"span\");
      span.innerHTML = field.replace(/<br>/gu, \"\\n\");
      return span.textContent;
    };
    assert.deepEqual([decode(rows[0][0]), decode(rows[0][1]), ...rows[0].slice(2)],
      [card.front, card.back.replace(/\\r\\n/gu, \"\\n\"), deck.name, \"Basic\", \"plants light\"]);
    assert.equal(rows[1][0], cloze.front);
    assert.equal(rows[1][3], \"Cloze\");
  } finally {
    dom.window.close();
  }
});

test(\"Anki package contains readable SQLite notes, cards, models and decks\", async () => {
  const files = unzipSync(await buildApkg([card, cloze], [deck]));
  assert.equal(strFromU8(files.media), \"{}\");
  const SQL = await initSqlJs();
  const database = new SQL.Database(files[\"collection.anki2\"]);
  try {
    const [[count]] = database.exec(\"SELECT count(*) FROM notes\")[0].values;
    assert.equal(count, 2);
    const [basic, deletion] = database.exec(\"SELECT mid, flds, tags FROM notes ORDER BY id\")[0].values;
    assert.equal(basic[1], '# Read \"light\" &amp; &lt;energy&gt;&#9;中文\\x1fLine 1<br>Line 2<br>\"quoted\".');
    assert.equal(basic[2], \" plants light \");
    assert.equal(deletion[1], \""'${cloze.front}'"\\x1f"'${cloze.back}".replace("${cloze.front}", cloze.front).replace("${cloze.back}", cloze.back));
    assert.notEqual(basic[0], deletion[0]);
    const [[version, modelJson, deckJson]] = database.exec("SELECT ver, models, decks FROM col")[0].values;
    assert.equal(version, 11);
    const models = JSON.parse(String(modelJson));
    assert.equal(models[String(basic[0])].name, "Basic");
    assert.equal(models[String(deletion[0])].type, 1);
    const decks = JSON.parse(String(deckJson));
    const [[deckId]] = database.exec("SELECT did FROM cards GROUP BY did HAVING count(*) = 2")[0].values;
    assert.equal(decks[String(deckId)].name, deck.name);
    assert.equal(database.exec("PRAGMA integrity_check")[0].values[0][0], "ok");
  } finally {
    database.close();
  }
});
EOF
