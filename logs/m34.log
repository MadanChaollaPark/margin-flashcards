import assert from "node:assert/strict";
import { test } from "node:test";
import { InferenceMode } from "firebase/ai";
import { chunkText, decide, estimateTokens, hasSensitiveText } from "../../src/ai/router";
import type { ContentInput, GenerationJob } from "../../src/ai/provider";
import { DEFAULTS } from "../../src/firebase/remoteConfig";

const ctx = { ...DEFAULTS, nanoAvailable: true, online: true, privacyMode: false };
const text = "Plants use sunlight to produce sugar.";
const long = text.repeat(2_223);
const asJob = (input: ContentInput): GenerationJob => ({ input, deckId: "notes" });
const notes = asJob({ kind: "text", text });
const longDoc = asJob({ kind: "text", text: long });
const pdf = asJob({ kind: "pdf", mimeType: "application/pdf", data: "cGRm" });
const image = (mimeType: string) => asJob({ kind: "image", mimeType, data: "aW1hZ2U=" });

function route(job = notes, overrides: Partial<typeof ctx> & { classifiedSensitive?: boolean } = {}) {
  const decision = decide(job, { ...ctx, ...overrides });
  assert.ok(decision.reason.trim());
  return decision;
}

test("uses hybrid for short text, PNG and JPEG, including when Nano is unavailable", () => {
  assert.equal(route().mode, InferenceMode.PREFER_ON_DEVICE);
  assert.equal(route(notes, { nanoAvailable: false }).mode, InferenceMode.PREFER_ON_DEVICE);
  for (const mimeType of ["image/png", "image/jpeg"]) {
    assert.equal(route(image(mimeType)).mode, InferenceMode.PREFER_ON_DEVICE);
  }
  assert.equal(route(image("image/webp")).mode, InferenceMode.ONLY_IN_CLOUD);
  assert.equal(route(image("image/png"), { maxOnDeviceTokens: 1_023 }).mode, InferenceMode.ONLY_IN_CLOUD);
});

test("routes PDF bytes to the cloud and suggests text extraction in privacy mode", () => {
  const decision = route(pdf);
  if (decision.mode === "queue") assert.fail("expected cloud");
  assert.equal(decision.mode, InferenceMode.ONLY_IN_CLOUD);
  assert.equal(decision.cloudModel, DEFAULTS.longDocModel);
  assert.throws(() => route(pdf, { privacyMode: true }), /extract the PDF text/i);
});

test("sends roughly 20k tokens to the long-doc model and chunks sensitive text", () => {
  assert.ok(estimateTokens(long) >= 20_000);
  const cloud = route(longDoc);
  if (cloud.mode === "queue") assert.fail("expected cloud");
  assert.equal(cloud.mode, InferenceMode.ONLY_IN_CLOUD);
  assert.equal(cloud.cloudModel, DEFAULTS.longDocModel);

  for (const privacyMode of [false, true]) {
    const local = route({ ...longDoc, sensitive: !privacyMode }, { privacyMode });
    if (local.mode === "queue") assert.fail("expected local");
    assert.equal(local.mode, InferenceMode.ONLY_ON_DEVICE);
    assert.ok(local.chunks && local.chunks.length > 1);
    assert.equal(local.chunks.join(""), long);
    assert.ok(local.chunks.every((chunk) => estimateTokens(chunk) <= DEFAULTS.maxOnDeviceTokens));
  }

  const unicode = "aaa🌱bbb cc";
  assert.equal(chunkText(unicode, 1).join(""), unicode);
  assert.ok(!chunkText(unicode, 1).some((chunk) => /[\uD800-\uDBFF]$/u.test(chunk)));
});

test("privacy mode stays local and reports when Nano is unavailable", () => {
  assert.equal(route(notes, { privacyMode: true }).mode, InferenceMode.ONLY_ON_DEVICE);
  assert.throws(() => route(notes, { privacyMode: true, nanoAvailable: false }), /Gemini Nano is unavailable/i);
  assert.throws(() => route(image("image/gif"), { privacyMode: true }), /PNG or JPEG/i);
});

test("PII, explicit labels and Nano classifications pin content on-device", () => {
  for (const value of ["learner@example.invalid", "123-45-6789", "(555) 010-0123",
    "access_token = fake-example", "strictly confidential", "4111 1111 1111 1111"]) {
    assert.ok(hasSensitiveText(value), value);
    assert.equal(route(asJob({ kind: "text", text: value })).mode, InferenceMode.ONLY_ON_DEVICE);
  }
  assert.equal(route(notes, { classifiedSensitive: true }).mode, InferenceMode.ONLY_ON_DEVICE);
  assert.equal(route(notes, { classifiedSensitive: true, sensitivityCheck: false }).mode, InferenceMode.PREFER_ON_DEVICE);
  assert.equal(route({ ...notes, sensitive: true }, { sensitivityCheck: false }).mode, InferenceMode.ONLY_ON_DEVICE);
  assert.throws(() => route({ ...notes, sensitive: true }, { nanoAvailable: false }), /sensitive content stays on-device/i);
});

test("runs compatible jobs locally while offline and queues cloud jobs", () => {
  assert.equal(route(notes, { online: false }).mode, InferenceMode.ONLY_ON_DEVICE);
  assert.equal(route(notes, { online: false, nanoAvailable: false }).mode, "queue");
  assert.equal(route(pdf, { online: false }).mode, "queue");
  assert.equal(route(longDoc, { online: false }).mode, "queue");
  assert.equal(route({ ...longDoc, sensitive: true }, { online: false }).mode, InferenceMode.ONLY_ON_DEVICE);
  assert.throws(() => route({ ...notes, sensitive: true }, { online: false, nanoAvailable: false }), /Nano is unavailable/i);
});
import assert from "node:assert/strict";
import { test } from "node:test";
import { InferenceMode } from "firebase/ai";
import { MockProvider } from "../../src/ai/mockProvider";
import type { AIProvider, GenerationJob, InferenceRequest } from "../../src/ai/provider";
import { drainQueue, enqueue } from "../../src/ai/queue";
import { generateCards } from "../../src/ai/runtime";
import { isConfigured } from "../../src/firebase/config";
import { DEFAULTS, loadRemoteConfig } from "../../src/firebase/remoteConfig";
import { createMemoryDatabase } from "../../src/storage/db";

const job: GenerationJob = {
  deckId: "bio",
  input: { kind: "text", text: "Photosynthesis is the conversion of light into chemical energy. Plants use chlorophyll." },
};
const request: InferenceRequest = {
  task: { kind: "cards", input: job.input },
  mode: InferenceMode.PREFER_ON_DEVICE,
  reason: "The text fits.",
  cloudModel: DEFAULTS.cloudModel,
};

test("uses pure Remote Config defaults and recognizes the unconfigured placeholder", async () => {
  assert.equal(isConfigured({ apiKey: "REPLACE_ME", appId: "demo", projectId: "demo" }), false);
  assert.equal(isConfigured({ apiKey: "test", appId: "demo", projectId: "demo" }), true);
  assert.deepEqual(await loadRemoteConfig(), DEFAULTS);
  assert.notEqual(await loadRemoteConfig(), DEFAULTS);
});

test("mock generation is deterministic, uses definitions, and reports simulated source", async () => {
  const mock = new MockProvider();
  const local = await mock.generate(request);
  assert.deepEqual(local, await mock.generate(request));
  assert.equal(local.source, "on_device");
  const cards = JSON.parse(local.text);
  assert.equal(cards[0].front, "What is the definition of Photosynthesis?");
  assert.match(cards[0].back, /chemical energy/);
  assert.equal(cards.length, 2);

  const cloud = await new MockProvider({ nano: "unavailable" }).generate(request);
  assert.equal(cloud.source, "in_cloud");
  assert.equal(cloud.text, local.text);
  assert.equal((await mock.generate({ ...request, mode: InferenceMode.ONLY_IN_CLOUD })).source, "in_cloud");
});

test("mock supports initializing, unavailable local inference, and offline inference", async () => {
  const mock = new MockProvider({ nano: "downloadable" });
  const pinned = { ...request, mode: InferenceMode.ONLY_ON_DEVICE };
  await assert.rejects(mock.generate(pinned), /unavailable/);
  const milestones: number[] = [];
  await mock.initializeDeviceModel((value) => milestones.push(value));
  assert.deepEqual(milestones, [1]);
  assert.equal((await mock.status()).nano, "available");
  assert.equal((await mock.generate(pinned)).source, "on_device");

  const offline = new MockProvider({ online: false });
  assert.equal((await offline.generate(request)).source, "on_device");
  await assert.rejects(offline.generate({ ...request, mode: InferenceMode.ONLY_IN_CLOUD }), /offline/);
});

test("mock grading and sensitivity return structured results", async () => {
  const mock = new MockProvider();
  const grade = await mock.generate({
    ...request,
    task: { kind: "grade", question: "What does the plant use?", expected: "sunlight and water", answer: "sunlight and water" },
  });
  assert.deepEqual(JSON.parse(grade.text), { verdict: "correct", missing: [], suggestedRating: 3 });
  const classification = await mock.generate({
    ...request, mode: InferenceMode.ONLY_ON_DEVICE, task: { kind: "sensitivity", text: "This is a confidential memo." },
  });
  assert.equal(classification.source, "on_device");
  assert.deepEqual(JSON.parse(classification.text), { sensitive: true });
});

test("the optional on-device sensitivity gate precedes any cloud-capable generation", async () => {
  const mock = new MockProvider();
  const calls: InferenceRequest[] = [];
  const provider: AIProvider = {
    status: () => mock.status(),
    initializeDeviceModel: () => mock.initializeDeviceModel(),
    generate: (req) => { calls.push(req); return mock.generate(req); },
  };
  const privateJob: GenerationJob = {
    ...job, input: { kind: "text", text: "This is a confidential memo for the legal team." },
  };
  const result = await generateCards(privateJob, provider, { config: DEFAULTS, online: true, privacyMode: false });
  assert.deepEqual(calls.map(({ task, mode }) => [task.kind, mode]), [
    ["sensitivity", InferenceMode.ONLY_ON_DEVICE], ["cards", InferenceMode.ONLY_ON_DEVICE],
  ]);
  assert.equal(result?.cards?.[0].route.source, "on_device");
  assert.match(result?.cards?.[0].route.reason ?? "", /sensitive/i);
});

test("the offline queue retains failures and atomically saves cards on retry", async () => {
  const database = createMemoryDatabase();
  const entry = await enqueue(job, "Offline.", database);
  let runs = 0;
  await drainQueue(async () => { runs++; return []; }, () => false, database);
  assert.equal(runs, 0);

  await drainQueue(async () => { throw new Error("Try again."); }, () => true, database);
  assert.equal((await database.get("queue", entry.id))?.lastError, "Try again.");
  assert.equal((await database.get("queue", entry.id))?.attempts, 1);

  await drainQueue(async (queued) => {
    const result = await generateCards(queued, new MockProvider(), { config: DEFAULTS, online: true, privacyMode: false });
    return result?.cards;
  }, () => true, database);

  assert.equal(await database.get("queue", entry.id), undefined);
  assert.equal((await database.all("cards")).length, 2);
});

test("a malformed model response gets one repair attempt in the same inference mode", async () => {
  const mock = new MockProvider();
  const calls: InferenceRequest[] = [];
  const provider: AIProvider = {
    status: () => mock.status(),
    initializeDeviceModel: () => mock.initializeDeviceModel(),
    async generate(req) {
      calls.push(req);
      const output = await mock.generate(req);
      return req.repair ? output : { ...output, text: "Unparseable result." };
    },
  };
  const result = await generateCards(job, provider, { config: DEFAULTS, online: true, privacyMode: true });
  assert.deepEqual(calls.map(({ mode, repair }) => [mode, repair]), [
    [InferenceMode.ONLY_ON_DEVICE, false], [InferenceMode.ONLY_ON_DEVICE, true],
  ]);
  assert.equal(result?.cards?.length, 2);
});
import assert from "node:assert/strict";
import { test } from "node:test";
import { dedupe } from "../../src/cards/dedupe";
import { parseCardResponse, parseCards } from "../../src/cards/parse";
import { MAX_CARDS, MAX_FRONT_LENGTH, validate } from "../../src/cards/schema";

const basic = { type: "basic", front: "How do plants capture energy from sunlight?", back: "Photosynthesis." } as const;

test("parses fenced JSON, normalizes whitespace and accepts a cards wrapper", () => {
  const json = JSON.stringify({ cards: [{ ...basic, front: `  ${basic.front}  ` }] });
  assert.deepEqual(parseCards("Flashcards\n```json\n" + json + "\n```\n"), [basic]);
});

test("repairs trailing commas without changing quoted content and recovers complete cards from a partial array", () => {
  const raw = String.raw`[{"front":"What are \"array\" delimiters?","back":"[,]",},
    {"front":false,"back":"invalid"}, {"front":"What follows?","back":"A complete card"}, {"front":"truncated`;
  assert.deepEqual(parseCards(raw), [
    { type: "basic", front: 'What are "array" delimiters?', back: "[,]" },
    { type: "basic", front: "What follows?", back: "A complete card" },
  ]);
  assert.deepEqual(parseCards("[{\"nogood\": }, " + JSON.stringify(basic) + ",]"), [basic]);
  assert.deepEqual(parseCards("No usable JSON"), []);
  assert.deepEqual(parseCardResponse('```json\n{"cards":[]}\n```'), []);
  assert.equal(parseCardResponse('[{"front":false}]'), undefined);
});

test("caps oversized responses and rejects oversized card fields", () => {
  const response = JSON.stringify(Array.from({ length: MAX_CARDS + 5 }, (_, index) => ({
    ...basic, front: `Question ${index}?`,
  })));
  assert.equal(parseCards(response).length, MAX_CARDS);
  assert.equal(parseCards(response, 2).length, 2);
  assert.equal(parseCards(response, 0).length, 0);
  assert.deepEqual(parseCards(" ".repeat(256_001) + response), []);
  assert.deepEqual(parseCards(JSON.stringify([{ ...basic, front: "x".repeat(MAX_FRONT_LENGTH + 1) }])), []);
});

test("rejects empty fronts and backs, unknown card types and cloze cards without a deletion", () => {
  for (const invalid of [null, { ...basic, front: "  " }, { ...basic, back: "" },
    { ...basic, type: "other" }, { ...basic, type: "cloze" },
    { ...basic, type: "cloze", front: "Plants use {{c1:: }}." }]) {
    assert.equal(validate(invalid), undefined);
  }
  assert.deepEqual(validate({ type: "cloze", front: "Plants use {{c1::chlorophyll}}.", back: "chlorophyll" }),
    { type: "cloze", front: "Plants use {{c1::chlorophyll}}.", back: "chlorophyll" });
});

test("deduplicates normalized fronts and near-duplicates while keeping the first card", () => {
  const unrelated = { ...basic, front: "What is an enzyme?" };
  assert.deepEqual(dedupe([
    basic,
    { ...basic, front: basic.front.toUpperCase().replace("?", "!"), back: "Duplicate." },
    { ...basic, front: "How do plants capture energy from the sunlight?" },
    unrelated,
  ]), [basic, unrelated]);
});
type DefaultSchedulerVersion = 'FSRS-3' | 'FSRS-4' | 'FSRS-4.5' | 'FSRS-5' | 'FSRS-6' | 'FSRS-7';
//#endregion
//#region src/scheduler/default-scheduler.d.ts
interface DefaultSchedulerOptions<Version extends DefaultSchedulerVersion = DefaultSchedulerVersion> {
  readonly weights?: readonly number[];
  /** Enable explicit learning steps. FSRS-7 always retains its intrinsic fast trace. */
  readonly enableShortTerm?: boolean;
  readonly desiredRetention?: number;
  /** Defaults to ['1m', '10m']. */
  readonly learningSteps?: readonly StepUnit[];
  /** Defaults to ['10m']. */
  readonly relearningSteps?: readonly StepUnit[];
  /** Minimum days for a review card; shorter intervals stay in (re)learning. Defaults to 1. */
  readonly graduatingInterval?: number;
  /** Let longer model intervals override learning steps; defaults to true for FSRS-7 only. */
  readonly allowModelOverride?: boolean;
  readonly enableFuzz?: boolean;
  readonly maximumInterval?: number;
  /** Whether forget clears reps and lapses; defaults to true. */
  readonly clearStatsOnForget?: boolean;
  /** FSRS model and parameter migration version; defaults to FSRS-7. */
  readonly version?: Version;
}
type DefaultSchedulerCore = ReturnType<DefaultSchedulerCreate<'FSRS-6'>>;
type DefaultSchedulerModelCore = Omit<DefaultSchedulerCore['model'], 'config' | 'algorithm'> & {
  readonly config: Partial<DefaultSchedulerCore['model']['config']> & Pick<DefaultSchedulerCore['model']['config'], 'weights'>;
  readonly algorithm: unknown;
