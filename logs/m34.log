    --accent-hover: #b7edd5;
    --accent-text: #142a1d;
    --device-bg: #233e32;
    --device-text: #a4e4c9;
    --cloud-bg: #263654;
    --cloud-text: #b9cfff;
    --queue-bg: #45391e;
    --queue-text: #f9d793;
    --error-bg: #412a27;
    --error-text: #ffc1b6;
