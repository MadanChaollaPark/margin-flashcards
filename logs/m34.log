from pathlib import Path

for name, stream in {
    \"text.pdf\": b\"BT /F1 12 Tf 30 100 Td (Chlorophyll absorbs light energy for photosynthesis.) Tj ET\",
    \"scan.pdf\": b\"0 g 30 90 100 20 re f\",
}.items():
