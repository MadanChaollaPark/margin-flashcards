import { CELL_BIOLOGY_PASSAGE, CELL_BIOLOGY_TITLE } from "../ai/demoSamples";
import { renderFront } from "../cards/cloze";
import { dedupe } from "../cards/dedupe";
import { cardTags, MAX_BACK_LENGTH, MAX_FRONT_LENGTH, validate, type Card } from "../cards/schema";
import { queueState, startQueueDrain, type QueuedJob } from "../ai/queue";
import { createRuntime, generateCards } from "../ai/runtime";
import { captureSource } from "../sources/capture";
import { PENDING_CAPTURE_PREFIX, type CaptureRequest, type SourceKind } from "../sources/request";
import { db } from "../storage/db";
import { listDecks, setDeckName } from "../storage/decks";
import { ask, cardRouteBadge, element, fillRoutingRules, fillTags, message, notify, queueRetryHelp, routeBadge, showDemoBanner } from "./shared";

const status = element("model-status");
const enable = element<HTMLButtonElement>("enable-model");
const progress = element<HTMLProgressElement>("model-progress");
const source = element<HTMLSelectElement>("source");
const deck = element<HTMLSelectElement>("deck");
const generate = element<HTMLButtonElement>("generate");
const accept = element<HTMLButtonElement>("accept");
const notes = element<HTMLTextAreaElement>("notes");
const imageField = element<HTMLInputElement>("image");
const preview = element("cards");
const queue = element("queued");
const deckDialog = element<HTMLDialogElement>("deck-dialog");

const hints: Record<SourceKind, string> = {
  selection: "Highlight a passage in the current tab.",
  page: "Use the readable text on the current tab.",
  pdf: "Open a PDF in the current tab.",
  youtube: "Open a YouTube video to use its captions.",
  image: "Choose a file, paste an image, or capture the visible tab.",
  paste: "Use your own notes or copied text.",
};

let cards: Card[] = [];
let image: File | undefined;
let busy = false;
let claiming = false;
let runtime: Awaited<ReturnType<typeof createRuntime>> | undefined;
let downloading = false;
let retryQueue: (() => void) | undefined;

async function refreshStatus() {
  if (downloading) return;
  const current = await createRuntime();
  if (downloading) return;
  runtime = current;
  const { nano } = await current.provider.status();
  if (downloading) return;
  const labels = { available: "On-device ready", downloadable: "Available to download", downloading: "Downloading…", unavailable: "Unavailable" };
  showDemoBanner(current.mock);
  element("model-row").hidden = current.mock;
  status.textContent = labels[nano];
  element("welcome-model").textContent = current.mock ? "This build simulates the model." : labels[nano];
  fillRoutingRules(current.config);
  status.className = `badge ${nano === "available" ? "device" : "neutral"}`;
  enable.hidden = current.mock || (nano !== "downloadable" && nano !== "downloading");
}

enable.addEventListener("click", async () => {
  if (!runtime || downloading) return;
  downloading = true;
  enable.disabled = true;
  progress.hidden = false;
  progress.removeAttribute("value");
  status.textContent = "Downloading…";
  try {
    await runtime.provider.initializeDeviceModel((value) => {
      progress.value = value;
      status.textContent = `Downloading ${Math.round(value * 100)}%`;
    });
  } catch (error) {
    notify(message(error, "On-device AI could not be enabled."), true);
  } finally {
    downloading = false;
    enable.disabled = false;
    progress.hidden = true;
    void refreshStatus().catch(reportError);
  }
});

function showSourceFields() {
  element("paste-fields").hidden = source.value !== "paste";
  element("image-fields").hidden = source.value !== "image";
  element("source-hint").textContent = hints[source.value as SourceKind];
}
source.addEventListener("change", showSourceFields);

const sample = element<HTMLButtonElement>("try-sample");
const captureForm = element<HTMLFormElement>("capture-form");
const editCapture = element<HTMLButtonElement>("edit-capture");

function expandCapture(expanded: boolean) {
  captureForm.hidden = sample.hidden = !expanded;
  editCapture.hidden = expanded;
  editCapture.setAttribute("aria-expanded", String(expanded));
}

editCapture.addEventListener("click", () => {
  expandCapture(true);
  source.focus();
});
sample.addEventListener("click", () => {
  source.value = "paste";
  notes.value = CELL_BIOLOGY_PASSAGE;
  showSourceFields();
  void dismissWelcome().catch(reportError);
  generate.focus();
});

const welcome = element("welcome");
async function dismissWelcome() {
  welcome.hidden = true;
  await chrome.storage.local.set({ welcomeSeen: true });
}
element("welcome-dismiss").addEventListener("click", () => { void dismissWelcome().catch(reportError); });
element("welcome-try").addEventListener("click", () => {
  source.value = "page";
  showSourceFields();
  void dismissWelcome().catch(reportError);
  element("capture-section").scrollIntoView({ block: "start" });
  generate.focus();
  expandCapture(true);
  captureForm.requestSubmit();
});


function showImage(file?: File) {
  image = file;
  element("image-name").textContent = file?.name || "Pasted image";
  element("chosen-image").hidden = !file;
}

imageField.addEventListener("change", () => showImage(imageField.files?.[0]));
element("clear-image").addEventListener("click", () => {
  imageField.value = "";
  showImage();
});
window.addEventListener("paste", (event) => {
  const file = [...(event.clipboardData?.files ?? [])].find(({ type }) => type.startsWith("image/"));
  if (!file || busy) return;
  event.preventDefault();
  imageField.value = "";
  source.value = "image";
  expandCapture(true);
  showSourceFields();
  showImage(file);
});

async function refreshDecks(selected = deck.value) {
  const decks = await listDecks();
  deck.replaceChildren(...decks.map(({ id, name }) => new Option(name, id)));
  if (decks.some(({ id }) => id === selected)) deck.value = selected;
  updateSaveBar();
}
import {
  getAI, getGenerativeModel, GoogleAIBackend, InferenceMode, InferenceSource,
  type AI, type LanguageModelCreateOptions, type LanguageModelExpected, type Part,
} from "firebase/ai";
import type { FirebaseApp } from "firebase/app";
import { MAX_INPUT_BUDGET, NANO_CONTEXT_TOKENS, NANO_OUTPUT_RESERVE, type RoutingConfig } from "../firebase/remoteConfig";
import { createPrompt, firebaseSchema } from "./prompts";
import { canRunOnDevice, estimateInputTokens, estimateTokens, nanoHint } from "./router";
import { routeReason, type AIProvider, type ContentInput, type InferenceRequest, type InferenceResult, type LocalAvailability } from "./provider";

type PromptAPI = {
  availability(options?: LanguageModelCreateOptions): Promise<LocalAvailability>;
};

const text: LanguageModelExpected = { type: "text", languages: ["en", "es", "ja"] };
const textOptions: LanguageModelCreateOptions = {
  expectedInputs: [text],
  expectedOutputs: [text],
};
const imageOptions: LanguageModelCreateOptions = {
  ...textOptions,
  expectedInputs: [text, { type: "image" }],
};

export function browserModel(): PromptAPI | undefined {
  return (globalThis as typeof globalThis & { LanguageModel?: PromptAPI }).LanguageModel;
}

export class FirebaseProvider implements AIProvider {
  private readonly ai: AI;

  constructor(app: FirebaseApp, private readonly config: RoutingConfig) {
    this.ai = getAI(app, { backend: new GoogleAIBackend(), useLimitedUseAppCheckTokens: true });
  }

  async status(input?: ContentInput): Promise<{ nano: LocalAvailability }> {
    try {
      return { nano: await browserModel()?.availability(input?.kind === "image" ? imageOptions : textOptions) ?? "unavailable" };
    } catch {
      return { nano: "unavailable" };
    }
  }

  // Call directly from the extension page's model enable button.
  async initializeDeviceModel(onProgress?: (progress: number) => void): Promise<void> {
    if (!browserModel()) throw new Error("Gemini Nano is unavailable in this browser.");
    const model = getGenerativeModel(this.ai, {
      mode: InferenceMode.ONLY_ON_DEVICE,
      inCloudParams: { model: this.config.cloudModel },
      onDeviceParams: { createOptions: textOptions },
    });
    await model.initializeDeviceModel(onProgress);
  }

  async generate({ task, mode, cloudModel, reason, repair }: InferenceRequest): Promise<InferenceResult> {
    const { prompt, schema } = createPrompt(task, this.config.maxCardsPerChunk, repair);
    const input = task.kind === "cards" ? task.input : undefined;
    const supported = !input || canRunOnDevice(input);
    const inputTokens = input ? estimateInputTokens(input)
      : estimateTokens(task.kind === "sensitivity" ? task.text : prompt);
    const extraMediaTokens = input ? inputTokens - estimateTokens(input.text ?? "") : 0;
    const fits = inputTokens <= Math.min(this.config.maxOnDeviceTokens, MAX_INPUT_BUDGET) &&
      estimateTokens(prompt) + estimateTokens(JSON.stringify(schema)) + extraMediaTokens <= NANO_CONTEXT_TOKENS - NANO_OUTPUT_RESERVE;

    if (mode === InferenceMode.ONLY_ON_DEVICE) {
      if (!supported || !fits) throw new Error("This request exceeds Gemini Nano's supported formats or token budget.");
      // Without a document-side adapter the SDK can dispatch directly to cloud.
      const { nano } = await this.status(input);
      if (nano !== "available" || typeof window === "undefined") {
        throw new Error(nanoHint(nano));
      }
    }

    const effectiveMode = mode === InferenceMode.PREFER_ON_DEVICE && (!supported || !fits)
      ? InferenceMode.ONLY_IN_CLOUD : mode;
    const model = getGenerativeModel(this.ai, {
      mode: effectiveMode,
      onDeviceParams: {
        createOptions: input?.kind === "image" ? imageOptions : textOptions,
        promptOptions: { responseConstraint: schema },
      },
      inCloudParams: {
        model: effectiveMode === mode ? cloudModel : this.config.longDocModel,
        generationConfig: { responseMimeType: "application/json", responseSchema: firebaseSchema(schema) },
      },
    });
    const parts: Part[] = [{ type: "text", text: prompt }];
    if (input?.kind === "youtube") {
      parts.push({ type: "fileData", fileData: { mimeType: "video/mp4", fileUri: input.url } });
    } else if (input && input.kind !== "text") {
      parts.push({ type: "inlineData", inlineData: { mimeType: input.mimeType, data: input.data } });
    }
    const { response } = await model.generateContent({ contents: [{ role: "user", parts }] });
    const source = response.inferenceSource ??
      (effectiveMode === InferenceMode.ONLY_IN_CLOUD ? InferenceSource.IN_CLOUD : undefined);
    if (source !== InferenceSource.ON_DEVICE && source !== InferenceSource.IN_CLOUD) {
      throw new Error("Firebase did not report where inference ran.");
    }
    if (effectiveMode === InferenceMode.ONLY_ON_DEVICE && source !== InferenceSource.ON_DEVICE) {
      throw new Error("Firebase reported an unexpected inference source for a local request.");
    }
    const actualReason = effectiveMode !== mode
      ? "The request exceeds the on-device format or token limits. Used cloud inference."
      : routeReason(mode, source, reason);
    return { text: response.text(), source, reason: actualReason };
  }
}
import { InferenceMode, InferenceSource } from "firebase/ai";
import type { Card } from "../cards/schema";

export type MediaInput =
  | { kind: "pdf"; mimeType: "application/pdf"; data: string }
  | { kind: "image"; mimeType: string; data: string };

export type ContentInput =
  | { kind: "text"; text: string }
  | { kind: "youtube"; url: string; text?: never }
  | (MediaInput & { text?: string });

export interface GenerationJob {
  input: ContentInput;
  deckId: string;
  sensitive?: boolean;
  source?: Card["source"];
  anchorPage?: boolean;
}

export type InferenceTask =
  | { kind: "cards"; input: ContentInput; quoteSource?: boolean }
  | { kind: "grade"; question: string; expected: string; answer: string }
  | { kind: "sensitivity"; text: string };

export type LocalAvailability = "available" | "downloadable" | "downloading" | "unavailable";

export interface InferenceRequest {
  task: InferenceTask;
  mode: InferenceMode;
  reason: string;
  cloudModel: string;
  repair?: boolean;
}

export interface InferenceResult {
  text: string;
  source: InferenceSource;
  simulated?: boolean;
  reason: string;
}

export interface AIProvider {
  status(input?: ContentInput): Promise<{ nano: LocalAvailability }>;
  initializeDeviceModel(onProgress?: (progress: number) => void): Promise<void>;
  generate(request: InferenceRequest): Promise<InferenceResult>;
}

export function routeReason(mode: InferenceMode, source: InferenceSource, reason: string): string {
  if (mode === InferenceMode.PREFER_ON_DEVICE) {
    return source === InferenceSource.ON_DEVICE ? `${reason} — Firebase AI Logic preferred Gemini Nano`
      : "Gemini Nano not ready — Firebase AI Logic fell back to cloud";
  }
  if (mode === InferenceMode.PREFER_IN_CLOUD && source === InferenceSource.ON_DEVICE) {
    return "Cloud inference unavailable — Firebase AI Logic fell back to Gemini Nano";
  }
  return reason;
}
import type { Card } from "../cards/schema";
import { db, type Database } from "../storage/db";
import type { GenerationJob } from "./provider";

export const MAX_ATTEMPTS = 3;
const INITIAL_BACKOFF_MS = 30_000;

export interface QueuedJob {
  id: string;
  job: GenerationJob;
  reason: string;
  createdAt: number;
  attempts: number;
  state?: "queued" | "failed" | "confirm";
  nextAttemptAt?: number;
  lastError?: string;
}

export function queueState(entry: QueuedJob): NonNullable<QueuedJob["state"]> {
  return entry.state ?? (entry.attempts >= MAX_ATTEMPTS ? "failed" : "queued");
}

export async function enqueue(job: GenerationJob, reason: string, database = db): Promise<QueuedJob> {
  const entry: QueuedJob = { id: crypto.randomUUID(), job, reason, createdAt: Date.now(), attempts: 0, state: "queued" };
  await database.put("queue", entry);
  return entry;
}

type ProcessJob = (job: GenerationJob) => Promise<Card[] | { confirm: string } | undefined>;

export async function drainQueue(
  process: ProcessJob,
  online: () => boolean,
  database: Database = db,
  onlyId?: string,
  now = Date.now,
): Promise<void> {
  const drain = async () => {
    if (!online()) return;
    const entries = (await database.all("queue")).filter((entry) => onlyId
      ? entry.id === onlyId
      : queueState(entry) === "queued" && (entry.nextAttemptAt ?? 0) <= now());
    entries.sort((first, second) => first.createdAt - second.createdAt);
    for (const entry of entries) {
      if (!online()) break;
      try {
        const result = await process(entry.job);
        if (result === undefined) continue;
        if (Array.isArray(result)) await database.completeQueuedJob(entry.id, result);
        else await database.updateQueuedJob({ ...entry, state: "confirm", lastError: result.confirm });
      } catch (error) {
        const attempts = (queueState(entry) === "failed" ? 0 : entry.attempts) + 1;
        const state = attempts >= MAX_ATTEMPTS ? "failed" : "queued";
        await database.updateQueuedJob({
          ...entry, attempts, state,
          nextAttemptAt: state === "queued" ? now() + INITIAL_BACKOFF_MS * 2 ** (attempts - 1) : undefined,
          lastError: error instanceof Error ? error.message : "Generation failed.",
        });
      }
    }
  };

  // Extension pages share this lock and cannot drain the same job concurrently.
  if (globalThis.navigator?.locks) await navigator.locks.request("margin-offline-queue", drain);
  else await drain();
}

export function startQueueDrain(process: ProcessJob, onError = console.error, onComplete?: () => void) {
  let timer: ReturnType<typeof setTimeout> | undefined;
  let stopped = false;
  let draining = false;
  async function run() {
    if (stopped || draining) return;
    clearTimeout(timer);
    draining = true;
    try {
      await drainQueue(process, () => navigator.onLine);
      onComplete?.();
      if (stopped || !navigator.onLine) return;
      const now = Date.now();
      const entries = await db.all("queue");
      const next = entries.reduce((earliest, entry) =>
        queueState(entry) === "queued" && entry.nextAttemptAt !== undefined
          ? Math.min(earliest, entry.nextAttemptAt) : earliest, Infinity);
      if (!stopped && Number.isFinite(next)) timer = setTimeout(drain, Math.max(1_000, next - now));
    } catch (error) {
      onError(error);
    } finally {
      draining = false;
    }
  }
  const drain = () => { void run(); };
  window.addEventListener("online", drain);
  drain();
  return {
    drain,
    stop() {
      stopped = true;
      clearTimeout(timer);
      window.removeEventListener("online", drain);
    },
  };
}

