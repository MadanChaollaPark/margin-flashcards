    if ("'!entry.endsWith(".js")) continue;
    const path = join(extension, entry);
    const before = await readFile(path, "utf8");
    const marker = '"'var define_MARGIN_FIREBASE_CONFIG_default = {};';
    if ("'!before.includes(marker)) continue;
    const fixture = { apiKey: "fixture", appId: "1:123:web:fixture", projectId: "margin-fixture" };
    await writeFile(path, before.replace(marker, `var define_MARGIN_FIREBASE_CONFIG_default = ${JSON.stringify(fixture)};`));
    patched = true;
  }
  assert.ok(patched);
  const context = await chromium.launchPersistentContext(join(scratch, "profile"), {
    channel: "chromium", headless: true,
    args: [`--disable-extensions-except=${extension}`, `--load-extension=${extension}`],
  });
  try {
    await context.addInitScript(() => {
      if (location.protocol !== "chrome-extension:") return;
      Object.defineProperty(window, "LanguageModel", { value: { availability: async () => "unavailable" } });
      window.fetch = async () => { throw new Error("Network blocked in smoke test."); };
    });
    const worker = context.serviceWorkers()[0] ?? await context.waitForEvent("serviceworker");
    const origin = new URL(worker.url()).origin.replace(/''^null$/, `chrome-extension://${new URL(worker.url()).host}`);
    await worker.evaluate(() => chrome.storage.local.set({ mock: true }));
    const panel = await context.newPage();
    await panel.goto(`${origin}/sidepanel.html`);
    await panel.getByRole("button", { name: "Try a sample" }).click();
    await panel.getByRole("button", { name: "Generate" }).click();
    await panel.getByRole("button", { name: /''^Save '"\\d+ cards to/u }).click();
    await expect(panel.getByRole(\"status\")).toHaveText(/"'^Saved '"\\d+ cards\\."'$/u);

    await worker.evaluate(() => chrome.storage.local.set({ mock: false }));
    await expect(panel.locator("#model-status")).toHaveText("Unavailable");
    await panel.getByRole("button", { name: "Edit capture" }).click().catch(() => {});
    await panel.getByLabel("Source", { exact: true }).selectOption("paste");
    await panel.getByLabel("Notes").fill("Contact learner@example.invalid for the practice course.");
    await panel.getByRole("button", { name: "Generate" }).click();
    await panel.getByRole("dialog", { name: "Send to cloud anyway?" }).getByRole("button", { name: "Cancel" }).click();
    await expect(panel.getByRole("status")).toHaveText("Kept on this device. Nothing was sent.");
    await expect(panel.locator(".card")).toHaveCount(0);

    const review = await context.newPage();
    await review.goto(`${origin}/review.html`);
    const answer = review.getByLabel("Your answer");
    await expect(answer).toHaveAttribute("placeholder", "On-device grading unavailable. Reveal and rate yourself.");
    await expect(review.locator("#check")).toBeHidden();
    await answer.fill("A practice answer");
    await answer.press("Enter");
    await expect(review.locator("#feedback")).toBeHidden();
    await review.getByRole("button", { name: "Reveal answer" }).click();
    await review.getByRole("button", { name: /''^Good/u }).click();
    await expect(review.locator("#review-progress")).toHaveText(/''^1 of/u);
    console.log("Live-mode UI with Nano unavailable: cloud decline, manual review and rating passed.");
  } finally {
    await context.close();
  }
} finally {
  await rm(scratch, { recursive: true, force: true });
}
