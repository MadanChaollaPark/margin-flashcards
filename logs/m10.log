import { InferenceMode, InferenceSource } from "firebase/ai";
import { dedupe } from "../cards/dedupe";
import { parseCardResponse } from "../cards/parse";
import type { Card, Route } from "../cards/schema";
import { shouldUseMock } from "../firebase/config";
import { initializeFirebase } from "../firebase/init";
import { loadRemoteConfig, MAX_INPUT_BUDGET, type RoutingConfig } from "../firebase/remoteConfig";
import { normalizeAnchorText, pageFragmentUrl } from "../sources/selection";
import { readSettings, type ModeOverride } from "../storage/settings";
import { FirebaseProvider } from "./firebaseProvider";
import { MAX_DEMO_CARDS, MockProvider } from "./mockProvider";
import type { AIProvider, GenerationJob, InferenceRequest } from "./provider";
import { enqueue, type QueuedJob } from "./queue";
import { chunkText, decide, estimateInputTokens, isSensitive, type RoutingContext } from "./router";

export async function createRuntime() {
  const settings = await readSettings();
  const mock = shouldUseMock(settings.mock);
  const app = mock ? undefined : initializeFirebase(settings);
  // Reuse the settings snapshot for one job so its privacy decisions stay consistent.
  const config = await loadRemoteConfig(app);
  const provider = app ? new FirebaseProvider(app, config) : new MockProvider(config);
  return { mock, provider, config, privacyMode: settings.privacyMode, modeOverride: settings.modeOverride };
}

export interface GenerationContext {
  config: RoutingConfig;
  privacyMode: boolean;
  online: boolean;
  modeOverride?: ModeOverride;
}

type GeneratedCard = Card & { route: Route };
type GenerationOutcome =
  | { cards: GeneratedCard[]; queued?: never; confirm?: never }
  | { cards?: never; queued: QueuedJob; confirm?: never }
  | { cards?: never; queued?: never; confirm: string };

export async function generateCards(
  job: GenerationJob,
  provider: AIProvider,
  { config, privacyMode, online, modeOverride }: GenerationContext,
  { queueIfOffline = true, confirmCloud }: {
    queueIfOffline?: boolean;
    confirmCloud?: (reason: string) => Promise<boolean>;
  } = {},
): Promise<GenerationOutcome | undefined> {
  const ctx: RoutingContext = {
    ...config, privacyMode, online, modeOverride, nano: (await provider.status(job.input)).nano,
  };
  let decision = decide(job, ctx);
  if (decision.mode === "confirm") {
    if (!confirmCloud) return { confirm: decision.reason };
    if (!await confirmCloud(decision.reason)) return;
    ctx.confirmedCloud = true;
    decision = decide(job, ctx);
  }
  if (decision.mode !== "queue" && decision.mode !== "confirm" && decision.mode !== InferenceMode.ONLY_ON_DEVICE &&
      ctx.sensitivityCheck && !!job.input.text?.trim() && !ctx.confirmedCloud &&
      !isSensitive(job, ctx) && (await provider.status()).nano === "available") {
    ctx.classifiedSensitive = await classify(job.input.text ?? "", provider, config);
    decision = decide(job, ctx);
  }
  if (decision.mode === "confirm") return { confirm: decision.reason };
  if (decision.mode === "queue") {
    const reason = provider instanceof MockProvider ? `Simulated — ${decision.reason}` : decision.reason;
    return queueIfOffline ? { queued: await enqueue(job, reason) } : undefined;
  }

  const inputs = decision.chunks?.map((text) => ({ kind: "text" as const, text })) ?? [job.input];
  const pageUrl = job.anchorPage ? job.source?.url : undefined;
  const pageText = pageUrl ? normalizeAnchorText(job.input.text ?? "").toLowerCase() : "";
  const sentences = pageUrl && inputs.length > 1 ? new Intl.Segmenter(undefined, { granularity: "sentence" }) : undefined;
  const cards: GeneratedCard[] = [];
  for (const input of inputs) {
    const started = performance.now();
    const request: InferenceRequest = {
      task: { kind: "cards", input, ...(pageUrl && { quoteSource: true }) },
      mode: decision.mode,
      reason: decision.reason,
      cloudModel: decision.cloudModel,
    };
    const { drafts, result } = await cardResponse(provider, request, config.maxCardsPerChunk);
    const route = {
      source: result.source, reason: result.reason, tokensEst: estimateInputTokens(input),
      ms: Math.round(performance.now() - started),
      runId: crypto.randomUUID(),
      simulated: result.simulated ?? false,
      localBytes: result.source === InferenceSource.ON_DEVICE
        ? new TextEncoder().encode(input.text ?? "").length + (input.kind === "image" ? Math.floor(input.data.replace(/=+$/u, "").length * 3 / 4) : 0)
        : 0,
    };
    const chunk = pageUrl ? normalizeAnchorText(input.text ?? "") : "";
    const firstSentence = sentences?.segment(input.text ?? "")[Symbol.iterator]().next().value?.segment;
    const chunkUrl = pageUrl && firstSentence ? pageFragmentUrl(pageUrl, pageText, chunk, firstSentence) : undefined;
    for (const { sourceQuote, ...draft } of drafts) {
      const url = pageUrl && sourceQuote ? pageFragmentUrl(pageUrl, pageText, chunk, sourceQuote) : undefined;
      const source = pageUrl ? { ...job.source, url: url ?? chunkUrl ?? pageUrl } : job.source;
      cards.push({ ...draft, id: crypto.randomUUID(), deckId: job.deckId, createdAt: Date.now(), source, route });
    }
  }
  const unique = dedupe(cards);
  return { cards: provider instanceof MockProvider ? unique.slice(0, MAX_DEMO_CARDS) : unique };
}

async function cardResponse(provider: AIProvider, request: InferenceRequest, limit: number) {
  for (const repair of [false, true]) {
    const result = await provider.generate({ ...request, repair });
    if (request.mode === InferenceMode.ONLY_ON_DEVICE && result.source !== InferenceSource.ON_DEVICE) {
      throw new Error("The provider returned a cloud result for an on-device request.");
    }
    const drafts = parseCardResponse(result.text, limit, request.task.kind === "cards" && request.task.quoteSource);
    if (drafts) return { drafts, result };
  }
  throw new Error("The model did not return valid flashcards.");
}

async function classify(text: string, provider: AIProvider, config: RoutingConfig): Promise<boolean> {
  for (const chunk of chunkText(text, Math.min(config.maxOnDeviceTokens, MAX_INPUT_BUDGET))) {
    if (!chunk.trim()) continue;
    try {
      const result = await provider.generate({
        task: { kind: "sensitivity", text: chunk },
        mode: InferenceMode.ONLY_ON_DEVICE,
        reason: "Check for sensitive content on-device before allowing cloud inference.",
        cloudModel: config.cloudModel,
      });
      if (result.source !== InferenceSource.ON_DEVICE) return true;
      const json = result.text.match(/\{[\s\S]*\}/u)?.[0];
      if (!json || !/^\{\s*"sensitive"\s*:\s*false\s*,?\s*\}$/u.test(json)) return true;
    } catch {
      return true;
    }
  }
  return false;
}
import { InferenceMode, InferenceSource } from "firebase/ai";
import type { AIProvider } from "./provider";

export interface AnswerGrade {
  verdict: "correct" | "partial" | "incorrect";
  missing: string[];
  suggestedRating: 1 | 2 | 3 | 4;
}

export function parseGrade(text: string): AnswerGrade {
  const value = JSON.parse(text.trim().replace(/^```(?:json)?\s*|\s*```$/giu, "")) as Partial<AnswerGrade> | null;
  if (!value || !Array.isArray(value.missing) || !value.missing.every((point) => typeof point === "string")) {
    throw new Error("Answer feedback was incomplete.");
  }
  const { verdict, missing } = value;
  if (verdict === "incorrect") return { verdict, missing, suggestedRating: 1 };
  if (verdict === "partial") return { verdict, missing, suggestedRating: 2 };
  if (verdict === "correct") return { verdict, missing, suggestedRating: value.suggestedRating === 4 ? 4 : 3 };
  throw new Error("Answer feedback was incomplete.");
}

export async function checkAnswer(
  provider: AIProvider, cloudModel: string, question: string, expected: string, answer: string,
): Promise<AnswerGrade> {
  if ((await provider.status()).nano !== "available") {
    throw new Error("Enable on-device AI in the side panel to check typed answers. You can still reveal the answer and rate yourself.");
  }
  const result = await provider.generate({
    task: { kind: "grade", question, expected, answer },
    mode: InferenceMode.ONLY_ON_DEVICE,
    reason: "Typed answers are graded on-device.",
    cloudModel,
  });
  if (result.source !== InferenceSource.ON_DEVICE) throw new Error("On-device answer feedback is unavailable.");
  return parseGrade(result.text);
}
import { checkAnswer, type AnswerGrade } from "../ai/grade";
import { createRuntime } from "../ai/runtime";
import { renderFront } from "../cards/cloze";
import type { Card, Review } from "../cards/schema";
import { dueAt, dueCards, intervalLabel, nextIntervals, nextSchedule, ratings } from "../srs/fsrs";
import { db } from "../storage/db";
import { cardRouteBadge, element, message, notify, showDemoBanner, watchDemoBanner } from "./shared";

const deckId = new URLSearchParams(location.search).get("deck");
const study = element("study");
const status = element("review-status");
const input = element<HTMLInputElement>("answer");
const check = element<HTMLButtonElement>("check");
const answerForm = element<HTMLFormElement>("answer-form");
const revealButton = element<HTMLButtonElement>("reveal");
const front = element("card-front");
const revealed = element("revealed");
const ratingGroup = element("ratings");
const feedback = element("feedback");
const progress = element<HTMLProgressElement>("progress");

let cards: Card[] = [];
let index = 0;
let checking = false;
let saving = false;
const sessionRatings = [0, 0, 0, 0];

function cardFront(card: Card, shown: boolean) {
  return card.type === "cloze" ? renderFront(card.front, shown) : card.front;
}

function showCard() {
  element("review-progress").textContent = `${index} of ${cards.length} complete`;
  progress.max = Math.max(1, cards.length);
  progress.value = index;
  const card = cards[index];
  if (!card) {
    study.hidden = element("shortcuts").hidden = true;
    element("summary").hidden = false;
    const count = sessionRatings.reduce((sum, value) => sum + value, 0);
    element("summary-count").textContent = `${count} ${count === 1 ? "card" : "cards"} reviewed.`;
    const tally = element("summary-ratings");
    tally.replaceChildren(...ratings.map(([rating, label]) => {
      const item = document.createElement("div");
      const title = document.createElement("dt");
      title.textContent = label;
      const value = document.createElement("dd");
      value.textContent = String(sessionRatings[rating - 1]);
      item.append(title, value);
      return item;
    }));
    return;
  }

  front.textContent = cardFront(card, false);
  const link = element<HTMLAnchorElement>("show-source");
  link.hidden = !card.source?.url || !/^(https?|file):/iu.test(card.source.url);
  if (!link.hidden) {
    link.href = card.source!.url!;
    link.title = card.source?.title ?? "";
  }
  input.value = "";
  input.disabled = false;
  check.disabled = true;
  revealButton.disabled = false;
  answerForm.hidden = false;
  revealed.hidden = feedback.hidden = true;
  front.tabIndex = -1;
  front.focus({ preventScroll: true });
}

function showFeedback(grade: AnswerGrade, simulated: boolean) {
  const labels = { correct: "Correct", partial: "Partly correct", incorrect: "Incorrect" };
  const verdict = document.createElement("strong");
  verdict.textContent = simulated ? `Simulated — ${labels[grade.verdict]}` : labels[grade.verdict];
  const header = document.createElement("div");
  header.className = "row feedback-heading";
  const route = document.createElement("span");
  route.className = "badge device";
  route.textContent = "Graded on-device";
  header.append(verdict, route);
  feedback.dataset.verdict = grade.verdict;
  feedback.replaceChildren(header);
  if (grade.missing.length) {
    const title = document.createElement("p");
    title.textContent = `Missing: ${grade.missing.join(" · ")}`;
    feedback.append(title);
  }
  feedback.hidden = false;
}

function reveal(grade?: AnswerGrade, simulated = false) {
  const card = cards[index];
  if (!card || !revealed.hidden) return;
  front.textContent = cardFront(card, true);
  element("card-back").textContent = card.back;
  element("generation-route").replaceChildren(cardRouteBadge(card.route));
  const response = input.value.trim();
  element("submitted-answer").hidden = !response;
  element("user-answer").textContent = response;
  answerForm.hidden = true;
  revealed.hidden = false;
  if (grade) showFeedback(grade, simulated);

  ratingGroup.replaceChildren(...nextIntervals(card).map(({ rating, label, milliseconds }) => {
    const button = document.createElement("button");
    const suggested = rating === grade?.suggestedRating;
    button.className = suggested ? "secondary suggested" : "secondary";
    button.type = "button";
    button.dataset.rating = String(rating);
    if (suggested) button.setAttribute("aria-description", "Suggested rating");
    button.textContent = label;
    const interval = document.createElement("span");
    interval.textContent = intervalLabel(milliseconds);
    button.append(interval);
    if (suggested) {
      const chip = document.createElement("span");
      chip.className = "suggestion-chip";
      chip.setAttribute("aria-hidden", "true");
      chip.textContent = "Suggested";
      button.append(chip);
    }
    button.addEventListener("click", () => { void rate(rating); });
    return button;
  }));
  front.focus({ preventScroll: true });
}

async function rate(rating: Review["rating"]) {
  if (saving || revealed.hidden || !cards[index]) return;
  saving = true;
  ratingGroup.inert = true;
  element("toast").hidden = true;
  const card = cards[index];
  try {
    const now = new Date();
    const schedule = nextSchedule(card, rating, now);
    const recorded = await db.recordReview(card, schedule, {
      id: crypto.randomUUID(), cardId: card.id, reviewedAt: now.getTime(), rating,
    });
    if (recorded) sessionRatings[rating - 1]++;
    else notify("This card was already handled in another tab.");
    index++;
    showCard();
  } catch (error) {
    notify(message(error, "Could not save your rating."), true);
  } finally {
    saving = false;
    ratingGroup.inert = false;
  }
}

input.addEventListener("input", () => { check.disabled = !input.value.trim(); });
revealButton.addEventListener("click", () => { if (!checking) reveal(); });
answerForm.addEventListener("submit", async (event) => {
  event.preventDefault();
  const card = cards[index];
  const answer = input.value.trim();
  if (checking || !card || !answer || !revealed.hidden) return;
  checking = input.disabled = check.disabled = revealButton.disabled = true;
  check.textContent = "Checking…";
  element("toast").hidden = true;
  try {
    const { provider, config, mock } = await createRuntime();
    showDemoBanner(mock);
    const grade = await checkAnswer(provider, config.cloudModel, cardFront(card, false), card.back, answer);
    reveal(grade, mock);
  } catch (error) {
    notify(message(error, "Could not check your answer."), true);
  } finally {
    checking = input.disabled = check.disabled = revealButton.disabled = false;
    check.textContent = "Check";
  }
});

window.addEventListener("keydown", (event) => {
  if (event.repeat || event.ctrlKey || event.metaKey || event.altKey || checking || study.hidden) return;
  if (event.target instanceof HTMLElement && event.target.closest("input, textarea, button, a, [contenteditable]")) return;
  if (event.key === " " && revealed.hidden) {
    event.preventDefault();
    reveal();
  }
  if (event.key === "Enter" && revealed.hidden && input.value.trim()) {
    event.preventDefault();
    answerForm.requestSubmit();
  }
  if (/^[1-4]$/u.test(event.key) && !revealed.hidden) {
    event.preventDefault();
    void rate(Number(event.key) as Review["rating"]);
  }
});

async function start() {
  const [all, deck] = await Promise.all([db.all("cards"), deckId ? db.get("decks", deckId) : undefined]);
  if (deckId) {
    element("all-due").hidden = false;
    if (!deck) {
      status.textContent = "This deck could not be found.";
      return;
    }
    document.querySelector("h1")!.textContent = deck.name;
    document.title = `${deck.name} review · Margin`;
  }
  cards = dueCards(all, deckId);
  if (!cards.length) {
    status.hidden = true;
    const next = all.filter((card) => !deckId || card.deckId === deckId)
      .reduce((earliest, card) => Math.min(earliest, dueAt(card)), Infinity);
    element("caught-up").hidden = false;
    if (Number.isFinite(next)) {
      const time = new Intl.DateTimeFormat(undefined, { dateStyle: "medium", timeStyle: "short" }).format(next);
      element("next-due").textContent = `Next review ${time}`;
    } else {
      element("empty-heading").textContent = "No flashcards yet";
      element("next-due").textContent = "Generate and save cards in the Margin side panel to start studying.";
    }
    return;
  }
  status.hidden = false;
  status.textContent = `${cards.length} ${cards.length === 1 ? "card" : "cards"} due`;
  status.className = "sr-only";
  study.hidden = element("session-progress").hidden = element("shortcuts").hidden = false;
  showCard();
}

void start().catch(() => { status.textContent = "Margin could not load your flashcards."; });

watchDemoBanner();

