import { InferenceSource } from "firebase/ai";
import type { Route } from "../cards/schema";
import { shouldUseMock } from "../firebase/config";
import { NANO_OUTPUT_RESERVE, type RoutingConfig } from "../firebase/remoteConfig";
import { readSettings } from "../storage/settings";

export const element = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

export function message(error: unknown, fallback: string): string {
  return error instanceof Error ? error.message : fallback;
}

export function notify(text: string, error = false): void {
  const toast = element<HTMLElement>("toast");
  toast.textContent = text;
  toast.classList.toggle("error", error);
  toast.hidden = false;
}

export function downloadFile(data: BlobPart, filename: string, type: string): void {
  const url = URL.createObjectURL(new Blob([data], { type }));
  const link = document.createElement("a");
  link.href = url;
  link.download = filename;
  document.body.append(link);
  link.click();
  link.remove();
  setTimeout(() => URL.revokeObjectURL(url), 1_000);
}

export function showDemoBanner(mock: boolean): void {
  element("demo-banner").hidden = !mock;
}

export function watchDemoBanner(): void {
  const update = () => { void readSettings().then(({ mock }) => showDemoBanner(shouldUseMock(mock))); };
  chrome.storage.onChanged.addListener((changes, area) => {
    if (area === "local" && changes.mock) update();
  });
  update();
}

export function ask(id: string, reason: string, action?: () => Promise<boolean>): Promise<boolean> {
  const dialog = element<HTMLDialogElement>(id);
  dialog.querySelector("p")!.textContent = reason;
  dialog.returnValue = "";
  return new Promise((resolve, reject) => {
    dialog.addEventListener("close", () => resolve(dialog.returnValue === "allow"), { once: true });
    const allow = dialog.querySelector<HTMLButtonElement>('[value="allow"]')!;
    allow.onclick = action ? (event) => {
      event.preventDefault();
      allow.disabled = true;
      void action().then((granted) => dialog.close(granted ? "allow" : "cancel"), (error) => {
        reject(error);
        dialog.close();
      }).finally(() => { allow.disabled = false; });
    } : null;
    dialog.showModal();
  });
}

export function fillRoutingRules(config: RoutingConfig): void {
  const rules = [
    ["On-device", `In Auto, Firebase prefers Gemini Nano for supported inputs up to ${config.maxOnDeviceTokens.toLocaleString()} estimated tokens, with ${NANO_OUTPUT_RESERVE.toLocaleString()} reserved for output. Firebase can fall back to cloud. Privacy mode and Only on-device require local inference.`],
    ["Cloud", `${config.cloudModel} for standard requests. ${config.longDocModel} for long text, scanned PDFs, and videos without captions. With Nano ready, long text splits into local chunks when offline, private, or set to Prefer on-device.`],
    ["Sensitive content", config.sensitivityCheck
      ? "The local sensitivity check is on. Sensitive text stays local, or asks for approval when a pattern matches and Nano is unavailable."
      : "The local sensitivity check is off. Privacy mode still requires local inference."],
    ["Offline and review", `Cloud jobs queue offline and reroute on retry. Generation allows ${config.maxCardsPerChunk} cards per chunk. Typed answers are graded on-device.`],
  ];
  element("routing-rules").replaceChildren(...rules.map(([title, description]) => {
    const item = document.createElement("li");
    const name = document.createElement("strong");
    name.textContent = title;
    const detail = document.createElement("p");
    detail.textContent = description;
    item.append(name, detail);
    return item;
  }));
}
export const queueRetryHelp = "Queued jobs retry when Margin is open and you're online.";

export function routeBadge(label: string, style: string, reason: string): HTMLDetailsElement {
  const details = document.createElement("details");
  details.className = "route";
  const summary = document.createElement("summary");
  summary.className = `badge ${style}`;
  summary.textContent = label;
  summary.title = reason;
  const explanation = document.createElement("p");
  explanation.className = "hint";
  explanation.textContent = reason;
  details.append(summary, explanation);
  return details;
}

export function cardRouteBadge(route?: Route): HTMLDetailsElement {
  if (!route) return routeBadge("Restored", "neutral", "Restored from a Firestore backup.");
  const local = route.source === InferenceSource.ON_DEVICE;
  const keptLocal = local && /sensitive|privacy mode|require on-device/iu.test(route.reason);
  const label = keptLocal ? "Kept local" : local ? "On-device" : "Cloud";
  return routeBadge(route.simulated ? `Simulated · ${label}` : label,
    keptLocal ? "private" : local ? "device" : "cloud", route.reason);
}

export function fillTags(list: HTMLUListElement, tags: string[] = []): void {
  list.replaceChildren(...tags.map((tag) => {
    const chip = document.createElement("li");
    chip.textContent = tag;
    return chip;
  }));
  list.hidden = !tags.length;
}
import { renderFront } from "../cards/cloze";
import { MAX_BACK_LENGTH, MAX_FRONT_LENGTH, validate, type Card, type Deck } from "../cards/schema";
import { dueAt } from "../srs/fsrs";
import { db } from "../storage/db";
import { listDecks } from "../storage/decks";
import { cardRouteBadge, element, fillTags, message, notify, watchDemoBanner } from "./shared";

const search = element<HTMLInputElement>("search");
const deckFilter = element<HTMLSelectElement>("deck-filter");
const list = element("library-cards");
const count = element("library-count");
const template = element<HTMLTemplateElement>("library-card");
const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: "medium", timeStyle: "short" });
let decks: Deck[] = [];
let entries: { card: Card; row: HTMLElement; text: string }[] = [];
let loading = false;

function filterCards() {
  const terms = search.value.normalize("NFKC").toLocaleLowerCase().trim().split(/\s+/u);
  let visible = 0;
  for (const { card, row, text } of entries) {
    row.hidden = (deckFilter.value !== "" && card.deckId !== deckFilter.value) ||
      !terms.every((term) => text.includes(term));
    if (!row.hidden) visible++;
  }
  count.textContent = !entries.length ? "No saved cards yet." : !visible ? "No cards match your search or deck filter."
    : `${visible} ${visible === 1 ? "card" : "cards"}`;
}

function cardEntry(card: Card) {
  const row = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
  const heading = row.querySelector("h2")!;
  heading.textContent = card.type === "cloze" ? renderFront(card.front, false) : card.front;
  heading.id = `card-${card.id}`;
  row.setAttribute("aria-labelledby", heading.id);
  row.querySelector(".preview-back")!.textContent = card.back;
  fillTags(row.querySelector("ul")!, card.tags);
  row.querySelector(".card-deck")!.textContent = decks.find(({ id }) => id === card.deckId)?.name ?? "Deck unavailable";
  const due = new Date(dueAt(card));
  const time = row.querySelector("time")!;
  time.dateTime = due.toISOString();
  time.textContent = dateFormat.format(due);
  const route = cardRouteBadge(card.route);
  route.open = true;
  row.querySelector(".library-route")!.append(route);

  const form = row.querySelector("form")!;
  const front = form.elements.namedItem("front") as HTMLTextAreaElement;
  const back = form.elements.namedItem("back") as HTMLTextAreaElement;
  const tags = form.elements.namedItem("tags") as HTMLInputElement;
  const deck = form.elements.namedItem("deck") as HTMLSelectElement;
  const error = form.querySelector("p")!;
  deck.id = `deck-${card.id}`;
  form.querySelector<HTMLLabelElement>(".edit-deck-label")!.htmlFor = deck.id;
  front.maxLength = MAX_FRONT_LENGTH;
  back.maxLength = MAX_BACK_LENGTH;
  if (card.type === "cloze") front.parentElement!.querySelector("span")!.textContent = "Front (cloze)";
  const copy = row.querySelector<HTMLElement>(".card-copy")!;
  const edit = row.querySelector<HTMLButtonElement>(".edit-card")!;
  const remove = row.querySelector<HTMLButtonElement>(".delete-card")!;
  form.id = `edit-${card.id}`;
  edit.setAttribute("aria-controls", form.id);
  function toggleEditor(open: boolean) {
    if (open) {
      front.value = card.front;
      back.value = card.back;
      tags.value = card.tags?.join(" ") ?? "";
      deck.replaceChildren(...decks.map(({ name, id }) => new Option(name, id)));
      deck.value = card.deckId;
      error.hidden = true;
    }
    form.hidden = !open;
    copy.hidden = open;
    edit.setAttribute("aria-expanded", String(open));
    edit.hidden = open;
    (open ? front : edit).focus();
  }

  edit.addEventListener("click", () => toggleEditor(true));
  form.querySelector(".cancel-edit")!.addEventListener("click", () => toggleEditor(false));
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    const draft = validate({ type: card.type, front: front.value, back: back.value, tags: [tags.value] });
    if (!draft) {
      error.textContent = card.type === "cloze" ? "Enter a front with {{c1::answer}} and a back." : "Enter a front and back.";
      error.hidden = false;
      return;
    }
    row.inert = true;
    error.hidden = true;
    try {
      const saved = cardEntry(await db.updateCard(card.id, deck.value, draft));
      entries = entries.map((entry) => entry.card.id === card.id ? saved : entry);
      row.replaceWith(saved.row);
      filterCards();
      (saved.row.hidden ? search : saved.row.querySelector<HTMLButtonElement>(".edit-card"))?.focus();
      notify("Card saved.");
    } catch (failure) {
      error.textContent = message(failure, "Could not save this card.");
      error.hidden = false;
    } finally {
      row.inert = false;
    }
  });

  remove.addEventListener("click", async () => {
    if (!confirm("Delete this card and its review history?")) return;
    row.inert = true;
    try {
      await db.deleteCard(card.id);
      entries = entries.filter((entry) => entry.card.id !== card.id);
      row.remove();
      filterCards();
      search.focus();
      notify("Card deleted.");
    } catch (failure) {
      notify(message(failure, "Could not delete this card."), true);
    } finally {
      row.inert = false;
    }
  });

  const text = [card.front, card.back, ...(card.tags ?? [])].join(" ").normalize("NFKC").toLocaleLowerCase();
  return { card, row, text };
}

async function loadCards() {
  const editing = "form:not([hidden]), [inert]";
  if (loading || list.querySelector(editing)) return;
  const previous = entries;
  loading = true;
  try {
    const [all, availableDecks] = await Promise.all([db.all("cards"), listDecks()]);
    if (entries !== previous || list.querySelector(editing)) return;
    decks = availableDecks;
    const selection = deckFilter.value;
    deckFilter.replaceChildren(new Option("All decks", ""), ...decks.map(({ name, id }) => new Option(name, id)));
    deckFilter.value = decks.some(({ id }) => id === selection) ? selection : "";
    entries = all.sort((a, b) => b.createdAt - a.createdAt).map(cardEntry);
    list.replaceChildren(...entries.map(({ row }) => row));
    filterCards();
  } catch (failure) {
    count.textContent = message(failure, "Could not load your cards.");
  } finally {
    loading = false;
  }
}

search.addEventListener("input", filterCards);
deckFilter.addEventListener("change", filterCards);
document.addEventListener("visibilitychange", () => { if (!document.hidden) void loadCards(); });
void loadCards();
watchDemoBanner();
import { InferenceSource } from "firebase/ai";
import { checkAnswer, type CheckedAnswer } from "../ai/grade";
import { createRuntime } from "../ai/runtime";
import { renderFront } from "../cards/cloze";
import type { Card, Review } from "../cards/schema";
import { dueAt, dueCards, intervalLabel, nextIntervals, nextSchedule, ratings } from "../srs/fsrs";
import { db } from "../storage/db";
import { cardRouteBadge, element, message, notify, showDemoBanner, watchDemoBanner } from "./shared";

const deckId = new URLSearchParams(location.search).get("deck");
const study = element("study");
const status = element("review-status");
const input = element<HTMLInputElement>("answer");
const check = element<HTMLButtonElement>("check");
const answerForm = element<HTMLFormElement>("answer-form");
const revealButton = element<HTMLButtonElement>("reveal");
const front = element("card-front");
const revealed = element("revealed");
const ratingGroup = element("ratings");
const feedback = element("feedback");
const progress = element<HTMLProgressElement>("progress");

let cards: Card[] = [];
let index = 0;
let checking = false;
let saving = false;
const sessionRatings = [0, 0, 0, 0];

function cardFront(card: Card, shown: boolean) {
  return card.type === "cloze" ? renderFront(card.front, shown) : card.front;
}

function showCard() {
  element("review-progress").textContent = `${index} of ${cards.length} complete`;
  progress.max = Math.max(1, cards.length);
  progress.value = index;
  const card = cards[index];
  if (!card) {
    study.hidden = element("shortcuts").hidden = true;
    element("summary").hidden = false;
    const count = sessionRatings.reduce((sum, value) => sum + value, 0);
    element("summary-count").textContent = `${count} ${count === 1 ? "card" : "cards"} reviewed.`;
    const tally = element("summary-ratings");
    tally.replaceChildren(...ratings.map(([rating, label]) => {
      const item = document.createElement("div");
      const title = document.createElement("dt");
      title.textContent = label;
      const value = document.createElement("dd");
      value.textContent = String(sessionRatings[rating - 1]);
      item.append(title, value);
      return item;
    }));
    return;
  }

  front.textContent = cardFront(card, false);
  const link = element<HTMLAnchorElement>("show-source");
  link.hidden = !card.source?.url || !/^(https?|file):/iu.test(card.source.url);
  if (!link.hidden) {
    link.href = card.source!.url!;
    link.title = card.source?.title ?? "";
  }
  input.value = "";
  input.disabled = false;
  check.disabled = true;
  revealButton.disabled = false;
  answerForm.hidden = false;
  revealed.hidden = feedback.hidden = true;
  front.tabIndex = -1;
  front.focus({ preventScroll: true });
}

function showFeedback(grade: CheckedAnswer) {
  const labels = { correct: "Correct", partial: "Partly correct", incorrect: "Incorrect" };
  const verdict = document.createElement("strong");
  verdict.textContent = grade.simulated ? `Simulated — ${labels[grade.verdict]}` : labels[grade.verdict];
  const header = document.createElement("div");
  header.className = "row feedback-heading";
  header.append(verdict);
  if (grade.source === InferenceSource.ON_DEVICE) {
    const route = document.createElement("span");
    route.className = "badge device";
    route.textContent = grade.simulated ? "Simulated · Graded on-device" : "Graded on-device";
    header.append(route);
  }
  feedback.dataset.verdict = grade.verdict;
  feedback.replaceChildren(header);
  if (grade.missing.length) {
    const title = document.createElement("p");
    title.textContent = `Missing: ${grade.missing.join(" · ")}`;
    feedback.append(title);
  }
  feedback.hidden = false;
}

function reveal(grade?: CheckedAnswer) {
  const card = cards[index];
  if (!card || !revealed.hidden) return;
  front.textContent = cardFront(card, true);
  element("card-back").textContent = card.back;
  element("generation-route").replaceChildren(cardRouteBadge(card.route));
  const response = input.value.trim();
  element("submitted-answer").hidden = !response;
  element("user-answer").textContent = response;
  answerForm.hidden = true;
  revealed.hidden = false;
  if (grade) showFeedback(grade);

  ratingGroup.replaceChildren(...nextIntervals(card).map(({ rating, label, milliseconds }) => {
    const button = document.createElement("button");
    const suggested = rating === grade?.suggestedRating;
    button.className = suggested ? "secondary suggested" : "secondary";
    button.type = "button";
    button.dataset.rating = String(rating);
    if (suggested) button.setAttribute("aria-description", "Suggested rating");
    button.textContent = label;
    const interval = document.createElement("span");
    interval.textContent = intervalLabel(milliseconds);
    button.append(interval);
    if (suggested) {
      const chip = document.createElement("span");
      chip.className = "suggestion-chip";
      chip.setAttribute("aria-hidden", "true");
      chip.textContent = "Suggested";
      button.append(chip);
    }
    button.addEventListener("click", () => { void rate(rating); });
    return button;
  }));
  front.focus({ preventScroll: true });
}

async function rate(rating: Review["rating"]) {
  if (saving || revealed.hidden || !cards[index]) return;
  saving = true;
  ratingGroup.inert = true;
  element("toast").hidden = true;
  const card = cards[index];
  try {
    const now = new Date();
    const schedule = nextSchedule(card, rating, now);
    const recorded = await db.recordReview(card, schedule, {
      id: crypto.randomUUID(), cardId: card.id, reviewedAt: now.getTime(), rating,
    });
    if (recorded) sessionRatings[rating - 1]++;
    else notify("This card was already handled in another tab.");
    index++;
    showCard();
  } catch (error) {
    notify(message(error, "Could not save your rating."), true);
  } finally {
    saving = false;
    ratingGroup.inert = false;
  }
}

input.addEventListener("input", () => { check.disabled = Boolean(check.hidden) || !input.value.trim(); });
revealButton.addEventListener("click", () => { if (!checking) reveal(); });
answerForm.addEventListener("submit", async (event) => {
  event.preventDefault();
  const card = cards[index];
  const answer = input.value.trim();
  if (check.hidden || checking || !card || !answer || !revealed.hidden) return;
  checking = input.disabled = check.disabled = revealButton.disabled = true;
  check.textContent = "Checking…";
  element("toast").hidden = true;
  try {
    const { provider, config, mock } = await createRuntime();
    showDemoBanner(mock);
    const grade = await checkAnswer(provider, config.cloudModel, cardFront(card, false), card.back, answer);
    reveal(grade);
  } catch (error) {
    notify(message(error, "Could not check your answer."), true);
  } finally {
    checking = input.disabled = check.disabled = revealButton.disabled = false;
    check.textContent = "Check";
  }
});

window.addEventListener("keydown", (event) => {
  if (event.repeat || event.ctrlKey || event.metaKey || event.altKey || checking || study.hidden) return;
  if (event.target instanceof HTMLElement && event.target.closest("input, textarea, button, a, [contenteditable]")) return;
  if (event.key === " " && revealed.hidden) {
    event.preventDefault();
    reveal();
  }
  if (event.key === "Enter" && !check.hidden && revealed.hidden && input.value.trim()) {
    event.preventDefault();
    answerForm.requestSubmit();
  }
  if (/^[1-4]$/u.test(event.key) && !revealed.hidden) {
    event.preventDefault();
    void rate(Number(event.key) as Review["rating"]);
  }
});

async function start() {
  const [all, deck] = await Promise.all([db.all("cards"), deckId ? db.get("decks", deckId) : undefined]);
  if (deckId) {
    element("all-due").hidden = false;
    if (!deck) {
      status.textContent = "This deck could not be found.";
      return;
    }
    document.querySelector("h1")!.textContent = deck.name;
    document.title = `${deck.name} review · Margin`;
  }
  cards = dueCards(all, deckId);
  if (!cards.length) {
    status.hidden = true;
    const next = all.filter((card) => !deckId || card.deckId === deckId)
      .reduce((earliest, card) => Math.min(earliest, dueAt(card)), Infinity);
    element("caught-up").hidden = false;
    if (Number.isFinite(next)) {
      const time = new Intl.DateTimeFormat(undefined, { dateStyle: "medium", timeStyle: "short" }).format(next);
      element("next-due").textContent = `Next review ${time}`;
    } else {
      element("empty-heading").textContent = "No flashcards yet";
      element("next-due").textContent = "Generate and save cards in the Margin side panel to start studying.";
    }
    return;
  }
  const canGrade = await createRuntime()
    .then(async ({ provider, mock }) => mock || (await provider.status()).nano === "available")
    .catch(() => false);
  if (!canGrade) {
    check.hidden = element("check-shortcut").hidden = true;
    input.placeholder = "On-device grading unavailable. Reveal and rate yourself.";
  }
  status.hidden = false;
  status.textContent = `${cards.length} ${cards.length === 1 ? "card" : "cards"} due`;
  status.className = "sr-only";
  study.hidden = element("session-progress").hidden = element("shortcuts").hidden = false;
  showCard();
}

void start().catch(() => { status.textContent = "Margin could not load your flashcards."; });

watchDemoBanner();

