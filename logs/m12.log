import assert from \"node:assert/strict\";
import { test } from \"node:test\";
import { dedupe } from \"../../src/cards/dedupe\";
import { parseCards } from \"../../src/cards/parse\";
import { MAX_CARDS, MAX_FRONT_LENGTH, validate } from \"../../src/cards/schema\";

const basic = { type: \"basic\", front: \"How do plants capture energy from sunlight?\", back: \"Photosynthesis.\" } as const;

test(\"parses fenced JSON, normalizes whitespace and accepts a cards wrapper\", () => {
  const json = JSON.stringify({ cards: [{ ...basic, front: "'`  ${basic.front}  ` }] });
  assert.deepEqual(parseCards("Flashcards'"\\n"'```json'"\\n\" + json + \"\\n"'```'"\\n\"), [basic]);
});

test(\"repairs trailing commas without changing quoted content and recovers complete cards from a partial array\", () => {
  const raw = '[{\"front\":\"What are \\\"array\\\" delimiters?\",\"back\":\"[,]\",},' +
    '{\"front\":false,\"back\":\"invalid\"}, {\"front\":\"What follows?\",\"back\":\"A complete card\"}, {\"front\":\"truncated';
  const escaped = String.raw"'`[{"front":"What are '"\\\"array\\\" delimiters?\",\"back\":\"[,]\",},"'` + raw.slice(raw.indexOf('"'},') + 2);
  assert.deepEqual(parseCards(escaped), [
    { type: \"basic\", front: 'What are \"array\" delimiters?', back: \"[,]\" },
    { type: \"basic\", front: \"What follows?\", back: \"A complete card\" },
  ]);
  assert.deepEqual(parseCards(\"[{\\\"nogood\\\": }, \" + JSON.stringify(basic) + \",]\"), [basic]);
  assert.deepEqual(parseCards(\"No usable JSON\"), []);
});

test(\"caps oversized responses and rejects oversized card fields\", () => {
  const response = JSON.stringify(Array.from({ length: MAX_CARDS + 5 }, (_, index) => ({
    ...basic, front: "'`Question ${index}?`,
  })));
  assert.equal(parseCards(response).length, MAX_CARDS);
  assert.equal(parseCards(response, 2).length, 2);
  assert.equal(parseCards(response, 0).length, 0);
  assert.deepEqual(parseCards(" ".repeat(256_001) + response), []);
  assert.deepEqual(parseCards(JSON.stringify([{ ...basic, front: "x".repeat(MAX_FRONT_LENGTH + 1) }])), []);
});

test("rejects empty fronts and backs, unknown card types and cloze cards without a deletion", () => {
  for (const invalid of [null, { ...basic, front: "  " }, { ...basic, back: "" },
    { ...basic, type: "other" }, { ...basic, type: "cloze" }]) {
    assert.equal(validate(invalid), undefined);
  }
  assert.deepEqual(validate({ type: "cloze", front: "Plants use {{c1::chlorophyll}}.", back: "chlorophyll" }),
    { type: "cloze", front: "Plants use {{c1::chlorophyll}}.", back: "chlorophyll" });
});

test("deduplicates normalized fronts and near-duplicates while keeping the first card", () => {
  const unrelated = { ...basic, front: "What is an enzyme?" };
  assert.deepEqual(dedupe([
    basic,
    { ...basic, front: basic.front.toUpperCase().replace("?", "!"), back: "Duplicate." },
    { ...basic, front: "How do plants capture energy from the sunlight?" },
    unrelated,
  ]), [basic, unrelated]);
});
EOF
cat > test/unit/router.test.ts <<'"'EOF'
import assert from \"node:assert/strict\";
import { test } from \"node:test\";
import { InferenceMode } from \"firebase/ai\";
import { chunkText, decide, estimateTokens, hasSensitiveText } from \"../../src/ai/router\";
import type { ContentInput, GenerationJob } from \"../../src/ai/provider\";
import { DEFAULTS } from \"../../src/firebase/remoteConfig\";

const ctx = { ...DEFAULTS, nanoAvailable: true, online: true, privacyMode: false };
const text = \"Plants use sunlight to produce sugar.\";
const long = text.repeat(2_223);
const asJob = (input: ContentInput): GenerationJob => ({ input, deckId: \"notes\" });
const notes = asJob({ kind: \"text\", text });
const longDoc = asJob({ kind: \"text\", text: long });
const pdf = asJob({ kind: \"pdf\", mimeType: \"application/pdf\", data: \"cGRm\" });
const image = (mimeType: string) => asJob({ kind: \"image\", mimeType, data: \"aW1hZ2U=\" });

function route(job = notes, overrides: Partial<typeof ctx> & { classifiedSensitive?: boolean } = {}) {
  const decision = decide(job, { ...ctx, ...overrides });
  assert.ok(decision.reason.trim());
  return decision;
}

test(\"uses hybrid for short text, PNG and JPEG, including when Nano is unavailable\", () => {
  assert.equal(route().mode, InferenceMode.PREFER_ON_DEVICE);
  assert.equal(route(notes, { nanoAvailable: false }).mode, InferenceMode.PREFER_ON_DEVICE);
  for (const mimeType of [\"image/png\", \"image/jpeg\"]) {
    assert.equal(route(image(mimeType)).mode, InferenceMode.PREFER_ON_DEVICE);
  }
  assert.equal(route(image(\"image/webp\")).mode, InferenceMode.ONLY_IN_CLOUD);
  assert.equal(route(image(\"image/png\"), { maxOnDeviceTokens: 1_023 }).mode, InferenceMode.ONLY_IN_CLOUD);
});

test(\"routes PDF bytes to the cloud and suggests text extraction in privacy mode\", () => {
  const decision = route(pdf);
  if (decision.mode === \"queue\") assert.fail(\"expected cloud\");
  assert.equal(decision.mode, InferenceMode.ONLY_IN_CLOUD);
  assert.equal(decision.cloudModel, DEFAULTS.longDocModel);
  assert.throws(() => route(pdf, { privacyMode: true }), /extract the PDF text/i);
});

test(\"sends roughly 20k tokens to the long-doc model and chunks sensitive text\", () => {
  assert.ok(estimateTokens(long) >= 20_000);
  const cloud = route(longDoc);
  if (cloud.mode === \"queue\") assert.fail(\"expected cloud\");
  assert.equal(cloud.mode, InferenceMode.ONLY_IN_CLOUD);
  assert.equal(cloud.cloudModel, DEFAULTS.longDocModel);

  for (const privacyMode of [false, true]) {
    const local = route({ ...longDoc, sensitive: "'!privacyMode }, { privacyMode });
    if (local.mode === "queue") assert.fail("expected local");
    assert.equal(local.mode, InferenceMode.ONLY_ON_DEVICE);
    assert.ok(local.chunks && local.chunks.length > 1);
    assert.equal(local.chunks.join(""), long);
    assert.ok(local.chunks.every((chunk) => estimateTokens(chunk) <= DEFAULTS.maxOnDeviceTokens));
  }

  const unicode = "aaa🌱bbb cc";
  assert.equal(chunkText(unicode, 1).join(""), unicode);
  assert.ok(!chunkText(unicode, 1).some((chunk) => /['"\\uD800-\\uDBFF]"'$/u.test(chunk)));
});

test("privacy mode stays local and reports when Nano is unavailable", () => {
  assert.equal(route(notes, { privacyMode: true }).mode, InferenceMode.ONLY_ON_DEVICE);
  assert.throws(() => route(notes, { privacyMode: true, nanoAvailable: false }), /Gemini Nano is unavailable/i);
  assert.throws(() => route(image("image/gif"), { privacyMode: true }), /PNG or JPEG/i);
});

test("PII, explicit labels and Nano classifications pin content on-device", () => {
  for (const value of ["learner@example.invalid", "123-45-6789", "(555) 010-0123",
    "access_token = fake-example", "strictly confidential", "4111 1111 1111 1111"]) {
    assert.ok(hasSensitiveText(value), value);
    assert.equal(route(asJob({ kind: "text", text: value })).mode, InferenceMode.ONLY_ON_DEVICE);
  }
  assert.equal(route(notes, { classifiedSensitive: true }).mode, InferenceMode.ONLY_ON_DEVICE);
  assert.equal(route(notes, { classifiedSensitive: true, sensitivityCheck: false }).mode, InferenceMode.PREFER_ON_DEVICE);
  assert.equal(route({ ...notes, sensitive: true }, { sensitivityCheck: false }).mode, InferenceMode.ONLY_ON_DEVICE);
  assert.throws(() => route({ ...notes, sensitive: true }, { nanoAvailable: false }), /sensitive content stays on-device/i);
});

test("runs compatible jobs locally while offline and queues cloud jobs", () => {
  assert.equal(route(notes, { online: false }).mode, InferenceMode.ONLY_ON_DEVICE);
  assert.equal(route(notes, { online: false, nanoAvailable: false }).mode, "queue");
  assert.equal(route(pdf, { online: false }).mode, "queue");
  assert.equal(route(longDoc, { online: false }).mode, "queue");
  assert.equal(route({ ...longDoc, sensitive: true }, { online: false }).mode, InferenceMode.ONLY_ON_DEVICE);
  assert.throws(() => route({ ...notes, sensitive: true }, { online: false, nanoAvailable: false }), /Nano is unavailable/i);
});
EOF
