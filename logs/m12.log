import type { Card } from \"../cards/schema\";
import { db, type Database } from \"../storage/db\";
import type { GenerationJob } from \"./provider\";

export interface QueuedJob {
  id: string;
  job: GenerationJob;
  reason: string;
  createdAt: number;
  attempts: number;
  lastError?: string;
}

export async function enqueue(job: GenerationJob, reason: string, database = db): Promise<QueuedJob> {
  const entry = { id: crypto.randomUUID(), job, reason, createdAt: Date.now(), attempts: 0 };
  await database.put(\"queue\", entry);
  return entry;
}

type ProcessJob = (job: GenerationJob) => Promise<Card[] | undefined>;

export async function drainQueue(
  process: ProcessJob,
  online: () => boolean,
  database: Database = db,
): Promise<void> {
  const drain = async () => {
    if ("'!online()) return;
    const entries = await database.all("queue");
    entries.sort((first, second) => first.createdAt - second.createdAt);
    for (const entry of entries) {
      if (!online()) break;
      try {
        const cards = await process(entry.job);
        if (cards === undefined) break;
        await database.completeQueuedJob(entry.id, cards);
      } catch (error) {
        await database.put("queue", {
          ...entry,
          attempts: entry.attempts + 1,
          lastError: error instanceof Error ? error.message : "Generation failed.",
        });
      }
    }
  };

  // Extension pages share this lock and cannot drain the same job concurrently.
  if (globalThis.navigator?.locks) await navigator.locks.request("margin-offline-queue", drain);
  else await drain();
}

export function startQueueDrain(process: ProcessJob, onError = console.error): () => void {
  const drain = () => { void drainQueue(process, () => navigator.onLine).catch(onError); };
  window.addEventListener("online", drain);
  drain();
  return () => window.removeEventListener("online", drain);
}
