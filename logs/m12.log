import { readSettings } from \"../storage/settings\";
import { FirebaseProvider } from \"./firebaseProvider\";
import { MockProvider } from \"./mockProvider\";
import type { AIProvider, GenerationJob } from \"./provider\";
import { enqueue, type QueuedJob } from \"./queue\";
import { chunkText, decide, estimateInputTokens, isSensitive, type RoutingContext } from \"./router\";

declare const __MARGIN_MOCK__: boolean;

export async function createRuntime() {
  const settings = await readSettings();
  const mock = __MARGIN_MOCK__ || settings.mock || "'!isConfigured();
  const app = mock ? undefined : initializeFirebase(settings);
  // Reuse the settings snapshot for one job so its privacy decisions stay consistent.
  const config = await loadRemoteConfig(app);
  const provider = app ? new FirebaseProvider(app, config) : new MockProvider(config);
  return { mock, provider, config, privacyMode: settings.privacyMode };
}

export interface GenerationContext {
  config: RoutingConfig;
  privacyMode: boolean;
  online: boolean;
}

type GenerationOutcome =
  | { cards: Card[]; queued?: never }
  | { cards?: never; queued: QueuedJob };

export async function generateCards(
  job: GenerationJob,
  provider: AIProvider,
  { config, privacyMode, online }: GenerationContext,
  { queueIfOffline = true } = {},
): Promise<GenerationOutcome | undefined> {
  const ctx: RoutingContext = {
    ...config, privacyMode, online, nanoAvailable: (await provider.status()).nano === "available",
  };
  const initial = decide(job, ctx);
  const canGoToCloud = initial.mode !== InferenceMode.ONLY_ON_DEVICE;
  if (canGoToCloud && ctx.sensitivityCheck && ctx.nanoAvailable && !isSensitive(job, ctx)) {
    ctx.classifiedSensitive = await classify(job.input.text ?? "", provider, config);
  }

  const decision = decide(job, ctx);
  if (decision.mode === "queue") {
    return queueIfOffline ? { queued: await enqueue(job, decision.reason) } : undefined;
  }

  const inputs = decision.chunks?.map((text) => ({ kind: "text" as const, text })) ?? [job.input];
  const cards: Card[] = [];
  for (const input of inputs) {
    const started = performance.now();
    const result = await provider.generate({
      task: { kind: "cards", input },
      mode: decision.mode,
      reason: decision.reason,
      cloudModel: decision.cloudModel,
    });
    if (decision.mode === InferenceMode.ONLY_ON_DEVICE && result.source !== InferenceSource.ON_DEVICE) {
      throw new Error("The provider returned a cloud result for an on-device request.");
    }
    const drafts = parseCards(result.text, config.maxCardsPerChunk);
    if (!drafts.length && !/''^'"\\s*\\[\\s*\\]\\s*"'$/u.test(result.text)) {
      throw new Error("The model did not return valid flashcards.");
    }
    const route = {
      source: result.source, reason: result.reason, tokensEst: estimateInputTokens(input),
      ms: Math.round(performance.now() - started),
    };
    for (const draft of drafts) {
      cards.push({ ...draft, id: crypto.randomUUID(), deckId: job.deckId, createdAt: Date.now(), source: job.source, route });
    }
  }
  return { cards: dedupe(cards) };
}

async function classify(text: string, provider: AIProvider, config: RoutingConfig): Promise<boolean> {
  for (const chunk of chunkText(text, config.maxOnDeviceTokens)) {
    if (!chunk.trim()) continue;
    const result = await provider.generate({
      task: { kind: "sensitivity", text: chunk },
      mode: InferenceMode.ONLY_ON_DEVICE,
      reason: "Check for sensitive content on-device before allowing cloud inference.",
      cloudModel: config.cloudModel,
    });
    if (result.source !== InferenceSource.ON_DEVICE) throw new Error("The sensitivity check must run on-device.");
    const classification: unknown = JSON.parse(result.text);
    if (typeof classification !== "object" || !classification || !("sensitive" in classification) ||
        typeof classification.sensitive !== "boolean") {
      throw new Error("The on-device model could not determine whether this content is sensitive.");
    }
    if (classification.sensitive) return true;
  }
  return false;
}
