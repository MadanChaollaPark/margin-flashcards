import { mkdtemp, rm } from \"node:fs/promises\";
import { tmpdir } from \"node:os\";
import { resolve } from \"node:path\";
import { chromium, expect, test } from \"@playwright/test\";

test(\"Margin registers its service worker and renders the side panel without errors\", async () => {
  const dist = resolve(\"dist\");
  const profile = await mkdtemp(resolve(tmpdir(), \"margin-playwright-\"));
  try {
    const context = await chromium.launchPersistentContext(profile, {
      channel: \"chromium\",
      headless: false,
      args: [\"--headless=new\", "'`--disable-extensions-except=${dist}`, `--load-extension=${dist}`],
    });
    try {
      const errors: string[] = [];
      context.on("console", (message) => {
        if (message.type() === "error") errors.push(message.text());
      });
      context.on("weberror", (error) => errors.push(error.error().message));

      const worker = context.serviceWorkers()[0] ?? await context.waitForEvent("serviceworker");
      const workerUrl = new URL(worker.url());
      expect(workerUrl.protocol).toBe("chrome-extension:");
      expect(workerUrl.pathname).toBe("/background.js");

      const panel = await context.newPage();
      await panel.goto(`chrome-extension://${workerUrl.host}/sidepanel.html`);
      await expect(panel.getByRole("heading", { name: "Margin", exact: true })).toBeVisible();
      await expect(panel.getByText("Demo mode", { exact: true })).toBeVisible();
      await expect(panel.getByRole("status")).toHaveText("Simulated Gemini Nano is ready.");

      await panel.goto(`chrome-extension://${workerUrl.host}/review.html`);
      await expect(panel.getByRole("status")).toHaveText("No flashcards yet.");
      await panel.goto(`chrome-extension://${workerUrl.host}/options.html`);
      await expect(panel.getByText("Demo mode", { exact: true })).toBeVisible();
      await panel.goto(`chrome-extension://${workerUrl.host}/popup.html`);
      await expect(panel.getByRole("button", { name: "Open side panel" })).toBeVisible();
      expect(errors).toEqual([]);
    } finally {
      await context.close();
    }
  } finally {
    await rm(profile, { recursive: true, force: true });
  }
});
EOF
