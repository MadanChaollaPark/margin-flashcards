cat > src/ui/sidepanel.ts <<'"'EOF'
import type { AIProvider } from \"../ai/provider\";
import { startQueueDrain } from \"../ai/queue\";
import { createRuntime, generateCards } from \"../ai/runtime\";

const banner = document.querySelector<HTMLElement>(\"#demo\")"'!;
const status = document.querySelector<HTMLElement>("#model-status")!;
const enable = document.querySelector<HTMLButtonElement>("#enable-model")!;

async function showStatus(provider: AIProvider, mock: boolean): Promise<void> {
  const { nano } = await provider.status();
  const labels = {
    available: mock ? "Simulated Gemini Nano is ready." : "Gemini Nano is ready.",
    downloadable: "Gemini Nano is available to download.",
    downloading: "Gemini Nano is downloading.",
    unavailable: "Gemini Nano is unavailable in this browser.",
  };
  status.textContent = labels[nano];
  enable.hidden = nano !== "downloadable" && nano !== "downloading";
}

async function start(): Promise<void> {
  const runtime = await createRuntime();
  banner.hidden = !runtime.mock;
  await showStatus(runtime.provider, runtime.mock);
  enable.addEventListener("click", async () => {
    enable.disabled = true;
    try {
      await runtime.provider.initializeDeviceModel((progress) => {
        status.textContent = `Downloading Gemini Nano… ${Math.round(progress * 100)}%`;
      });
      await showStatus(runtime.provider, runtime.mock);
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : "Gemini Nano could not be enabled.";
    } finally {
      enable.disabled = false;
    }
  });
  const stop = startQueueDrain(async (job) => {
    const current = await createRuntime();
    const result = await generateCards(
      job, current.provider, { ...current, online: navigator.onLine }, { queueIfOffline: false },
    );
    return result?.cards;
  });
  window.addEventListener("pagehide", stop, { once: true });
}

void start().catch(() => {
  status.textContent = "Margin could not load AI settings.";
});
EOF
