        result = { sensitive: hasSensitiveText(task.text) || /\b(?:private correspondence|confidential memo|medical record)\b/iu.test(task.text) };
        break;
    }
    return {
      text: JSON.stringify(result),
      source: cloud ? InferenceSource.IN_CLOUD : InferenceSource.ON_DEVICE,
      reason: `Simulated — ${reason}`,
      simulated: true,
    };
  }
}
import { InferenceMode, InferenceSource } from "firebase/ai";
import type { AIProvider } from "./provider";

export interface AnswerGrade {
  verdict: "correct" | "partial" | "incorrect";
  missing: string[];
  suggestedRating: 1 | 2 | 3 | 4;
}

export function parseGrade(text: string): AnswerGrade {
  const value = JSON.parse(text.trim().replace(/^```(?:json)?\s*|\s*```$/giu, "")) as Partial<AnswerGrade> | null;
  if (!value || !Array.isArray(value.missing) || !value.missing.every((point) => typeof point === "string")) {
    throw new Error("Answer feedback was incomplete.");
  }
  const { verdict, missing } = value;
  if (verdict === "incorrect") return { verdict, missing, suggestedRating: 1 };
  if (verdict === "partial") return { verdict, missing, suggestedRating: 2 };
  if (verdict === "correct") return { verdict, missing, suggestedRating: value.suggestedRating === 4 ? 4 : 3 };
  throw new Error("Answer feedback was incomplete.");
}

export async function checkAnswer(
  provider: AIProvider, cloudModel: string, question: string, expected: string, answer: string,
): Promise<AnswerGrade> {
  if ((await provider.status()).nano !== "available") {
    throw new Error("Enable on-device AI in the side panel to check typed answers. You can still reveal the answer and rate yourself.");
  }
  const result = await provider.generate({
    task: { kind: "grade", question, expected, answer },
    mode: InferenceMode.ONLY_ON_DEVICE,
    reason: "Typed answers are graded on-device.",
    cloudModel,
  });
  if (result.source !== InferenceSource.ON_DEVICE) throw new Error("On-device answer feedback is unavailable.");
  return parseGrade(result.text);
}
import { InferenceMode } from "firebase/ai";
import { MAX_INPUT_BUDGET, type RoutingConfig } from "../firebase/remoteConfig";
import type { ContentInput, GenerationJob, LocalAvailability } from "./provider";
import type { ModeOverride } from "../storage/settings";

export interface RoutingContext extends RoutingConfig {
  nano: LocalAvailability;
  online: boolean;
  privacyMode: boolean;
  modeOverride?: ModeOverride;
  classifiedSensitive?: boolean;
  confirmedCloud?: boolean;
}

type InferenceDecision = { mode: InferenceMode; reason: string; cloudModel: string; chunks?: string[] };
type Decision = InferenceDecision | { mode: "queue"; reason: string } | { mode: "confirm"; reason: string };

const CHARS_PER_TOKEN = 4;
const IMAGE_TOKEN_ALLOWANCE = 1_024;
const CJK = /[\p{sc=Han}\p{sc=Hiragana}\p{sc=Katakana}\p{sc=Hangul}\u3000-\u303f\uff00-\uffef]/u;

function characterCost(character: string): number {
  return CJK.test(character) || character.length > 1 ? CHARS_PER_TOKEN : 1;
}

export function estimateTokens(text: string): number {
  let cost = 0;
  for (const character of text) cost += characterCost(character);
  return Math.ceil(cost / CHARS_PER_TOKEN);
}

export function estimateInputTokens(input: ContentInput): number {
  return estimateTokens(input.text ?? "") + (input.kind === "image" ? IMAGE_TOKEN_ALLOWANCE : 0);
}

export function canRunOnDevice(input: ContentInput): boolean {
  return input.kind === "text" ||
    (input.kind === "image" && ["image/png", "image/jpeg"].includes(input.mimeType));
}

export function chunkText(text: string, budget: number): string[] {
  const limit = budget * CHARS_PER_TOKEN;
  if (!Number.isSafeInteger(limit) || limit < CHARS_PER_TOKEN) throw new RangeError("Invalid token budget.");
  const chunks: string[] = [];
  let start = 0;
  let end = 0;
  let boundary = 0;
  let boundaryCost = 0;
  let cost = 0;
  for (const character of text) {
    const nextCost = characterCost(character);
    if (cost + nextCost > limit) {
      const split = cost - boundaryCost + nextCost <= limit && boundaryCost >= limit / 2 ? boundary : end;
      chunks.push(text.slice(start, split));
      start = split;
      cost = split === boundary ? cost - boundaryCost : 0;
      boundaryCost = 0;
    }
    end += character.length;
    cost += nextCost;
    if (/\s/u.test(character)) {
      boundary = end;
      boundaryCost = cost;
    }
  }
  if (start < end) chunks.push(text.slice(start));
  return chunks;
}

const PRIVATE_PATTERNS = [
  /\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b/iu,
  /\b\d{3}-\d{2}-\d{4}\b/u,
  /(?<![\d-])(?:\+1[ .-]?)?(?:\(\d{3}\)[ .-]?|\b\d{3}[ .-])\d{3}[ .-]\d{4}(?![\d-])/u,
  /\b(?:password|api[ _-]?key|access[ _-]?token)\s*[:=]\s*\S+/iu,
  /\b(?:strictly confidential|internal use only|do not distribute)\b/iu,
];

function validCardNumber(candidate: string): boolean {
  const digits = candidate.replace(/\D/gu, "");
  if (digits.length < 13 || digits.length > 19 || /^0|^(\d)\1+$/u.test(digits)) return false;
  let sum = 0;
  for (let index = digits.length - 1; index >= 0; index--) {
    const digit = Number(digits[index]);
    const value = (digits.length - index) % 2 === 0 ? digit * 2 : digit;
    sum += value > 9 ? value - 9 : value;
  }
  return sum % 10 === 0;
}

export function hasSensitiveText(text: string): boolean {
  const withoutIsbn = text.replace(/\bISBN(?:-1[03])?\s*:?\s*(?:97[89](?:[ -]?\d){10}|(?:\d[ -]?){9}[\dX])(?!\d)/giu, "");
  if (PRIVATE_PATTERNS.some((pattern) => pattern.test(withoutIsbn))) return true;
  return [...withoutIsbn.matchAll(/\b\d(?:[ -]?\d){12,}(?!\w)/gu)].some(([candidate]) =>
    !/^97[89](?:[ -]?\d){10}$/u.test(candidate) && validCardNumber(candidate));
}

export function isSensitive(job: GenerationJob, ctx: RoutingContext): boolean {
  return job.sensitive === true || (ctx.sensitivityCheck && (
    ctx.classifiedSensitive === true || (!ctx.confirmedCloud && hasSensitiveText(job.input.text ?? ""))));
}

export function nanoHint(nano: LocalAvailability): string {
  if (nano === "downloadable") return "Gemini Nano is ready to download. Click Enable on-device AI.";
  if (nano === "downloading") return "Gemini Nano is downloading. Click Enable on-device AI to check progress.";
  return "Gemini Nano is unavailable in this browser or for this input.";
}

export function decide(job: GenerationJob, ctx: RoutingContext): Decision {
  const { input } = job;
  const available = ctx.nano === "available";
  const sensitive = isSensitive(job, ctx);
  const localOnly = ctx.privacyMode || ctx.modeOverride === "only-device";
  const supported = canRunOnDevice(input);
  const budget = Math.min(ctx.maxOnDeviceTokens, MAX_INPUT_BUDGET);
  const overBudget = estimateInputTokens(input) > budget;
  const needsCloud = input.kind === "pdf" ? "PDFs without enough extractable text require cloud inference."
    : input.kind === "youtube" ? "YouTube videos without accessible captions require cloud inference."
    : "This image format requires cloud inference.";
  const local = (reason: string): InferenceDecision => {
    const chunks = overBudget && input.kind === "text" ? chunkText(input.text, budget) : undefined;
    return {
      mode: InferenceMode.ONLY_ON_DEVICE, cloudModel: ctx.cloudModel, chunks,
      reason: chunks ? `${reason} Split into ${chunks.length} on-device chunks.` : reason,
    };
  };

  if (sensitive && !localOnly && !available && !job.sensitive && !ctx.classifiedSensitive) {
    return { mode: "confirm", reason: `This capture may contain sensitive information. ${nanoHint(ctx.nano)}` };
  }

  if (localOnly || sensitive) {
    const reason = ctx.privacyMode ? "Privacy mode keeps this content on-device."
      : sensitive ? "Sensitive content stays on-device." : "Your settings require on-device inference.";
    if (input.kind === "pdf") throw new Error(`${reason} Extract the PDF text and try again with the text.`);
    if (input.kind === "youtube") throw new Error(`${reason} Paste the video's transcript to generate cards from it.`);
    if (!supported) throw new Error(`${reason} Convert the image to PNG or JPEG and try again.`);
    if (!available) throw new Error(`${reason} ${nanoHint(ctx.nano)}`);
    if (overBudget && input.kind !== "text") throw new Error(`${reason} Remove some accompanying text or use a smaller image.`);
    return local(reason);
  }

  const onlyCloud = ctx.modeOverride === "only-cloud";
  if (!ctx.online) {
    if (!onlyCloud && available && supported && (!overBudget || input.kind === "text")) {
      return local("Offline. Gemini Nano can process this on-device.");
    }
    const why = onlyCloud ? "Your settings require cloud inference." : !supported ? needsCloud : overBudget
      ? "This input exceeds the on-device token budget." : nanoHint(ctx.nano);
    return { mode: "queue", reason: `Offline. ${why} Queued until a connection is available.` };
  }

  const cloudModel = input.kind === "pdf" || input.kind === "youtube" || overBudget ? ctx.longDocModel : ctx.cloudModel;
  const cloud = (reason: string): InferenceDecision => ({ mode: InferenceMode.ONLY_IN_CLOUD, reason, cloudModel });
  if (ctx.confirmedCloud && !available) return cloud("You approved cloud inference for this capture.");
  if (!supported) return cloud(needsCloud);
  if (onlyCloud) return cloud("Your settings require cloud inference.");
  if (overBudget) {
    if (ctx.modeOverride === "prefer-device" && available && input.kind === "text") {
      return local("Your settings prefer on-device inference.");
    }
    return cloud("This input exceeds the on-device token budget.");
  }
  if (!available) return cloud(`${nanoHint(ctx.nano)} Cloud inference is available.`);
  if (ctx.modeOverride === "prefer-cloud") {
    return { mode: InferenceMode.PREFER_IN_CLOUD, reason: "Your settings prefer cloud inference.", cloudModel };
  }
  return local("This input fits the on-device token budget. Gemini Nano keeps it on-device.");
}
import { InferenceMode, InferenceSource } from "firebase/ai";
import { dedupe } from "../cards/dedupe";
import { parseCardResponse } from "../cards/parse";
import type { Card } from "../cards/schema";
import { shouldUseMock } from "../firebase/config";
import { initializeFirebase } from "../firebase/init";
import { loadRemoteConfig, MAX_INPUT_BUDGET, type RoutingConfig } from "../firebase/remoteConfig";
import { readSettings, type ModeOverride } from "../storage/settings";
import { FirebaseProvider } from "./firebaseProvider";
import { MockProvider } from "./mockProvider";
import type { AIProvider, GenerationJob, InferenceRequest } from "./provider";
import { enqueue, type QueuedJob } from "./queue";
import { chunkText, decide, estimateInputTokens, isSensitive, type RoutingContext } from "./router";

export async function createRuntime() {
  const settings = await readSettings();
  const mock = shouldUseMock(settings.mock);
  const app = mock ? undefined : initializeFirebase(settings);
  // Reuse the settings snapshot for one job so its privacy decisions stay consistent.
  const config = await loadRemoteConfig(app);
  const provider = app ? new FirebaseProvider(app, config) : new MockProvider(config);
  return { mock, provider, config, privacyMode: settings.privacyMode, modeOverride: settings.modeOverride };
}

export interface GenerationContext {
  config: RoutingConfig;
  privacyMode: boolean;
  online: boolean;
  modeOverride?: ModeOverride;
}

type GenerationOutcome =
  | { cards: Card[]; queued?: never; confirm?: never }
  | { cards?: never; queued: QueuedJob; confirm?: never }
  | { cards?: never; queued?: never; confirm: string };

export async function generateCards(
  job: GenerationJob,
  provider: AIProvider,
  { config, privacyMode, online, modeOverride }: GenerationContext,
  { queueIfOffline = true, confirmCloud }: {
    queueIfOffline?: boolean;
    confirmCloud?: (reason: string) => Promise<boolean>;
  } = {},
): Promise<GenerationOutcome | undefined> {
  const ctx: RoutingContext = {
    ...config, privacyMode, online, modeOverride, nano: (await provider.status(job.input)).nano,
  };
  let decision = decide(job, ctx);
  if (decision.mode === "confirm") {
    if (!confirmCloud) return { confirm: decision.reason };
    if (!await confirmCloud(decision.reason)) return;
    ctx.confirmedCloud = true;
    decision = decide(job, ctx);
  }
  if (decision.mode !== "queue" && decision.mode !== "confirm" && decision.mode !== InferenceMode.ONLY_ON_DEVICE &&
      ctx.sensitivityCheck && !!job.input.text?.trim() && !ctx.confirmedCloud &&
      !isSensitive(job, ctx) && (await provider.status()).nano === "available") {
    ctx.classifiedSensitive = await classify(job.input.text ?? "", provider, config);
    decision = decide(job, ctx);
  }
  if (decision.mode === "confirm") return { confirm: decision.reason };
  if (decision.mode === "queue") {
    const reason = provider instanceof MockProvider ? `Simulated — ${decision.reason}` : decision.reason;
    return queueIfOffline ? { queued: await enqueue(job, reason) } : undefined;
  }

  const inputs = decision.chunks?.map((text) => ({ kind: "text" as const, text })) ?? [job.input];
  const cards: Card[] = [];
  for (const input of inputs) {
    const started = performance.now();
    const request: InferenceRequest = {
      task: { kind: "cards", input },
      mode: decision.mode,
      reason: decision.reason,
      cloudModel: decision.cloudModel,
    };
    const { drafts, result } = await cardResponse(provider, request, config.maxCardsPerChunk);
    const route = {
      source: result.source, reason: result.reason, tokensEst: estimateInputTokens(input),
      ms: Math.round(performance.now() - started),
      runId: crypto.randomUUID(),
      simulated: result.simulated ?? false,
      localBytes: result.source === InferenceSource.ON_DEVICE
        ? new TextEncoder().encode(input.text ?? "").length + (input.kind === "image" ? Math.floor(input.data.replace(/=+$/u, "").length * 3 / 4) : 0)
        : 0,
    };
    for (const draft of drafts) {
      cards.push({ ...draft, id: crypto.randomUUID(), deckId: job.deckId, createdAt: Date.now(), source: job.source, route });
    }
  }
  return { cards: dedupe(cards) };
}

async function cardResponse(provider: AIProvider, request: InferenceRequest, limit: number) {
  for (const repair of [false, true]) {
    const result = await provider.generate({ ...request, repair });
    if (request.mode === InferenceMode.ONLY_ON_DEVICE && result.source !== InferenceSource.ON_DEVICE) {
      throw new Error("The provider returned a cloud result for an on-device request.");
    }
    const drafts = parseCardResponse(result.text, limit);
    if (drafts) return { drafts, result };
  }
  throw new Error("The model did not return valid flashcards.");
}

async function classify(text: string, provider: AIProvider, config: RoutingConfig): Promise<boolean> {
  for (const chunk of chunkText(text, Math.min(config.maxOnDeviceTokens, MAX_INPUT_BUDGET))) {
    if (!chunk.trim()) continue;
    try {
      const result = await provider.generate({
        task: { kind: "sensitivity", text: chunk },
        mode: InferenceMode.ONLY_ON_DEVICE,
        reason: "Check for sensitive content on-device before allowing cloud inference.",
        cloudModel: config.cloudModel,
      });
      if (result.source !== InferenceSource.ON_DEVICE) return true;
      const json = result.text.match(/\{[\s\S]*\}/u)?.[0];
      if (!json || !/^\{\s*"sensitive"\s*:\s*false\s*,?\s*\}$/u.test(json)) return true;
    } catch {
      return true;
    }
  }
  return false;
}
