import type { GenerationJob } from "../ai/provider";
import { captureImage, readImage } from "./image";
import { extractPage } from "./page";
import { pdfInput } from "./pdf";
import type { CaptureRequest } from "./request";
import { readSelection, textFragmentUrl } from "./selection";
import { fetchTranscript, readCaptionTracks, youtubeVideoUrl } from "./youtube";

type RequestAccess = (origin: string, purpose: string) => Promise<boolean>;

async function obtainAccess(url: string, purpose: string, requestAccess: RequestAccess): Promise<boolean> {
  const parsed = new URL(url);
  if (!["http:", "https:"].includes(parsed.protocol)) return false;
  const origin = `${parsed.protocol}//${parsed.hostname}/*`;
  return !await chrome.permissions.contains({ origins: [origin] }) && await requestAccess(origin, purpose);
}

export async function captureSource(
  request: CaptureRequest, deckId: string, notes: string, image: File | undefined, requestAccess: RequestAccess,
): Promise<GenerationJob> {
  const { kind, tabId, frameId, selectionText } = request;
  if (kind === "paste") {
    if (!notes.trim()) throw new Error("Paste some notes to generate flashcards.");
    return { deckId, input: { kind: "text", text: notes.trim() }, source: { title: "Pasted notes" } };
  }
  if (kind === "image" && image) {
    return { deckId, input: await readImage(image), source: { title: image.name || "Pasted image" } };
  }

  const tab = tabId === undefined
    ? (await chrome.tabs.query({ active: true, currentWindow: true }))[0]
    : await chrome.tabs.get(tabId);
  if (tab?.id === undefined || !tab.url) throw new Error("Open the source tab and click Margin in the Chrome toolbar to give it access, then try again.");
  const source = { url: tab.url, title: tab.title };
  const captureUrl = request.frameUrl ?? tab.url;
  const target = { tabId: tab.id, ...(frameId !== undefined && { frameIds: [frameId] }) };
  async function withSiteAccess<T>(
    capture: () => Promise<T>, purpose: string, canRequest = (_error: unknown) => true,
  ): Promise<T> {
    try {
      return await capture();
    } catch (error) {
      if (!canRequest(error) || !await obtainAccess(captureUrl, purpose, requestAccess)) throw error;
      return capture();
    }
  }


  switch (kind) {
    case "selection": {
      const [result] = await chrome.scripting.executeScript({ target, func: readSelection }).catch((error: unknown) => {
        if (!selectionText) throw error;
        return [];
      });
      const text = selectionText || result?.result?.text;
      if (!text) throw new Error("Highlight text in the source tab, then generate again.");
      return {
        deckId, input: { kind: "text", text },
        source: { url: textFragmentUrl(result?.result?.url ?? request.frameUrl ?? tab.url, text), title: result?.result?.title || tab.title },
      };
    }
    case "page": {
      const [result] = await withSiteAccess(() => chrome.scripting.executeScript({ target, func: extractPage }), "read this page");
      if (!result?.result) throw new Error("This page has no readable text. Try selecting a passage or pasting notes.");
      const paragraph = result.result.split("\n").find((line) => line.length >= 32);
      if (paragraph) source.url = textFragmentUrl(request.frameUrl ?? tab.url, paragraph);
      return { deckId, source, input: { kind: "text", text: result.result } };
    }
    case "pdf":
      return { deckId, source, input: await withSiteAccess(() => pdfInput(captureUrl), "download this PDF", (error) => error instanceof TypeError) };
    case "youtube": {
      const url = youtubeVideoUrl(tab.url);
      if (!url) throw new Error("Open a YouTube video before generating from captions.");
      const [result] = await withSiteAccess(() => chrome.scripting.executeScript({ target, world: "MAIN", func: readCaptionTracks }), "read this video page");
      const text = await fetchTranscript(result?.result ?? []);
      return { deckId, source, input: text ? { kind: "text", text } : { kind: "youtube", url } };
    }
    case "image": {
      if (request.imageUrl && /^https?:/u.test(request.imageUrl)) {
        try {
          const response = await fetch(request.imageUrl, { credentials: "include" });
          if (response.ok) return { deckId, source, input: await readImage(await response.blob()) };
        } catch {
          // Capture the visible tab when the image resource is inaccessible.
        }
      }
      return { deckId, source, input: await captureImage(tab) };
    }
  }
}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Margin</title>
  <link rel="stylesheet" href="styles.css">
  <script type="module" src="sidepanel.js"></script>
</head>
<body class="panel">
  <main>
    <header>
      <div class="brand"><img src="icon.svg" alt=""><h1>Margin</h1></div>
      <nav aria-label="Margin pages"><a href="review.html" target="_blank">Review</a><a href="options.html" target="_blank">Options</a></nav>
    </header>
    <p id="demo-banner" class="demo-banner" hidden>DEMO MODE (simulated AI)</p>
    <div class="model-row" id="model-row">
      <span class="badge neutral" id="model-status" aria-live="polite">Checking AI…</span>
      <button class="secondary small" id="enable-model" type="button" hidden>Enable on-device AI</button>
      <progress id="model-progress" aria-label="Model download" max="1" hidden></progress>
    </div>

    <section id="welcome" class="surface stack welcome" aria-labelledby="welcome-heading" hidden>
      <h2 id="welcome-heading">Welcome to Margin</h2>
      <p>Turn what you read into flashcards and keep more of your study on this device.</p>
      <ol>
        <li><strong>Enable on-device AI</strong><p class="hint">Download Gemini Nano when Chrome offers it. <span id="welcome-model"></span></p></li>
        <li><strong>Try it on this page</strong><p class="hint">Generate cards from the current tab, then edit and save the ones you want to study.</p></li>
        <li><strong>Review</strong><p class="hint">Recall the answer and let Margin schedule your next review. <a href="review.html" target="_blank">Open review</a></p></li>
      </ol>
      <div class="actions">
        <button type="button" id="welcome-try">Try on this page</button>
        <button type="button" id="welcome-dismiss" class="quiet">Dismiss</button>
      </div>
    </section>

    <section id="capture-section" class="surface" aria-labelledby="capture-heading">
      <h2 id="capture-heading">Generate flashcards</h2>
      <form id="capture-form">
        <label for="source">Source</label>
        <select id="source">
          <option value="selection">Selection</option>
          <option value="page" selected>Page</option>
          <option value="pdf">PDF</option>
          <option value="youtube">YouTube</option>
          <option value="image">Image</option>
          <option value="paste">Paste</option>
        </select>
        <p class="hint" id="source-hint">Use the readable text on the current tab.</p>
        <div id="paste-fields" hidden>
          <label for="notes">Notes</label>
          <textarea id="notes" rows="3" placeholder="Paste or type your notes here"></textarea>
        </div>
        <div id="image-fields" hidden>
          <label for="image">Image file</label>
          <input id="image" type="file" accept="image/*">
          <div id="chosen-image" class="row" hidden>
            <p id="image-name" class="hint"></p>
            <button class="quiet small" id="clear-image" type="button">Clear image</button>
          </div>
        </div>
        <label for="deck">Save to deck</label>
        <div class="row">
          <select id="deck"></select>
          <button class="secondary" id="new-deck" type="button">New deck</button>
        </div>
        <button id="generate" type="submit">Generate</button>
      </form>
      <dialog id="deck-dialog">
        <form id="deck-form">
          <h2>New deck</h2>
          <label for="deck-name">Deck name</label>
          <input id="deck-name" required maxlength="80" autocomplete="off">
          <p class="hint error" id="deck-error" hidden></p>
          <div class="actions">
            <button id="cancel-deck" class="secondary" type="button">Cancel</button>
            <button type="submit">Create deck</button>
          </div>
        </form>
      </dialog>
    </section>

    <details class="surface routing" id="routing">
      <summary>AI routing explained</summary>
      <ul id="routing-rules"></ul>
    </details>
    <dialog id="host-dialog" aria-labelledby="host-heading">
      <form method="dialog">
        <h2 id="host-heading">Allow access to this site?</h2>
        <p class="hint"></p>
        <div class="actions">
          <button value="cancel" class="secondary" autofocus>Cancel</button>
          <button value="allow">Allow site access</button>
        </div>
      </form>
    </dialog>

    <p id="toast" class="toast" role="status" hidden></p>
    <section class="previews" aria-labelledby="preview-heading">
      <div class="row section-heading">
        <h2 id="preview-heading">Preview</h2>
        <button id="accept" type="button" hidden>Accept all</button>
      </div>
      <p class="empty" id="empty-preview">Generated cards appear here for editing before you save them.</p>
      <div id="cards" class="stack"></div>
    </section>
    <section id="queued" class="surface stack" aria-label="Offline queue" hidden></section>
    <dialog id="cloud-dialog" aria-labelledby="cloud-heading">
      <form method="dialog">
        <h2 id="cloud-heading">Send to cloud anyway?</h2>
        <p class="hint"></p>
        <div class="actions">
          <button value="cancel" class="secondary" autofocus>Cancel</button>
          <button value="allow">Send to cloud</button>
        </div>
      </form>
    </dialog>
  </main>
</body>
</html>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Review · Margin</title>
  <link rel="stylesheet" href="styles.css">
  <script type="module" src="review.js"></script>
</head>
<body>
  <main class="room">
    <header>
      <div class="brand"><img src="icon.svg" alt=""><h1>Review</h1></div>
      <nav aria-label="Margin pages"><a href="review.html" id="all-due" hidden>All due</a><a href="options.html">Options</a></nav>
    </header>
    <p id="demo-banner" class="demo-banner" hidden>DEMO MODE (simulated AI)</p>
    <div class="session-progress" id="session-progress" hidden>
      <p id="review-progress"></p>
      <progress id="progress" aria-label="Review progress"></progress>
    </div>
    <p id="review-status" class="empty" role="status">Loading your cards…</p>
    <p id="toast" class="toast" role="status" hidden></p>
    <section class="surface study-card" id="study" aria-labelledby="card-front" hidden>
      <h2 id="card-front"></h2>
      <a id="show-source" target="_blank" rel="noopener noreferrer" hidden>Show source</a>
      <form id="answer-form">
        <label for="answer">Your answer <span class="hint">(optional)</span></label>
        <input id="answer" maxlength="1500" autocomplete="off">
        <div class="actions">
          <button id="check" type="submit" disabled>Check</button>
          <button id="reveal" class="secondary" type="button">Reveal answer</button>
        </div>
      </form>
      <div id="revealed" hidden>
        <p id="card-back"></p>
        <div id="feedback" class="feedback" aria-live="polite" hidden></div>
        <div class="ratings" id="ratings" aria-label="Rate this card"></div>
      </div>
    </section>
    <p id="shortcuts" class="hint" hidden><kbd>Space</kbd> reveal <span>·</span> <kbd>Enter</kbd> check <span>·</span> <kbd>1</kbd>–<kbd>4</kbd> rate</p>
    <section id="summary" class="surface stack" hidden>
      <h2>Session complete</h2>
      <p id="summary-count"></p>
      <dl id="summary-ratings" class="stats"></dl>
      <a href="review.html">See all due cards</a>
    </section>
  </main>
</body>
</html>
:root {
  color-scheme: light dark;
  font: 100%/1.5 system-ui, sans-serif;
  --background: #f5f6f3;
  --surface: #fff;
  --control: #fbfcfa;
  --text: #252f2b;
  --muted: #596761;
  --line: #dce3de;
  --accent: #1e614b;
  --accent-hover: #154835;
  --accent-text: #fff;
  --device-bg: #e3f4e9;
  --device-text: #176143;
  --cloud-bg: #e7effe;
  --cloud-text: #284d94;
  --queue-bg: #fff1d4;
  --queue-text: #775013;
  --error-bg: #fbe9e5;
  --error-text: #9b3227;
  --shadow: 0 1px 2px #25362c0a, 0 4px 18px #25362c05;
  color: var(--text);
  background: var(--background);
}

@media (prefers-color-scheme: dark) {
  :root {
    --background: #171c1a;
    --surface: #212825;
    --control: #1c231f;
    --text: #edf3ef;
    --muted: #afbeb6;
    --line: #3d4841;
    --accent: #9adfc2;
    --accent-hover: #b7edd5;
    --accent-text: #142a1d;
    --device-bg: #233e32;
    --device-text: #a4e4c9;
    --cloud-bg: #263654;
    --cloud-text: #b9cfff;
    --queue-bg: #45391e;
    --queue-text: #f9d793;
    --error-bg: #412a27;
    --error-text: #ffc1b6;
    --shadow: none;
  }
}

*, *::before, *::after { box-sizing: border-box; }
[hidden] { display: none !important; }
body { margin: 0; }
body.popup { min-width: 325px; }
main { max-width: 45rem; margin: 0 auto; padding: 1.5rem; }
.panel main, .popup main { padding: 1rem; }
main.settings { max-width: 62rem; }
main.room { max-width: 47rem; }

header, .row, .actions, .brand, nav, .model-row {
  display: flex;
  align-items: center;
  gap: .65rem;
}
header { justify-content: space-between; margin-bottom: 1.25rem; }
nav, .actions, .model-row { flex-wrap: wrap; }
nav { gap: .9rem; font-size: .875rem; }
.brand { min-width: 0; }
.brand img { width: 2rem; height: 2rem; flex: none; }
h1, h2, h3, p { margin: 0; }
h1 { font-size: clamp(1.35rem, 6vw, 1.8rem); letter-spacing: -.035em; line-height: 1.2; overflow-wrap: anywhere; }
h2 { font-size: 1.08rem; line-height: 1.3; }
h3 { font-size: .95rem; overflow-wrap: anywhere; }
a { color: var(--accent); text-underline-offset: .2em; }
a:hover { text-decoration-thickness: .12em; }

.surface {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: .9rem;
  box-shadow: var(--shadow);
  padding: 1rem;
}
.stack { display: grid; gap: .75rem; align-content: start; }
.model-row { margin-bottom: .9rem; }
.model-row progress { flex: 1 0 100%; }
.section-heading { justify-content: space-between; min-height: 2.2rem; }
.previews { margin-top: 1.1rem; }
#cards, #queued, .popup .actions { margin-top: .65rem; }
.card { display: grid; gap: .6rem; }
.card-top { justify-content: space-between; align-items: start; }

form { display: grid; gap: .5rem; }
#capture-form { margin-top: .85rem; }
#generate { width: 100%; margin-top: .35rem; }
#chosen-image { justify-content: space-between; }
#image-name { overflow-wrap: anywhere; }
label { display: block; font-size: .875rem; font-weight: 650; }
label > input:not([type=checkbox]), label > textarea, label + select, label + input, label + textarea { margin-top: .2rem; }
form > label + select, form > label + input, form > label + textarea { margin-top: -.25rem; }
input, textarea, select {
  color: var(--text);
  background: var(--control);
  border: 1px solid var(--line);
  border-radius: .5rem;
  font: inherit;
  padding: .47rem .65rem;
  width: 100%;
  min-width: 0;
}
textarea { display: block; resize: vertical; }
input[type=file] { font-size: .825rem; }
input[type=checkbox] { width: 1rem; height: 1rem; accent-color: var(--accent); margin: 0; }
::placeholder { color: var(--muted); }
.toggle { display: flex; align-items: center; gap: .55rem; }

button, .button {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  background: var(--accent);
  border: 1px solid transparent;
  border-radius: .5rem;
  color: var(--accent-text);
  cursor: pointer;
  font: 650 .875rem/1.25 system-ui, sans-serif;
  padding: .55rem .8rem;
  min-height: 2.25rem;
  text-align: center;
  text-decoration: none;
}
button:hover, .button:hover { background: var(--accent-hover); }
button:disabled { cursor: default; opacity: .58; }
button.small { padding: .32rem .55rem; min-height: 1.8rem; font-size: .8rem; }
.row > button { flex-shrink: 0; }
.secondary, .quiet { color: var(--text); background: var(--control); border-color: var(--line); }
.quiet { border-color: transparent; background: transparent; color: var(--muted); }
.secondary:hover, .quiet:hover { background: var(--background); }
button.danger { color: var(--error-text); }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.study-card h2:focus { outline: none; }

.hint, .empty { color: var(--muted); font-weight: 400; }
.hint { font-size: .82rem; }
.empty { border: 1px dashed var(--line); border-radius: .65rem; padding: .8rem 1rem; margin-top: .6rem; }
.badge {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  border-radius: 99rem;
  font-size: .76rem;
  font-weight: 700;
  line-height: 1.3;
  padding: .28rem .56rem;
}
.neutral { background: var(--surface); border: 1px solid var(--line); color: var(--muted); }
.device { background: var(--device-bg); color: var(--device-text); }
.cloud { background: var(--cloud-bg); color: var(--cloud-text); }
.queued { background: var(--queue-bg); color: var(--queue-text); }
summary { cursor: pointer; }
.route summary::after { content: "▾"; margin-left: .38rem; }
.route[open] summary::after { content: "▴"; }
.route p { margin-top: .3rem; }
.toast { margin: .8rem 0; border-radius: .5rem; background: var(--device-bg); color: var(--device-text); padding: .6rem .75rem; font-size: .875rem; overflow-wrap: anywhere; }
.toast.error { background: var(--error-bg); color: var(--error-text); }
.hint.error { color: var(--error-text); }

dialog { max-width: min(24rem, calc(100% - 2rem)); width: 100%; background: var(--surface); color: var(--text); border: 1px solid var(--line); border-radius: .8rem; padding: 1rem; }
dialog::backdrop { background: #101c1699; }
dialog h2 { margin-bottom: .35rem; }
dialog .actions { justify-content: end; margin-top: .5rem; }

.settings-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; align-items: start; }
.definition-list, .stats { margin: 0; }
.definition-list > div { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; padding-top: .45rem; }
.definition-list dt, .stats dt { color: var(--muted); font-size: .8rem; }
.definition-list dd { margin: 0; font-size: .8rem; overflow-wrap: anywhere; }
.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr)); gap: .65rem; }
.stats > div { display: flex; flex-direction: column-reverse; align-items: start; justify-content: end; gap: .15rem; background: var(--control); border-radius: .55rem; padding: .55rem .65rem; }
.stats dd { margin: 0; font-size: 1.4rem; font-weight: 700; font-variant-numeric: tabular-nums; }
.deck-editor + .deck-editor, .queue-item + .queue-item { border-top: 1px solid var(--line); padding-top: .7rem; }
.plain-list { list-style: none; margin: 0; padding: 0; }
.plain-list li { justify-content: space-between; font-size: .9rem; padding: .3rem 0; border-bottom: 1px solid var(--line); }

progress { width: 100%; height: .55rem; accent-color: var(--accent); }
.session-progress { color: var(--muted); font-size: .875rem; margin-bottom: .8rem; }
.study-card { padding: clamp(1rem, 5vw, 2rem); }
.study-card h2 { font-size: clamp(1.25rem, 4vw, 1.9rem); white-space: pre-wrap; overflow-wrap: anywhere; }
.study-card #show-source { display: inline-block; margin-top: .55rem; font-size: .875rem; }
.study-card #answer-form, #revealed { margin-top: 1.25rem; }
#revealed { padding-top: .9rem; border-top: 1px solid var(--line); }
#card-back { white-space: pre-wrap; overflow-wrap: anywhere; }
.feedback { background: var(--device-bg); color: var(--device-text); margin-top: .85rem; padding: .7rem .85rem; border-radius: .6rem; }
.feedback p { margin-top: .25rem; }
.feedback ul { margin: .2rem 0 0; padding-left: 1.3rem; }
.ratings { display: grid; grid-template-columns: repeat(4, 1fr); gap: .45rem; margin-top: 1.25rem; }
.ratings button { display: grid; gap: .25rem; }
.ratings button span { font-weight: 500; }
#shortcuts { margin-top: .8rem; }
kbd { font: inherit; font-weight: 650; background: var(--surface); color: var(--text); padding: .1rem .28rem; border: 1px solid var(--line); border-radius: .25rem; }
.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
@media (max-width: 39rem) { .settings-grid { grid-template-columns: 1fr; } }
@media (max-width: 23rem) { main { padding: .75rem; } nav { gap: .5rem; } .ratings { grid-template-columns: repeat(2, 1fr); } }

.demo-banner {
  width: fit-content;
  margin: 0 0 .9rem;
  padding: .3rem .55rem;
  border-radius: .35rem;
  background: var(--queue-bg);
  color: var(--queue-text);
  font-size: .73rem;
  font-weight: 750;
  letter-spacing: .035em;
}
.welcome { margin-bottom: 1rem; }
