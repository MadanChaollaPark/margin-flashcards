:root {
  color-scheme: light dark;
  font: 100%/1.5 system-ui, sans-serif;
  --background: #f5f6f3;
  --surface: #fff;
  --control: #fbfcfa;
  --text: #252f2b;
  --muted: #596761;
  --line: #dce3de;
  --accent: #1e614b;
  --accent-hover: #154835;
  --accent-text: #fff;
  --device-bg: #e3f4e9;
  --device-text: #176143;
  --cloud-bg: #e7effe;
  --cloud-text: #284d94;
  --queue-bg: #fff1d4;
  --queue-text: #775013;
  --error-bg: #fbe9e5;
  --error-text: #9b3227;
  --shadow: 0 1px 2px #25362c0a, 0 4px 18px #25362c05;
  color: var(--text);
  background: var(--background);
}

@media (prefers-color-scheme: dark) {
  :root {
    --background: #171c1a;
    --surface: #212825;
    --control: #1c231f;
    --text: #edf3ef;
    --muted: #afbeb6;
    --line: #3d4841;
    --accent: #9adfc2;
    --accent-hover: #b7edd5;
    --accent-text: #142a1d;
    --device-bg: #233e32;
    --device-text: #a4e4c9;
    --cloud-bg: #263654;
    --cloud-text: #b9cfff;
    --queue-bg: #45391e;
    --queue-text: #f9d793;
    --error-bg: #412a27;
    --error-text: #ffc1b6;
    --shadow: none;
  }
}

