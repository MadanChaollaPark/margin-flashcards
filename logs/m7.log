import type { Card, Deck } from "../cards/schema";

export function fieldHtml(text: string): string {
  return text.replace(/&/gu, "&amp;").replace(/</gu, "&lt;").replace(/>/gu, "&gt;")
    .replace(/\r\n?|\n/gu, "<br>").replace(/\t/gu, "&#9;").replace(/\u001f/gu, "&#31;");
}

export function cardTags(tags: string[] = []): string[] {
  return [...new Set(tags.flatMap((tag) => tag.split(/\s+/u)).filter(Boolean))];
}

function tsvField(text: string): string {
  return /[\t\r\n"]|^#/u.test(text) ? `"${text.replace(/"/gu, '""')}"` : text;
}

export function buildTsv(cards: Card[], decks: Deck[]): string {
  const names = new Map(decks.map(({ id, name }) => [id, name]));
  const headers = [
    "#separator:tab", "#html:true", "#deck column:3", "#notetype column:4", "#tags column:5",
    "#columns:Front or Text\tBack or Extra\tDeck\tNote Type\tTags",
  ];
  const rows = cards.map((card) => [
    fieldHtml(card.front), fieldHtml(card.back), names.get(card.deckId) ?? "Default",
    card.type === "cloze" ? "Cloze" : "Basic", cardTags(card.tags).join(" "),
  ].map(tsvField).join("\t"));
  return [...headers, ...rows].join("\n") + "\n";
}
import type { CardDraft } from "./schema";

function normalize(front: string): string {
  return front.normalize("NFKC").toLowerCase().replace(/[^\p{L}\p{N}]+/gu, " ").trim();
}

function trigrams(value: string): Set<string> {
  const chars = Array.from(value);
  return new Set(chars.slice(2).map((_, index) => chars.slice(index, index + 3).join("")));
}

function similarity(first: Set<string>, second: Set<string>): number {
  if (!first.size || !second.size) return 0;
  let common = 0;
  for (const trigram of first) {
    if (second.has(trigram)) common++;
  }
  return common / (first.size + second.size - common);
}

export function dedupe<T extends CardDraft>(cards: readonly T[], existing: readonly CardDraft[] = []): T[] {
  const fronts = new Set<string>();
  const compared: { type: CardDraft["type"]; grams: Set<string> }[] = [];
  const accepted: T[] = [];
  for (const card of existing) {
    const front = normalize(card.front) || card.front.trim();
    fronts.add(`${card.type}:${front}`);
    compared.push({ type: card.type, grams: trigrams(front) });
  }
  for (const card of cards) {
    const front = normalize(card.front) || card.front.trim();
    const key = `${card.type}:${front}`;
    const grams = trigrams(front);
    if (fronts.has(key)) continue;
    if (compared.some((item) => item.type === card.type && similarity(item.grams, grams) >= 0.82)) continue;
    fronts.add(key);
    compared.push({ type: card.type, grams });
    accepted.push(card);
  }
  return accepted;
}
import { MAX_CARDS, validate, type CardDraft } from "./schema";

const MAX_RESPONSE_LENGTH = 256_000;

export function parseCards(response: string, maxCards = MAX_CARDS): CardDraft[] {
  return parseCardResponse(response, maxCards) ?? [];
}

// Recover complete card objects from a top-level array or a {"cards":[...]} wrapper.
// An empty array is a valid model response. Undefined means no response was recovered.
export function parseCardResponse(response: string, maxCards = MAX_CARDS): CardDraft[] | undefined {
  const limit = Math.min(MAX_CARDS, Math.floor(maxCards));
  if (limit < 1 || !Number.isFinite(limit)) return [];

  const input = response.slice(0, MAX_RESPONSE_LENGTH);
  const fenced = input.match(/```(?:json)?\s*([\s\S]*?)(?:```|$)/iu);
  const text = (fenced?.[1] ?? input).trimStart();
  const wrapper = text.match(/"cards"\s*:\s*\[/u);
  const start = text.startsWith("[") ? 0
    : wrapper ? (wrapper.index ?? 0) + wrapper[0].length - 1
    : text.search(/\[\s*(?:\{|\]|$)/u);
  if (start === -1) return;
  if (/^\[\s*\]/u.test(text.slice(start))) return [];

  const stack = ["["];
  const cards: CardDraft[] = [];
  let quoted = false;
  let escaped = false;
  let objectStart = -1;
  for (let index = start + 1; index < text.length && cards.length < limit; index++) {
    const char = text[index];
    if (quoted) {
      if (escaped) escaped = false;
      else if (char === "\\") escaped = true;
      else if (char === '"') quoted = false;
      continue;
    }
    if (char === '"') {
      quoted = true;
    } else if (char === "{" || char === "[") {
      if (char === "{" && stack.length === 1) objectStart = index;
      stack.push(char);
    } else if (char === "}" || char === "]") {
      if (stack.pop() !== (char === "}" ? "{" : "[")) break;
      if (stack.length === 0) break;
      if (stack.length === 1 && objectStart !== -1) {
        const candidate = text.slice(objectStart, index + 1);
        // Match complete quoted strings before removing trailing commas.
        const repaired = candidate.replace(/"(?:[^"\\]|\\[\s\S])*"|,(?=\s*[}\]])/gu, (match) =>
          match === "," ? "" : match,
        );
        try {
          const card = validate(JSON.parse(repaired));
          if (card) cards.push(card);
        } catch {
          // A malformed object does not invalidate the rest of the array.
        }
        objectStart = -1;
      }
    }
  }
  return cards.length ? cards : undefined;
}
