let runtime: Awaited<ReturnType<typeof createRuntime>> | undefined;
let downloading = false;
let retryQueue: (() => void) | undefined;

async function refreshStatus() {
  if (downloading) return;
  const current = await createRuntime();
  if (downloading) return;
  runtime = current;
  const { nano } = await current.provider.status();
  if (downloading) return;
  const labels = { available: "On-device ready", downloadable: "Available to download", downloading: "Downloading…", unavailable: "Unavailable" };
  showDemoBanner(current.mock);
  element("model-row").hidden = current.mock;
  status.textContent = labels[nano];
  element("welcome-model").textContent = current.mock ? "This build simulates the model." : labels[nano];
  const { config } = current;
  const rules = [
    "Privacy mode and sensitive content stay on-device. A pattern match with Nano unavailable asks before using the cloud, unless on-device use is required.",
    `With Nano ready, inputs within ${config.maxOnDeviceTokens.toLocaleString()} estimated tokens run on-device in Auto mode. Nano reserves ${NANO_OUTPUT_RESERVE.toLocaleString()} tokens for output.`,
    `Long text uses ${config.longDocModel} or splits into local chunks when offline, private, or set to prefer on-device.`,
    `Cloud requests use ${config.cloudModel} by default. Scanned PDFs and videos without captions use the long-document model.`,
    `Sensitivity check is ${config.sensitivityCheck ? "on" : "off"}. The local check runs before eligible text goes to cloud. Margin generates up to ${config.maxCardsPerChunk} cards per chunk.`,
    "Cloud jobs queue while offline. Margin checks the current routing rules again when it retries.",
  ];
  element("routing-rules").replaceChildren(...rules.map((rule) => {
    const item = document.createElement("li");
    item.textContent = rule;
    return item;
  }));
  status.className = `badge ${nano === "available" ? "device" : "neutral"}`;
  enable.hidden = current.mock || (nano !== "downloadable" && nano !== "downloading");
}

enable.addEventListener("click", async () => {
  if (!runtime || downloading) return;
  downloading = true;
  enable.disabled = true;
  progress.hidden = false;
  progress.removeAttribute("value");
  status.textContent = "Downloading…";
  try {
    await runtime.provider.initializeDeviceModel((value) => {
      progress.value = value;
      status.textContent = `Downloading ${Math.round(value * 100)}%`;
    });
  } catch (error) {
    notify(message(error, "On-device AI could not be enabled."), true);
  } finally {
    downloading = false;
    enable.disabled = false;
    progress.hidden = true;
    void refreshStatus().catch(reportError);
  }
});

