import assert from \"node:assert/strict\";
import { mkdtemp, rm } from \"node:fs/promises\";
import { tmpdir } from \"node:os\";
import { resolve } from \"node:path\";
import { chromium } from \"@playwright/test\";
const profile = await mkdtemp(resolve(tmpdir(), \"margin-reload-smoke-\"));
try {
  const context = await chromium.launchPersistentContext(profile, {
    channel: \"chromium\", headless: false,
    ignoreDefaultArgs: [\"--disable-extensions\"],
    args: [\"--headless=new\", \"--enable-unsafe-extension-debugging\"],
  });
  try {
    const admin = await context.newPage();
    await admin.goto(\"chrome://extensions\");
    await admin.evaluate(() => new Promise((resolve) => chrome.developerPrivate.updateProfileConfiguration({inDeveloperMode: true}, resolve)));
    const cdp = await context.browser().newBrowserCDPSession();
    const firstWorker = context.waitForEvent(\"serviceworker\", { timeout: 5000 });
    const { id } = await cdp.send(\"Extensions.loadUnpacked\", { path: resolve(\"dist\") });
    const worker = await firstWorker;
    await worker.evaluate(() => { globalThis.marginSmokeSentinel = true; });
    const optionsUrl = "'`chrome-extension://${id}/options.html`;
    const options = await context.newPage();
    await options.goto(optionsUrl);
    const closed = options.waitForEvent("close", { timeout: 5000 });
    const newWorker = context.waitForEvent("serviceworker", { timeout: 5000 });
    await options.evaluate(() => {
      setTimeout(() => { void chrome.storage.local.set({ appCheckDebugToken: "reload-smoke-test" }); }, 50);
    });
    const [replacement] = await Promise.all([newWorker, closed]);
    const state = await replacement.evaluate(async () => ({
      sentinel: globalThis.marginSmokeSentinel,
      ...(await chrome.storage.local.get("appCheckDebugToken")),
    }));
    assert.deepEqual(state, { sentinel: undefined, appCheckDebugToken: "reload-smoke-test" });
    const reopened = await context.newPage();
    await reopened.goto(optionsUrl);
    const result = await reopened.evaluate(() => chrome.runtime.sendMessage({ type: "margin.backup" }));
    assert.match(result.error, /connect a firebase project/iu);
    console.log("Token change reloaded Margin. The fresh worker read the saved token and handled a backup message.");
  } finally {
    await context.close();
  }
} finally {
  await rm(profile, { recursive: true, force: true });
}
