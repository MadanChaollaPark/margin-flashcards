import {
  getAI, getGenerativeModel, GoogleAIBackend, InferenceMode, InferenceSource,
  type AI, type LanguageModelCreateOptions, type LanguageModelExpected, type Part,
} from "firebase/ai";
import type { FirebaseApp } from "firebase/app";
import { MAX_INPUT_BUDGET, NANO_CONTEXT_TOKENS, NANO_OUTPUT_RESERVE, type RoutingConfig } from "../firebase/remoteConfig";
import { createPrompt, firebaseSchema } from "./prompts";
import { canRunOnDevice, estimateInputTokens, estimateTokens, nanoHint } from "./router";
import { routeReason, type AIProvider, type ContentInput, type InferenceRequest, type InferenceResult, type LocalAvailability } from "./provider";

type PromptAPI = {
  availability(options?: LanguageModelCreateOptions): Promise<LocalAvailability>;
};

const text: LanguageModelExpected = { type: "text", languages: ["en", "es", "ja"] };
const textOptions: LanguageModelCreateOptions = {
  expectedInputs: [text],
  expectedOutputs: [text],
};
const imageOptions: LanguageModelCreateOptions = {
  ...textOptions,
  expectedInputs: [text, { type: "image" }],
};

export function browserModel(): PromptAPI | undefined {
  return (globalThis as typeof globalThis & { LanguageModel?: PromptAPI }).LanguageModel;
}

export class FirebaseProvider implements AIProvider {
  private readonly ai: AI;

  constructor(app: FirebaseApp, private readonly config: RoutingConfig) {
    this.ai = getAI(app, { backend: new GoogleAIBackend(), useLimitedUseAppCheckTokens: true });
  }

  async status(input?: ContentInput): Promise<{ nano: LocalAvailability }> {
    try {
      return { nano: await browserModel()?.availability(input?.kind === "image" ? imageOptions : textOptions) ?? "unavailable" };
    } catch {
      return { nano: "unavailable" };
    }
  }

  // Call directly from the extension page's model enable button.
  async initializeDeviceModel(onProgress?: (progress: number) => void): Promise<void> {
    if (!browserModel()) throw new Error("Gemini Nano is unavailable in this browser.");
    const model = getGenerativeModel(this.ai, {
      mode: InferenceMode.ONLY_ON_DEVICE,
      inCloudParams: { model: this.config.cloudModel },
      onDeviceParams: { createOptions: textOptions },
    });
    await model.initializeDeviceModel(onProgress);
  }

  async generate({ task, mode, cloudModel, reason, repair }: InferenceRequest): Promise<InferenceResult> {
    const { prompt, schema } = createPrompt(task, this.config.maxCardsPerChunk, repair);
    const input = task.kind === "cards" ? task.input : undefined;
    const supported = !input || canRunOnDevice(input);
    const inputTokens = input ? estimateInputTokens(input)
      : estimateTokens(task.kind === "sensitivity" ? task.text : prompt);
    const extraMediaTokens = input ? inputTokens - estimateTokens(input.text ?? "") : 0;
    const fits = inputTokens <= Math.min(this.config.maxOnDeviceTokens, MAX_INPUT_BUDGET) &&
      estimateTokens(prompt) + estimateTokens(JSON.stringify(schema)) + extraMediaTokens <= NANO_CONTEXT_TOKENS - NANO_OUTPUT_RESERVE;

    if (mode === InferenceMode.ONLY_ON_DEVICE) {
      if (!supported || !fits) throw new Error("This request exceeds Gemini Nano's supported formats or token budget.");
      // Without a document-side adapter the SDK can dispatch directly to cloud.
      const { nano } = await this.status(input);
      if (nano !== "available" || typeof window === "undefined") {
        throw new Error(nanoHint(nano));
      }
    }

    const effectiveMode = mode === InferenceMode.PREFER_ON_DEVICE && (!supported || !fits)
      ? InferenceMode.ONLY_IN_CLOUD : mode;
    const model = getGenerativeModel(this.ai, {
      mode: effectiveMode,
      onDeviceParams: {
        createOptions: input?.kind === "image" ? imageOptions : textOptions,
        promptOptions: { responseConstraint: schema },
      },
      inCloudParams: {
        model: effectiveMode === mode ? cloudModel : this.config.longDocModel,
        generationConfig: { responseMimeType: "application/json", responseSchema: firebaseSchema(schema) },
      },
    });
    const parts: Part[] = [{ type: "text", text: prompt }];
    if (input?.kind === "youtube") {
      parts.push({ type: "fileData", fileData: { mimeType: "video/mp4", fileUri: input.url } });
    } else if (input && input.kind !== "text") {
      parts.push({ type: "inlineData", inlineData: { mimeType: input.mimeType, data: input.data } });
    }
    const { response } = await model.generateContent({ contents: [{ role: "user", parts }] });
    const source = response.inferenceSource ??
      (effectiveMode === InferenceMode.ONLY_IN_CLOUD ? InferenceSource.IN_CLOUD : undefined);
    if (source !== InferenceSource.ON_DEVICE && source !== InferenceSource.IN_CLOUD) {
      throw new Error("Firebase did not report where inference ran.");
    }
    if (effectiveMode === InferenceMode.ONLY_ON_DEVICE && source !== InferenceSource.ON_DEVICE) {
      throw new Error("Firebase reported an unexpected inference source for a local request.");
    }
    const actualReason = effectiveMode !== mode
      ? "The request exceeds the on-device format or token limits. Used cloud inference."
      : routeReason(mode, source, reason);
    return { text: response.text(), source, reason: actualReason };
  }
}
import { indexedDBLocalPersistence, initializeAuth, signInAnonymously } from "firebase/auth";
import { collection, doc, getDocs, getFirestore, writeBatch } from "firebase/firestore/lite";
import { validate, type Card, type Deck } from "../cards/schema";
import type { Schedule } from "../srs/fsrs";
import { db } from "../storage/db";
import { readSettings } from "../storage/settings";
import { shouldUseMock } from "./config";
import { initializeFirebase } from "./init";

type ScheduleDoc = Omit<Schedule, "due" | "last_review"> & { due: number; last_review?: number };
type CardDoc = Pick<Card, "type" | "front" | "back" | "tags" | "deckId" | "createdAt"> & {
  schedule?: ScheduleDoc;
};
type BackupAction = "write" | "restore";

export function cardToDoc(card: Card): CardDoc {
  const { type, front, back, tags, deckId, createdAt, schedule } = card;
  const data: CardDoc = { type, front, back, deckId, createdAt, ...(tags && { tags: [...tags] }) };
  if (schedule) {
    const { due, last_review, stability, difficulty, scheduled_days, learning_steps, reps, lapses, state } = schedule;
    data.schedule = {
      due: due.getTime(), stability, difficulty, scheduled_days, learning_steps, reps, lapses, state,
      ...(last_review && { last_review: last_review.getTime() }),
    };
  }
  return data;
}

export function docToCard(id: string, data: CardDoc): Card {
  const draft = validate(data);
  if (!draft || typeof data.deckId !== "string" || !data.deckId || !Number.isFinite(data.createdAt)) {
    throw new Error("A backed-up card has invalid data.");
  }
  const card: Card = { ...draft, id, deckId: data.deckId, createdAt: data.createdAt };
  if (data.schedule !== undefined) {
    const { due, last_review, stability, difficulty, scheduled_days, learning_steps, reps, lapses, state } = data.schedule;
    if (![due, stability, difficulty, scheduled_days, learning_steps, reps, lapses].every(Number.isFinite) ||
        ![0, 1, 2, 3].includes(state) || (last_review !== undefined && !Number.isFinite(last_review))) {
      throw new Error("A backed-up card has an invalid review schedule.");
    }
    card.schedule = {
      due: new Date(due), last_review: last_review === undefined ? undefined : new Date(last_review),
      stability, difficulty, scheduled_days, learning_steps, reps, lapses, state,
    };
  }
  return card;
}

async function requireBackup() {
  const settings = await readSettings();
  if (settings.privacyMode) throw new Error("Firestore backup is unavailable in Privacy mode.");
  if (shouldUseMock(settings.mock)) throw new Error("Connect a Firebase project and use Live mode to back up decks.");
  if (!settings.firestoreBackup) throw new Error("Turn on Firestore backup to continue.");
  return settings;
}

export async function syncBackup(action: BackupAction, automatic = false) {
  // Skip automatic jobs before touching Firebase when the backup is disabled.
  if (automatic) {
    const settings = await readSettings();
    if (settings.privacyMode || shouldUseMock(settings.mock) || !settings.firestoreBackup) return;
  } else {
    await requireBackup();
  }
  return navigator.locks.request("margin-firestore-backup", async () => {
    const app = initializeFirebase(await requireBackup());
    const auth = initializeAuth(app, { persistence: indexedDBLocalPersistence });
    await auth.authStateReady();
    await requireBackup();
    const { uid } = auth.currentUser ?? (await signInAnonymously(auth)).user;
    const firestore = getFirestore(app);
    const cardsRef = collection(firestore, "users", uid, "cards");
    const decksRef = collection(firestore, "users", uid, "decks");

    if (action === "restore") {
      await requireBackup();
      const [decks, cards] = await Promise.all([getDocs(decksRef), getDocs(cardsRef)]);
      const localDecks = decks.docs.map((deck): Deck => {
        const { name, createdAt } = deck.data();
        if (typeof name !== "string" || !name.trim() || !Number.isFinite(createdAt)) {
          throw new Error("A backed-up deck has invalid data.");
        }
        return { id: deck.id, name, createdAt };
      });
      const localCards = cards.docs.map((card) => docToCard(card.id, card.data() as CardDoc));
      await requireBackup();
      return db.restoreLibrary(localDecks, localCards);
    }

    const [decks, cards] = await Promise.all([db.all("decks"), db.all("cards")]);
    const writes = [
      ...decks.map(({ id, name, createdAt }) => ({ ref: doc(decksRef, id), data: { name, createdAt } })),
      ...cards.map((card) => ({ ref: doc(cardsRef, card.id), data: cardToDoc(card) })),
    ];
    for (let i = 0; i < writes.length; i += 500) {
      const batch = writeBatch(firestore);
      for (const { ref, data } of writes.slice(i, i + 500)) batch.set(ref, data);
      await requireBackup();
      await batch.commit();
    }
    return { decks: decks.length, cards: cards.length };
  });
}
import { getApps, initializeApp, type FirebaseApp } from "firebase/app";
import { CustomProvider, initializeAppCheck, type AppCheck } from "firebase/app-check";
import type { Settings } from "../storage/settings";
import { firebaseConfig, isConfigured } from "./config";

let initialized: { firebase: FirebaseApp; appCheck: AppCheck } | undefined;

export function initializeFirebase(settings: Pick<Settings, "appCheckDebugToken">): FirebaseApp {
  return initializeFirebaseAppCheck(settings).firebase;
}

export function initializeFirebaseAppCheck(settings: Pick<Settings, "appCheckDebugToken">) {
  if (!isConfigured()) throw new Error("Add firebase.config.local.json and rebuild Margin before enabling Firebase.");

  if (!initialized) {
    const scope = self as typeof self & { FIREBASE_APPCHECK_DEBUG_TOKEN?: boolean | string };
    scope.FIREBASE_APPCHECK_DEBUG_TOKEN = settings.appCheckDebugToken || true;

    const app = getApps().find(({ name }) => name === "margin") ?? initializeApp(firebaseConfig, "margin");
    const appCheck = initializeAppCheck(app, {
      // App Check bypasses this provider when a debug token is enabled.
      // A production extension needs its own token issuer for CustomProvider.
      provider: new CustomProvider({
        getToken: async () => { throw new Error("Configure an App Check token issuer for production."); },
      }),
      isTokenAutoRefreshEnabled: true,
    });
    console.info("Firebase App Check: register the debug token logged here in Firebase console > App Check > Manage debug tokens.");
    initialized = { firebase: app, appCheck };
  }
  return initialized;
}
import { PENDING_CAPTURE_PREFIX, type CaptureRequest } from "./sources/request";
import { syncBackup } from "./firebase/sync";

chrome.runtime.onMessage.addListener((request, _sender, respond) => {
  const automatic = request?.type === "margin.backupChanged";
  if (!automatic && request?.type !== "margin.backup" && request?.type !== "margin.restoreBackup") return;
  void syncBackup(request.type === "margin.restoreBackup" ? "restore" : "write", automatic)
    .then((result) => respond({ result }))
    .catch((error: unknown) => {
      if (automatic) console.warn("Margin could not update the Firestore backup.", error);
      respond({ error: error instanceof Error ? error.message : "Firestore backup failed." });
    });
  return true;
});

const menus = [
  { id: "margin-selection", title: "Make flashcards from selection", contexts: ["selection"] },
  { id: "margin-page", title: "Make flashcards from this page", contexts: ["page"] },
  { id: "margin-image", title: "Make flashcards from image", contexts: ["image"] },
] satisfies chrome.contextMenus.CreateProperties[];

chrome.runtime.onInstalled.addListener(() => {
  chrome.contextMenus.removeAll(() => {
    for (const menu of menus) chrome.contextMenus.create(menu);
  });
});

chrome.contextMenus.onClicked.addListener((info, tab) => {
  if (tab?.id === undefined || !menus.some(({ id }) => id === info.menuItemId)) return;
  const kind = String(info.menuItemId).slice("margin-".length) as CaptureRequest["kind"];
  const request: CaptureRequest = {
    kind, tabId: tab.id, frameId: info.frameId, frameUrl: info.frameUrl,
    selectionText: info.selectionText, imageUrl: info.srcUrl,
  };
  const key = `${PENDING_CAPTURE_PREFIX}${tab.windowId}.${Date.now()}.${crypto.randomUUID()}`;
  const open = chrome.sidePanel.open({ windowId: tab.windowId });
  const store = chrome.storage.session.set({ [key]: request });
  void Promise.all([open, store])
    .then(() => chrome.runtime.sendMessage({ type: "margin.capture", windowId: tab.windowId }).catch(() => {}))
    .catch((error: unknown) => console.error("Margin could not open the side panel.", error));
});
import { InferenceMode } from "firebase/ai";
import { getToken } from "firebase/app-check";
import { browserModel, FirebaseProvider } from "../ai/firebaseProvider";
import { isConfigured, shouldUseMock } from "../firebase/config";
import { initializeFirebaseAppCheck } from "../firebase/init";
import { loadRemoteConfig, loadRemoteConfigStatus, type RoutingConfig } from "../firebase/remoteConfig";
import { readSettings, type Settings } from "../storage/settings";
import { element, fillRoutingRules, message } from "./shared";

const liveTest = element<HTMLButtonElement>("run-live-test");
const liveResult = element("live-test-result");
const demoHint = "Connect a Firebase project to run a live test";
let revision = 0;
let running = false;
let demoMode = true;

function setStatus(key: string, label: string, state: "good" | "warning" | "error" | "skip") {
  const value = element(`diagnostic-${key}`);
  value.textContent = label;
  value.dataset.state = state;
}

async function withTimeout<T>(operation: Promise<T>, milliseconds: number): Promise<T> {
  let timer: ReturnType<typeof setTimeout> | undefined;
  try {
    const timeout = new Promise<never>((_, reject) => {
      timer = setTimeout(() => reject(new Error("The check timed out.")), milliseconds);
    });
    return await Promise.race([operation, timeout]);
  } finally {
    clearTimeout(timer);
  }
}

function showRoutingConfig(config: RoutingConfig) {
  fillRoutingRules(config);
  const labels = {
    maxOnDeviceTokens: "On-device token limit",
    cloudModel: "Cloud model",
    longDocModel: "Long-document model",
    sensitivityCheck: "Sensitivity check",
    maxCardsPerChunk: "Cards per chunk",
  };
  element("remote-config").replaceChildren(...Object.entries(config).map(([key, value]) => {
    const row = document.createElement("div");
    const term = document.createElement("dt");
    term.textContent = labels[key as keyof typeof labels];
    const description = document.createElement("dd");
    description.textContent = typeof value === "boolean" ? (value ? "On" : "Off") : String(value);
    row.append(term, description);
    return row;
  }));
}

export async function refreshDiagnostics(settings: Settings) {
  const current = ++revision;
  demoMode = shouldUseMock(settings.mock);
  liveTest.disabled = demoMode || running;
  liveResult.textContent = "";
  element("live-test-hint").textContent = demoMode
    ? isConfigured() ? `${demoHint}. Turn off Demo mode on this configured build.` : demoHint
    : "Uses a built-in prompt that can fall back to cloud.";

  const version = /\b(?:Headless)?Chrome\/(\d+(?:\.\d+)*)/u.exec(navigator.userAgent)?.[1];
  const supported = version !== undefined && Number(version.split(".")[0]) >= 139;
  setStatus("chrome", version ? `${version} · ${supported ? "139+" : "requires 139+"}` : "Chrome 139+ required",
    supported ? "good" : "warning");
  const model = browserModel();
  const hasPrompt = typeof model !== "undefined";
  setStatus("prompt", hasPrompt ? "Present" : "Unavailable", hasPrompt ? "good" : "warning");
  setStatus("firebase", isConfigured() ? "Present" : "Missing", isConfigured() ? "good" : "warning");
  setStatus("mode", demoMode ? "Demo" : "Live", demoMode ? "skip" : "good");
  setStatus("nano", model ? "Checking…" : "Unavailable", model ? "skip" : "warning");
  setStatus("app-check", demoMode ? "Skipped in Demo mode" : "Checking…", "skip");
  setStatus("remote-config", demoMode ? "Defaults" : "Checking…", "skip");

  const checkNano = async () => {
    if (!model) return;
    try {
      const availability = await withTimeout(model.availability(), 3_000);
      if (current === revision) setStatus("nano", availability, availability === "available" ? "good" : "warning");
    } catch {
      if (current === revision) setStatus("nano", "Check failed", "error");
    }
  };
  const nano = checkNano();
  let initialized: ReturnType<typeof initializeFirebaseAppCheck> | undefined;
  if (!demoMode) {
    try {
      // Start the token check independently of the Remote Config fetch.
      initialized = initializeFirebaseAppCheck(settings);
    } catch {
      setStatus("app-check", "Unavailable · debug token needs registering", "error");
    }
  }

  await Promise.all([
    nano,
    initialized && withTimeout(getToken(initialized.appCheck), 5_000).then(
      () => { if (current === revision) setStatus("app-check", "Obtainable", "good"); },
      () => { if (current === revision) setStatus("app-check", "Unavailable · debug token needs registering", "error"); },
    ),
    loadRemoteConfigStatus(initialized?.firebase).then(({ config, fetched }) => {
      if (current !== revision) return;
      setStatus("remote-config", fetched ? "Fetched" : "Defaults", fetched ? "good" : "skip");
      showRoutingConfig(config);
    }),
  ]);
}

liveTest.addEventListener("click", async () => {
  if (running || demoMode) return;
  running = liveTest.disabled = true;
  const current = revision;
  liveResult.textContent = "Running…";
  try {
    const settings = await readSettings();
    if (shouldUseMock(settings.mock)) throw new Error(demoHint);
    const app = initializeFirebaseAppCheck(settings).firebase;
    const config = await loadRemoteConfig(app);
    if (current !== revision) return;
    const provider = new FirebaseProvider(app, config);
    const started = performance.now();
    const { source } = await withTimeout(provider.generate({
      task: { kind: "sensitivity", text: "The sky is blue." },
      mode: InferenceMode.PREFER_ON_DEVICE,
      cloudModel: config.cloudModel,
      reason: "Live hybrid test",
    }), 30_000);
    if (current === revision) liveResult.textContent = `inferenceSource: ${source} · ${Math.round(performance.now() - started)} ms`;
  } catch (error) {
    if (current === revision) liveResult.textContent = message(error, "Live hybrid test failed.");
  } finally {
    running = false;
    liveTest.disabled = demoMode;
  }
});
