export const inferenceModes = [
  ["auto", "Auto router"], ["prefer-device", "Prefer on-device"], ["prefer-cloud", "Prefer cloud"],
  ["only-device", "Only on-device"], ["only-cloud", "Only cloud"],
] as const;

export type ModeOverride = typeof inferenceModes[number][0];

export interface Settings {
  mock: boolean;
  privacyMode: boolean;
  modeOverride: ModeOverride;
  firestoreBackup: boolean;
  appCheckDebugToken?: string;
}

export async function readSettings(): Promise<Settings> {
  const { mock, privacyMode, modeOverride, appCheckDebugToken, firestoreBackup } = await chrome.storage.local.get<Partial<Settings>>([
    "mock", "privacyMode", "modeOverride", "appCheckDebugToken", "firestoreBackup",
  ]);
  return {
    mock: mock === true,
    privacyMode: privacyMode === true,
    firestoreBackup: firestoreBackup === true,
    modeOverride: modeOverride && inferenceModes.some(([mode]) => mode === modeOverride) ? modeOverride : "auto",
    appCheckDebugToken: typeof appCheckDebugToken === "string" ? appCheckDebugToken.trim() : undefined,
  };
}
import { drainQueue, MAX_ATTEMPTS, queueState } from "../ai/queue";
import { createRuntime, generateCards } from "../ai/runtime";
import type { Deck } from "../cards/schema";
import { cardStats, formatBytes } from "../cards/stats";
import { buildTsv } from "../export/tsv";
import { shouldUseMock } from "../firebase/config";
import { db } from "../storage/db";
import { listDecks, setDeckName } from "../storage/decks";
import { inferenceModes, readSettings, type ModeOverride, type Settings } from "../storage/settings";
import { refreshDiagnostics } from "./diagnostics";
import { ask, downloadFile, element, message, notify, showDemoBanner } from "./shared";

const privacy = element<HTMLInputElement>("privacy-mode");
const demo = element<HTMLInputElement>("demo-mode");
const mode = element<HTMLSelectElement>("inference-mode");
const debugToken = element<HTMLInputElement>("debug-token");
const exportDeck = element<HTMLSelectElement>("export-deck");
const tsvButton = element<HTMLButtonElement>("export-tsv");
const apkgButton = element<HTMLButtonElement>("export-apkg");
const backupToggle = element<HTMLInputElement>("firestore-backup");
const backupNow = element<HTMLButtonElement>("back-up-now");
const restoreBackup = element<HTMLButtonElement>("restore-backup");
const backupResult = element("backup-result");
let backupBusy = false;

function showActiveSettings(mock: boolean) {
  const simulated = shouldUseMock(mock);
  showDemoBanner(simulated);
  const routing = element("active-routing");
  routing.className = `badge ${privacy.checked || mode.value === "only-device" ? "private" : "neutral"}`;
  const active = privacy.checked ? "Kept local" : mode.selectedOptions[0]?.textContent;
  routing.textContent = simulated ? `Simulated · ${active}` : active ?? "";
  showBackupControls();
}

function onError(error: unknown) {
  notify(message(error, "Margin could not complete this action."), true);
}

async function saveSettings(changes: Partial<Settings>, text = "Settings saved.") {
  try {
    await chrome.storage.local.set(changes);
    showActiveSettings(demo.checked);
    if (changes.mock !== undefined) await refreshLibrary();
    notify(text);
  } catch (error) {
    onError(error);
  }
}

function showBackupControls() {
  const unavailable = privacy.checked ? "Firestore backup is unavailable in Privacy mode."
    : shouldUseMock(demo.checked) ? "Connect Firebase and use Live mode to back up decks."
    : "";
  backupToggle.disabled = backupBusy || !!unavailable;
  backupNow.disabled = restoreBackup.disabled = backupToggle.disabled || !backupToggle.checked;
  element("backup-hint").textContent = unavailable ||
    "Saves card content and review schedules to this Chrome profile’s anonymous backup. Restore adds missing items, including previously backed-up deletions.";
}

async function runBackup(restore: boolean, saveToggle = false) {
  if (backupBusy) return;
  backupBusy = true;
  showBackupControls();
  backupResult.textContent = "";
  try {
    if (saveToggle) {
      const enabled = backupToggle.checked;
      try {
        await chrome.storage.local.set({ firestoreBackup: enabled });
      } catch (error) {
        backupToggle.checked = !enabled;
        throw error;
      }
      if (!enabled) return;
    }
    backupResult.textContent = restore ? "Restoring…" : "Backing up…";
    const response = await chrome.runtime.sendMessage({ type: restore ? "margin.restoreBackup" : "margin.backup" });
    if (!response?.result) throw new Error(response?.error || "Firestore backup failed.");
    const { cards, decks } = response.result;
    backupResult.textContent = `${restore ? "Restored" : "Backed up"} ${cards} ${cards === 1 ? "card" : "cards"} and ${decks} ${decks === 1 ? "deck" : "decks"}.`;
    if (restore) await refreshLibrary();
  } catch (error) {
    backupResult.textContent = message(error, "Firestore backup failed.");
  } finally {
    backupBusy = false;
    showBackupControls();
  }
}

backupToggle.addEventListener("change", () => { void runBackup(false, true); });
backupNow.addEventListener("click", () => { void runBackup(false); });
restoreBackup.addEventListener("click", () => { void runBackup(true); });

privacy.addEventListener("change", () => {
  mode.disabled = privacy.checked;
  void saveSettings({ privacyMode: privacy.checked });
});
demo.addEventListener("change", () => {
  void saveSettings({ mock: demo.checked }).then(readSettings).then(refreshDiagnostics).catch(onError);
});
mode.addEventListener("change", () => { void saveSettings({ modeOverride: mode.value as ModeOverride }); });
element("debug-form").addEventListener("submit", (event) => {
  event.preventDefault();
  void saveSettings({ appCheckDebugToken: debugToken.value.trim() }, "App Check token saved. Reopen Margin to apply it.");
});

function deckEditor(deck: Deck): HTMLFormElement {
  const form = document.createElement("form");
  form.className = "deck-editor stack";
  const label = document.createElement("label");
  label.textContent = "Deck name";
  const name = document.createElement("input");
  name.value = deck.name;
  name.maxLength = 80;
  name.required = true;
  label.append(name);
  const buttons = document.createElement("div");
  buttons.className = "actions";

  const rename = document.createElement("button");
  rename.type = "submit";
  rename.className = "secondary small";
  rename.textContent = "Rename";
  const remove = document.createElement("button");
  remove.type = "button";
  remove.className = "quiet danger small";
  remove.textContent = "Delete";
  buttons.append(rename, remove);
  form.append(label, buttons);

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    rename.disabled = remove.disabled = true;
    void setDeckName(name.value, deck).then(async () => {
      await refreshLibrary();
      notify("Deck renamed.");
    }).catch(onError).finally(() => { rename.disabled = remove.disabled = false; });
  });
  remove.addEventListener("click", () => {
    if (!confirm(`Delete “${deck.name}” and its cards, review history, and queued captures?`)) return;
    rename.disabled = remove.disabled = true;
    void navigator.locks.request("margin-decks", () => db.deleteDeck(deck.id)).then(async () => {
      await Promise.all([refreshLibrary(), refreshQueue()]);
      notify("Deck deleted.");
    }).catch(onError).finally(() => { rename.disabled = remove.disabled = false; });
  });
  return form;
}

async function refreshLibrary() {
  const previous = exportDeck.value;
  const [decks, cards] = await Promise.all([listDecks(), db.all("cards")]);
  exportDeck.replaceChildren(new Option("All decks", ""), ...decks.map(({ id, name }) => new Option(name, id)));
  if (decks.some(({ id }) => id === previous)) exportDeck.value = previous;
  element("managed-decks").replaceChildren(...decks.map(deckEditor));
  const simulated = shouldUseMock(demo.checked);
  element("stats-heading").textContent = simulated ? "Simulated on-device activity" : "On-device activity";
  const stats = cardStats(cards.filter((card) => card.route?.simulated === simulated));
  element("on-device-percent").textContent = `${stats.onDevicePercent}%`;
  element("bytes-local").textContent = formatBytes(stats.localBytes);
  element("count-device").textContent = `On-device ${stats.onDeviceCount}`;
  element("count-cloud").textContent = `Cloud ${stats.cloudCount}`;
  element("chart-device").style.flexGrow = String(stats.onDeviceCount);
  element("chart-cloud").style.flexGrow = String(stats.cloudCount);
}

async function exportCards(format: "tsv" | "apkg") {
  tsvButton.disabled = apkgButton.disabled = true;
  try {
    const id = exportDeck.value;
    const [allCards, allDecks] = await Promise.all([db.all("cards"), listDecks()]);
    const cards = allCards.filter((card) => !id || card.deckId === id);
    const decks = allDecks.filter((deck) => !id || deck.id === id);
    if (!cards.length) throw new Error("There are no saved cards to export in this selection.");
    const name = id ? decks[0]?.name ?? "Margin" : "Margin";
    const filename = `${name.replace(/[\\/:*?"<>|]/gu, "-")}.${format}`;
    if (format === "tsv") {
      downloadFile(buildTsv(cards, decks), filename, "text/tab-separated-values;charset=utf-8");
    } else {
      const { buildApkg } = await import("../export/apkg");
      const bytes = await buildApkg(cards, decks);
      downloadFile(Uint8Array.from(bytes), filename, "application/octet-stream");
    }
    notify(`Exported ${cards.length} ${cards.length === 1 ? "card" : "cards"}.`);
  } catch (error) {
    onError(error);
  } finally {
    tsvButton.disabled = apkgButton.disabled = false;
  }
}

tsvButton.addEventListener("click", () => { void exportCards("tsv"); });
apkgButton.addEventListener("click", () => { void exportCards("apkg"); });

async function refreshQueue() {
  const [queue, decks] = await Promise.all([db.all("queue"), db.all("decks")]);
  const list = element("queue-list");
  if (!queue.length) {
    const empty = document.createElement("p");
    empty.className = "hint";
    empty.textContent = "No captures waiting to retry.";
    list.replaceChildren(empty);
    return;
  }

  list.replaceChildren(...queue.sort((a, b) => a.createdAt - b.createdAt).map((entry) => {
    const job = document.createElement("article");
    job.className = "queue-item stack";
    const title = document.createElement("h3");
    title.textContent = entry.job.source?.title || "Untitled capture";
    const badge = document.createElement("span");
    const state = queueState(entry);
    badge.className = `badge ${state === "failed" ? "failed" : "queued"}`;
    badge.textContent = state === "failed" ? "Failed" : state === "confirm" ? "Needs approval" : "Queued";
    const deck = decks.find(({ id }) => id === entry.job.deckId);
    const reason = document.createElement("p");
    reason.className = "hint";
    const attempts = entry.attempts ? `${Math.min(entry.attempts, MAX_ATTEMPTS)} of ${MAX_ATTEMPTS} attempts` : undefined;
    reason.textContent = [deck?.name, attempts, entry.lastError ?? entry.reason].filter(Boolean).join(" · ");
    const retry = document.createElement("button");
    retry.type = "button";
    retry.className = "secondary small";
    const retryLabel = state === "confirm" ? "Review capture" : "Retry";
    retry.textContent = retryLabel;
    const remove = document.createElement("button");
    remove.type = "button";
    remove.className = "quiet danger small";
    remove.textContent = "Remove";
    const actions = document.createElement("div");
    actions.className = "actions";
    actions.append(retry, remove);

    retry.addEventListener("click", async () => {
      if (!navigator.onLine) {
        notify("Reconnect to retry this capture.", true);
        return;
      }
      retry.disabled = remove.disabled = true;
      retry.textContent = "Retrying…";
      try {
        await drainQueue(async (pending) => {
          const current = await createRuntime();
          const result = await generateCards(pending, current.provider, { ...current, online: navigator.onLine }, {
            queueIfOffline: false, confirmCloud: (reason) => ask("cloud-dialog", reason),
          });
          return result?.cards;
        }, () => navigator.onLine, db, entry.id);
        void chrome.runtime.sendMessage({ type: "margin.queueChanged" }).catch(() => {});
        const remaining = await db.get("queue", entry.id);
        if (remaining) notify(remaining.lastError ?? "This capture is still queued.", true);
        else notify("Queued capture processed.");
        await Promise.all([refreshLibrary(), refreshQueue()]);
      } catch (error) {
        onError(error);
      } finally {
        retry.disabled = remove.disabled = false;
        retry.textContent = retryLabel;
      }
    });
    remove.addEventListener("click", () => {
      void db.delete("queue", entry.id).then(() => {
        void chrome.runtime.sendMessage({ type: "margin.queueChanged" }).catch(() => {});
        return refreshQueue();
      }).catch(onError);
    });
    job.append(title, badge, reason, actions);
    return job;
  }));
}

async function start() {
  const settings = await readSettings();
  privacy.checked = settings.privacyMode;
  demo.checked = settings.mock;
  mode.replaceChildren(...inferenceModes.map(([value, label]) => new Option(label, value)));
  mode.value = settings.modeOverride;
  mode.disabled = settings.privacyMode;
  debugToken.value = settings.appCheckDebugToken ?? "";
  backupToggle.checked = settings.firestoreBackup;
  showActiveSettings(settings.mock);
  await Promise.all([refreshLibrary(), refreshQueue(), refreshDiagnostics(settings)]);
}

void start().catch(onError);
import assert from "node:assert/strict";
import { test } from "node:test";
import { InferenceMode } from "firebase/ai";
import { CELL_BIOLOGY_PASSAGE } from "../../src/ai/demoSamples";
import { MockProvider } from "../../src/ai/mockProvider";
import type { AIProvider, GenerationJob, InferenceRequest } from "../../src/ai/provider";
import { drainQueue, enqueue } from "../../src/ai/queue";
import { generateCards } from "../../src/ai/runtime";
import { isConfigured } from "../../src/firebase/config";
import { DEFAULTS, loadRemoteConfig } from "../../src/firebase/remoteConfig";
import { createMemoryDatabase } from "../../src/storage/db";

const job: GenerationJob = {
  deckId: "bio",
  input: { kind: "text", text: "Photosynthesis is the conversion of light into chemical energy. Plants use chlorophyll." },
};
const request: InferenceRequest = {
  task: { kind: "cards", input: job.input },
  mode: InferenceMode.PREFER_ON_DEVICE,
  reason: "The text fits.",
  cloudModel: DEFAULTS.cloudModel,
};

test("uses pure Remote Config defaults and recognizes the unconfigured placeholder", async () => {
  assert.equal(isConfigured({ apiKey: "REPLACE_ME", appId: "demo", projectId: "demo" }), false);
  assert.equal(isConfigured({ apiKey: "test", appId: "demo", projectId: "demo" }), true);
  assert.deepEqual(await loadRemoteConfig(), DEFAULTS);
  assert.notEqual(await loadRemoteConfig(), DEFAULTS);
});

test("mock generation is deterministic, uses definitions, and reports simulated source", async () => {
  const mock = new MockProvider();
  const local = await mock.generate(request);
  assert.deepEqual(local, await mock.generate(request));
  assert.equal(local.source, "on_device");
  assert.match(local.reason, /^Simulated — .*Firebase AI Logic preferred Gemini Nano$/u);
  assert.equal(local.simulated, true);
  const cards = JSON.parse(local.text);
  assert.equal(cards[0].front, "What is Photosynthesis?");
  assert.match(cards[0].back, /chemical energy/);
  assert.equal(cards.length, 2);

  const cloud = await new MockProvider({ nano: "unavailable" }).generate(request);
  assert.equal(cloud.source, "in_cloud");
  assert.equal(cloud.reason, "Simulated — Gemini Nano not ready — Firebase AI Logic fell back to cloud");
  assert.equal(cloud.text, local.text);
  assert.equal((await mock.generate({ ...request, mode: InferenceMode.ONLY_IN_CLOUD })).source, "in_cloud");
});

test("demo cards resolve process references, omit ambiguous subjects, and offer a curated cloze", async () => {
  const mock = new MockProvider();
  const cards = async (text: string) => JSON.parse((await mock.generate({
    ...request, task: { kind: "cards", input: { kind: "text", text } },
  })).text);
  const generated = await cards("Glycolysis is the breakdown of glucose. The process occurs in the cytosol. This energy is stored in bonds. It is the main source of energy. Mitochondria produce ATP.");
  assert.deepEqual(generated.map((card: { front: string }) => card.front), [
    "What is Glycolysis?", "Where does Glycolysis happen?", "Mitochondria produce {{c1::ATP}}.",
  ]);
  const sample = await cards(CELL_BIOLOGY_PASSAGE);
  assert.equal(sample.length, 8);
  assert.ok(sample.some((card: { type: string }) => card.type === "cloze"));
});

test("mock supports initializing, unavailable local inference, and offline inference", async () => {
  const mock = new MockProvider({ nano: "downloadable" });
  const pinned = { ...request, mode: InferenceMode.ONLY_ON_DEVICE };
  await assert.rejects(mock.generate(pinned), /unavailable/);
  const milestones: number[] = [];
  await mock.initializeDeviceModel((value) => milestones.push(value));
  assert.deepEqual(milestones, [1]);
  assert.equal((await mock.status()).nano, "available");
  assert.equal((await mock.generate(pinned)).source, "on_device");

  const offline = new MockProvider({ online: false });
  assert.equal((await offline.generate(request)).source, "on_device");
  await assert.rejects(offline.generate({ ...request, mode: InferenceMode.ONLY_IN_CLOUD }), /offline/);
});

test("mock grading and sensitivity return structured results", async () => {
  const mock = new MockProvider();
  const grade = await mock.generate({
    ...request,
    task: { kind: "grade", question: "What does the plant use?", expected: "sunlight and water", answer: "sunlight and water" },
  });
  assert.deepEqual(JSON.parse(grade.text), { verdict: "correct", missing: [], suggestedRating: 3 });
  const classification = await mock.generate({
    ...request, mode: InferenceMode.ONLY_ON_DEVICE, task: { kind: "sensitivity", text: "This is a confidential memo." },
  });
  assert.equal(classification.source, "on_device");
  assert.deepEqual(JSON.parse(classification.text), { sensitive: true });
});

test("demo grading accepts concise synonyms and reports only missing concepts", async () => {
  const mock = new MockProvider();
  const grade = async (answer: string) => JSON.parse((await mock.generate({
    ...request,
    task: { kind: "grade", question: "What is made during glycolysis?", expected: "A molecule called ATP stores usable energy.", answer },
  })).text);
  assert.deepEqual(await grade("ATP energy"), { verdict: "partial", missing: ["molecule", "stores"], suggestedRating: 2 });
  assert.deepEqual(await grade("The molecule adenosine triphosphate stores power."), { verdict: "correct", missing: [], suggestedRating: 3 });
  assert.equal((await grade("the and a")).verdict, "incorrect");
});

test("the optional on-device sensitivity gate precedes any cloud-capable generation", async () => {
  const mock = new MockProvider();
  const calls: InferenceRequest[] = [];
  const steps: string[] = [];
  const provider: AIProvider = {
    status: () => mock.status(),
    initializeDeviceModel: () => mock.initializeDeviceModel(),
    generate: (req) => { calls.push(req); steps.push(req.task.kind); return mock.generate(req); },
  };
  const privateJob: GenerationJob = {
    ...job, input: { kind: "text", text: "This is a confidential memo for the legal team. Chlorophyll absorbs light in plants." },
  };
  const context = { config: DEFAULTS, online: true, privacyMode: false, modeOverride: "only-cloud" } as const;
  const result = await generateCards(privateJob, provider, context, { onStage: (stage) => steps.push(stage) });
  assert.deepEqual(calls.map(({ task, mode }) => [task.kind, mode]), [
    ["sensitivity", InferenceMode.ONLY_ON_DEVICE], ["cards", InferenceMode.ONLY_ON_DEVICE],
  ]);
  assert.equal(result?.cards?.[0].route.source, "on_device");
  assert.match(result?.cards?.[0].route.reason ?? "", /sensitive/i);
  assert.deepEqual(steps.splice(0), ["Checking privacy on-device…", "sensitivity", "Generating on-device…", "cards"]);
  await generateCards(job, provider, context, { onStage: (stage) => steps.push(stage) });
  assert.deepEqual(steps, ["Checking privacy on-device…", "sensitivity", "Generating…", "cards"]);
});

test("the offline queue retains failures and atomically saves cards on retry", async () => {
  const database = createMemoryDatabase();
  const entry = await enqueue(job, "Offline.", database);
  let runs = 0;
  await drainQueue(async () => { runs++; return []; }, () => false, database);
  assert.equal(runs, 0);

  await drainQueue(async () => { throw new Error("Try again."); }, () => true, database);
  assert.equal((await database.get("queue", entry.id))?.lastError, "Try again.");
  assert.equal((await database.get("queue", entry.id))?.attempts, 1);

  await drainQueue(async (queued) => {
    const result = await generateCards(queued, new MockProvider(), { config: DEFAULTS, online: true, privacyMode: false });
    return result?.cards;
  }, () => true, database, undefined, () => Date.now() + 30_000);

  assert.equal(await database.get("queue", entry.id), undefined);
  assert.equal((await database.all("cards")).length, 2);
});

test("a malformed model response gets one repair attempt in the same inference mode", async () => {
  const mock = new MockProvider();
  const calls: InferenceRequest[] = [];
  const provider: AIProvider = {
    status: () => mock.status(),
    initializeDeviceModel: () => mock.initializeDeviceModel(),
    async generate(req) {
      calls.push(req);
      const output = await mock.generate(req);
      return req.repair ? output : { ...output, text: "Unparseable result." };
    },
  };
  const result = await generateCards(job, provider, { config: DEFAULTS, online: true, privacyMode: true });
  assert.deepEqual(calls.map(({ mode, repair }) => [mode, repair]), [
    [InferenceMode.ONLY_ON_DEVICE, false], [InferenceMode.ONLY_ON_DEVICE, true],
  ]);
  assert.equal(result?.cards?.length, 2);
});

test("queue backs off exponentially and stops after three attempts", async () => {
  const database = createMemoryDatabase();
  const entry = await enqueue(job, "Offline.", database);
  let time = 1_000;
  let attempts = 0;
  const run = () => drainQueue(async () => {
    attempts++;
    throw new Error("Service unavailable.");
  }, () => true, database, undefined, () => time);
  await run();
  assert.equal((await database.get("queue", entry.id))?.nextAttemptAt, time + 30_000);
  time += 29_999;
  await run();
  assert.equal(attempts, 1);
  time++;
  await run();
  assert.equal((await database.get("queue", entry.id))?.nextAttemptAt, time + 60_000);
  time += 60_000;
  await run();
  time += 300_000;
  await run();
  assert.equal(attempts, 3);
  assert.equal((await database.get("queue", entry.id))?.state, "failed");
});

test("short Auto text checks sensitivity before hybrid generation, and malformed classification stays local", async () => {
  const mock = new MockProvider();
  const calls: InferenceRequest[] = [];
  let classification = 'Output: ```json\n{"sensitive": false,}\n```';
  const provider: AIProvider = {
    status: () => mock.status(),
    initializeDeviceModel: () => mock.initializeDeviceModel(),
    async generate(req) {
      calls.push(req);
      const output = await mock.generate(req);
      return req.task.kind === "sensitivity" ? { ...output, text: classification } : output;
    },
  };
  const context = { config: DEFAULTS, online: true, privacyMode: false };
  const auto = await generateCards(job, provider, context);
  assert.equal(auto?.cards?.[0]?.route.source, "on_device");
  assert.deepEqual(calls.splice(0).map(({ task, mode }) => [task.kind, mode]), [
    ["sensitivity", InferenceMode.ONLY_ON_DEVICE], ["cards", InferenceMode.PREFER_ON_DEVICE],
  ]);
  const cloud = await generateCards(job, provider, { ...context, modeOverride: "only-cloud" });
  assert.equal(cloud?.cards?.[0]?.route.source, "in_cloud");
  classification = "Unknown response.";
  const local = await generateCards(job, provider, { ...context, modeOverride: "only-cloud" });
  assert.equal(local?.cards?.[0]?.route.source, "on_device");
});

test("short Auto generation records the provider's actual cloud fallback", async () => {
