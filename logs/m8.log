+      cost = overlap;
+      start = index;
+      for (let remaining = overlap; remaining > 0; remaining -= units[start].cost) start--;
+    }
+    cost += unit.cost;
+  }
+  chunks.push(units.slice(start).map((part) => part.text).join(""));
+  return chunks;
