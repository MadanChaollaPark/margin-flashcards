import { drainQueue, MAX_ATTEMPTS, queueState } from "../ai/queue";
import { createRuntime, generateCards } from "../ai/runtime";
import type { Deck } from "../cards/schema";
import { cardStats, formatBytes } from "../cards/stats";
import { buildTsv } from "../export/tsv";
import { isConfigured, shouldUseMock } from "../firebase/config";
import { db } from "../storage/db";
import { listDecks, setDeckName } from "../storage/decks";
import { inferenceModes, readSettings, type ModeOverride, type Settings } from "../storage/settings";
import { ask, downloadFile, element, fillRoutingRules, message, notify, showDemoBanner } from "./shared";

const privacy = element<HTMLInputElement>("privacy-mode");
const demo = element<HTMLInputElement>("demo-mode");
const mode = element<HTMLSelectElement>("inference-mode");
const debugToken = element<HTMLInputElement>("debug-token");
const exportDeck = element<HTMLSelectElement>("export-deck");
const tsvButton = element<HTMLButtonElement>("export-tsv");
const apkgButton = element<HTMLButtonElement>("export-apkg");

function showActiveSettings(mock: boolean) {
  const simulated = shouldUseMock(mock);
  showDemoBanner(simulated);
  const routing = element("active-routing");
  routing.className = `badge ${privacy.checked || mode.value === "only-device" ? "private" : "neutral"}`;
  const active = privacy.checked ? "Kept local" : mode.selectedOptions[0]?.textContent;
  routing.textContent = simulated ? `Simulated · ${active}` : active ?? "";
  element("firebase-status").textContent = isConfigured()
    ? "Firebase configuration is present."
    : "Firebase is unconfigured. Margin uses demo mode.";
}

function onError(error: unknown) {
  notify(message(error, "Margin could not complete this action."), true);
}

async function saveSettings(changes: Partial<Settings>, text = "Settings saved.") {
  try {
    await chrome.storage.local.set(changes);
    showActiveSettings(demo.checked);
    if (changes.mock !== undefined) await refreshLibrary();
    notify(text);
  } catch (error) {
    onError(error);
  }
}

async function showRemoteConfig() {
  const { config } = await createRuntime();
  fillRoutingRules(config);
  const labels = {
    maxOnDeviceTokens: "On-device token limit",
    cloudModel: "Cloud model",
    longDocModel: "Long-document model",
    sensitivityCheck: "Sensitivity check",
    maxCardsPerChunk: "Cards per chunk",
  };
  element("remote-config").replaceChildren(...Object.entries(config).map(([key, value]) => {
    const row = document.createElement("div");
    const term = document.createElement("dt");
    term.textContent = labels[key as keyof typeof labels];
    const description = document.createElement("dd");
    description.textContent = typeof value === "boolean" ? (value ? "On" : "Off") : String(value);
    row.append(term, description);
    return row;
  }));
}

privacy.addEventListener("change", () => {
  mode.disabled = privacy.checked;
  void saveSettings({ privacyMode: privacy.checked });
});
demo.addEventListener("change", () => {
  void saveSettings({ mock: demo.checked }).then(showRemoteConfig).catch(onError);
});
mode.addEventListener("change", () => { void saveSettings({ modeOverride: mode.value as ModeOverride }); });
element("debug-form").addEventListener("submit", (event) => {
  event.preventDefault();
  void saveSettings({ appCheckDebugToken: debugToken.value.trim() }, "App Check token saved. Reopen Margin to apply it.");
});

function deckEditor(deck: Deck): HTMLFormElement {
  const form = document.createElement("form");
  form.className = "deck-editor stack";
  const label = document.createElement("label");
  label.textContent = "Deck name";
  const name = document.createElement("input");
  name.value = deck.name;
  name.maxLength = 80;
  name.required = true;
  label.append(name);
  const buttons = document.createElement("div");
  buttons.className = "actions";

  const rename = document.createElement("button");
  rename.type = "submit";
  rename.className = "secondary small";
  rename.textContent = "Rename";
  const remove = document.createElement("button");
  remove.type = "button";
  remove.className = "quiet danger small";
  remove.textContent = "Delete";
  buttons.append(rename, remove);
  form.append(label, buttons);

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    rename.disabled = remove.disabled = true;
    void setDeckName(name.value, deck).then(async () => {
      await refreshLibrary();
      notify("Deck renamed.");
    }).catch(onError).finally(() => { rename.disabled = remove.disabled = false; });
  });
  remove.addEventListener("click", () => {
    if (!confirm(`Delete “${deck.name}” and its cards, review history, and queued captures?`)) return;
    rename.disabled = remove.disabled = true;
    void navigator.locks.request("margin-decks", () => db.deleteDeck(deck.id)).then(async () => {
      await Promise.all([refreshLibrary(), refreshQueue()]);
      notify("Deck deleted.");
    }).catch(onError).finally(() => { rename.disabled = remove.disabled = false; });
  });
  return form;
}

async function refreshLibrary() {
  const previous = exportDeck.value;
  const [decks, cards] = await Promise.all([listDecks(), db.all("cards")]);
  exportDeck.replaceChildren(new Option("All decks", ""), ...decks.map(({ id, name }) => new Option(name, id)));
  if (decks.some(({ id }) => id === previous)) exportDeck.value = previous;
  element("managed-decks").replaceChildren(...decks.map(deckEditor));
  const simulated = shouldUseMock(demo.checked);
  element("stats-heading").textContent = simulated ? "Simulated on-device activity" : "On-device activity";
  const stats = cardStats(cards.filter((card) => card.route.simulated === simulated));
  element("on-device-percent").textContent = `${stats.onDevicePercent}%`;
  element("bytes-local").textContent = formatBytes(stats.localBytes);
  element("count-device").textContent = `On-device ${stats.onDeviceCount}`;
  element("count-cloud").textContent = `Cloud ${stats.cloudCount}`;
  element("chart-device").style.flexGrow = String(stats.onDeviceCount);
  element("chart-cloud").style.flexGrow = String(stats.cloudCount);
}

async function exportCards(format: "tsv" | "apkg") {
  tsvButton.disabled = apkgButton.disabled = true;
  try {
    const id = exportDeck.value;
    const [allCards, allDecks] = await Promise.all([db.all("cards"), listDecks()]);
    const cards = allCards.filter((card) => !id || card.deckId === id);
    const decks = allDecks.filter((deck) => !id || deck.id === id);
    if (!cards.length) throw new Error("There are no saved cards to export in this selection.");
    const name = id ? decks[0]?.name ?? "Margin" : "Margin";
    const filename = `${name.replace(/[\\/:*?"<>|]/gu, "-")}.${format}`;
    if (format === "tsv") {
      downloadFile(buildTsv(cards, decks), filename, "text/tab-separated-values;charset=utf-8");
    } else {
      const { buildApkg } = await import("../export/apkg");
      const bytes = await buildApkg(cards, decks);
      downloadFile(Uint8Array.from(bytes), filename, "application/octet-stream");
    }
    notify(`Exported ${cards.length} ${cards.length === 1 ? "card" : "cards"}.`);
  } catch (error) {
    onError(error);
  } finally {
    tsvButton.disabled = apkgButton.disabled = false;
  }
}

tsvButton.addEventListener("click", () => { void exportCards("tsv"); });
apkgButton.addEventListener("click", () => { void exportCards("apkg"); });

async function refreshQueue() {
  const [queue, decks] = await Promise.all([db.all("queue"), db.all("decks")]);
  const list = element("queue-list");
  if (!queue.length) {
    const empty = document.createElement("p");
    empty.className = "hint";
    empty.textContent = "No captures waiting to retry.";
    list.replaceChildren(empty);
    return;
  }

  list.replaceChildren(...queue.sort((a, b) => a.createdAt - b.createdAt).map((entry) => {
    const job = document.createElement("article");
    job.className = "queue-item stack";
    const title = document.createElement("h3");
    title.textContent = entry.job.source?.title || "Untitled capture";
    const badge = document.createElement("span");
    const state = queueState(entry);
    badge.className = `badge ${state === "failed" ? "failed" : "queued"}`;
    badge.textContent = state === "failed" ? "Failed" : state === "confirm" ? "Needs approval" : "Queued";
    const deck = decks.find(({ id }) => id === entry.job.deckId);
    const reason = document.createElement("p");
    reason.className = "hint";
    const attempts = entry.attempts ? `${Math.min(entry.attempts, MAX_ATTEMPTS)} of ${MAX_ATTEMPTS} attempts` : undefined;
    reason.textContent = [deck?.name, attempts, entry.lastError ?? entry.reason].filter(Boolean).join(" · ");
    const retry = document.createElement("button");
    retry.type = "button";
    retry.className = "secondary small";
    const retryLabel = state === "confirm" ? "Review capture" : "Retry";
    retry.textContent = retryLabel;
    const remove = document.createElement("button");
    remove.type = "button";
    remove.className = "quiet danger small";
    remove.textContent = "Remove";
    const actions = document.createElement("div");
    actions.className = "actions";
    actions.append(retry, remove);

    retry.addEventListener("click", async () => {
      if (!navigator.onLine) {
        notify("Reconnect to retry this capture.", true);
        return;
      }
      retry.disabled = remove.disabled = true;
      retry.textContent = "Retrying…";
      try {
        await drainQueue(async (pending) => {
          const current = await createRuntime();
          const result = await generateCards(pending, current.provider, { ...current, online: navigator.onLine }, {
            queueIfOffline: false, confirmCloud: (reason) => ask("cloud-dialog", reason),
          });
          return result?.cards;
        }, () => navigator.onLine, db, entry.id);
        void chrome.runtime.sendMessage({ type: "margin.queueChanged" }).catch(() => {});
        const remaining = await db.get("queue", entry.id);
        if (remaining) notify(remaining.lastError ?? "This capture is still queued.", true);
        else notify("Queued capture processed.");
        await Promise.all([refreshLibrary(), refreshQueue()]);
      } catch (error) {
        onError(error);
      } finally {
        retry.disabled = remove.disabled = false;
        retry.textContent = retryLabel;
      }
    });
    remove.addEventListener("click", () => {
      void db.delete("queue", entry.id).then(() => {
        void chrome.runtime.sendMessage({ type: "margin.queueChanged" }).catch(() => {});
        return refreshQueue();
      }).catch(onError);
    });
    job.append(title, badge, reason, actions);
    return job;
  }));
}

async function start() {
  const settings = await readSettings();
  privacy.checked = settings.privacyMode;
  demo.checked = settings.mock;
  mode.replaceChildren(...inferenceModes.map(([value, label]) => new Option(label, value)));
  mode.value = settings.modeOverride;
  mode.disabled = settings.privacyMode;
  debugToken.value = settings.appCheckDebugToken ?? "";
  showActiveSettings(settings.mock);
  await Promise.all([refreshLibrary(), refreshQueue(), showRemoteConfig()]);
}

void start().catch(onError);
import { shouldUseMock } from "../firebase/config";
import { NANO_OUTPUT_RESERVE, type RoutingConfig } from "../firebase/remoteConfig";
import { readSettings } from "../storage/settings";

export const element = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

export function message(error: unknown, fallback: string): string {
  return error instanceof Error ? error.message : fallback;
}

export function notify(text: string, error = false): void {
  const toast = element<HTMLElement>("toast");
  toast.textContent = text;
  toast.classList.toggle("error", error);
  toast.hidden = false;
}

export function downloadFile(data: BlobPart, filename: string, type: string): void {
  const url = URL.createObjectURL(new Blob([data], { type }));
  const link = document.createElement("a");
  link.href = url;
  link.download = filename;
  document.body.append(link);
  link.click();
  link.remove();
  setTimeout(() => URL.revokeObjectURL(url), 1_000);
}

export function showDemoBanner(mock: boolean): void {
  element("demo-banner").hidden = !mock;
}

export function watchDemoBanner(): void {
  const update = () => { void readSettings().then(({ mock }) => showDemoBanner(shouldUseMock(mock))); };
  chrome.storage.onChanged.addListener((changes, area) => {
    if (area === "local" && changes.mock) update();
  });
  update();
}

export function ask(id: string, reason: string, action?: () => Promise<boolean>): Promise<boolean> {
  const dialog = element<HTMLDialogElement>(id);
  dialog.querySelector("p")!.textContent = reason;
  dialog.returnValue = "";
  return new Promise((resolve, reject) => {
    dialog.addEventListener("close", () => resolve(dialog.returnValue === "allow"), { once: true });
    const allow = dialog.querySelector<HTMLButtonElement>('[value="allow"]')!;
    allow.onclick = action ? (event) => {
      event.preventDefault();
      allow.disabled = true;
      void action().then((granted) => dialog.close(granted ? "allow" : "cancel"), (error) => {
        reject(error);
        dialog.close();
      }).finally(() => { allow.disabled = false; });
    } : null;
    dialog.showModal();
  });
}

export function fillRoutingRules(config: RoutingConfig): void {
  const rules = [
    ["On-device", `In Auto, up to ${config.maxOnDeviceTokens.toLocaleString()} estimated tokens when Nano is ready, with ${NANO_OUTPUT_RESERVE.toLocaleString()} reserved for output. Privacy mode and Only on-device require local inference.`],
    ["Cloud", `${config.cloudModel} for standard requests. ${config.longDocModel} for long text, scanned PDFs, and videos without captions. With Nano ready, long text splits into local chunks when offline, private, or set to Prefer on-device.`],
    ["Sensitive content", config.sensitivityCheck
      ? "The local sensitivity check is on. Sensitive text stays local, or asks for approval when a pattern matches and Nano is unavailable."
      : "The local sensitivity check is off. Privacy mode still requires local inference."],
    ["Offline and review", `Cloud jobs queue offline and reroute on retry. Generation allows ${config.maxCardsPerChunk} cards per chunk. Typed answers are graded on-device.`],
  ];
  element("routing-rules").replaceChildren(...rules.map(([title, description]) => {
    const item = document.createElement("li");
    const name = document.createElement("strong");
    name.textContent = title;
    const detail = document.createElement("p");
    detail.textContent = description;
    item.append(name, detail);
    return item;
  }));
}
import { checkAnswer, type AnswerGrade } from "../ai/grade";
import { createRuntime } from "../ai/runtime";
import { renderFront } from "../cards/cloze";
import type { Card, Review } from "../cards/schema";
import { dueAt, dueCards, intervalLabel, nextIntervals, nextSchedule, ratings } from "../srs/fsrs";
import { db } from "../storage/db";
import { element, message, notify, showDemoBanner, watchDemoBanner } from "./shared";

const deckId = new URLSearchParams(location.search).get("deck");
const study = element("study");
const status = element("review-status");
const input = element<HTMLInputElement>("answer");
const check = element<HTMLButtonElement>("check");
const answerForm = element<HTMLFormElement>("answer-form");
const revealButton = element<HTMLButtonElement>("reveal");
const front = element("card-front");
const revealed = element("revealed");
const ratingGroup = element("ratings");
const feedback = element("feedback");
const progress = element<HTMLProgressElement>("progress");

let cards: Card[] = [];
let index = 0;
let checking = false;
let saving = false;
const sessionRatings = [0, 0, 0, 0];

function cardFront(card: Card, shown: boolean) {
  return card.type === "cloze" ? renderFront(card.front, shown) : card.front;
}

function showCard() {
  element("review-progress").textContent = `${index} of ${cards.length} complete`;
  progress.max = Math.max(1, cards.length);
  progress.value = index;
  const card = cards[index];
  if (!card) {
    study.hidden = element("shortcuts").hidden = true;
    element("summary").hidden = false;
    const count = sessionRatings.reduce((sum, value) => sum + value, 0);
    element("summary-count").textContent = `${count} ${count === 1 ? "card" : "cards"} reviewed.`;
    const tally = element("summary-ratings");
    tally.replaceChildren(...ratings.map(([rating, label]) => {
      const item = document.createElement("div");
      const title = document.createElement("dt");
      title.textContent = label;
      const value = document.createElement("dd");
      value.textContent = String(sessionRatings[rating - 1]);
      item.append(title, value);
      return item;
    }));
    return;
  }

  front.textContent = cardFront(card, false);
  const link = element<HTMLAnchorElement>("show-source");
  link.hidden = !card.source?.url || !/^(https?|file):/iu.test(card.source.url);
  if (!link.hidden) {
    link.href = card.source!.url!;
    link.title = card.source?.title ?? "";
  }
  input.value = "";
  input.disabled = false;
  check.disabled = true;
  revealButton.disabled = false;
  answerForm.hidden = false;
  revealed.hidden = feedback.hidden = true;
  front.tabIndex = -1;
  front.focus({ preventScroll: true });
}

function showFeedback(grade: AnswerGrade, simulated: boolean) {
  const labels = { correct: "Correct", partial: "Partly correct", incorrect: "Incorrect" };
  const verdict = document.createElement("strong");
  verdict.textContent = simulated ? `Simulated — ${labels[grade.verdict]}` : labels[grade.verdict];
  const header = document.createElement("div");
  header.className = "row feedback-heading";
  const route = document.createElement("span");
  route.className = "badge device";
  route.textContent = "Graded on-device";
  header.append(verdict, route);
  feedback.dataset.verdict = grade.verdict;
  feedback.replaceChildren(header);
  if (grade.missing.length) {
    const title = document.createElement("p");
    title.textContent = `Missing: ${grade.missing.join(" · ")}`;
    feedback.append(title);
  }
  feedback.hidden = false;
}

function reveal(grade?: AnswerGrade, simulated = false) {
  const card = cards[index];
  if (!card || !revealed.hidden) return;
  front.textContent = cardFront(card, true);
  element("card-back").textContent = card.back;
  const response = input.value.trim();
  element("submitted-answer").hidden = !response;
  element("user-answer").textContent = response;
  answerForm.hidden = true;
  revealed.hidden = false;
  if (grade) showFeedback(grade, simulated);

  ratingGroup.replaceChildren(...nextIntervals(card).map(({ rating, label, milliseconds }) => {
    const button = document.createElement("button");
    const suggested = rating === grade?.suggestedRating;
    button.className = suggested ? "secondary suggested" : "secondary";
    button.type = "button";
    button.dataset.rating = String(rating);
    if (suggested) button.setAttribute("aria-description", "Suggested rating");
    button.textContent = label;
    const interval = document.createElement("span");
    interval.textContent = intervalLabel(milliseconds);
    button.append(interval);
    if (suggested) {
      const chip = document.createElement("span");
      chip.className = "suggestion-chip";
      chip.setAttribute("aria-hidden", "true");
      chip.textContent = "Suggested";
      button.append(chip);
    }
    button.addEventListener("click", () => { void rate(rating); });
    return button;
  }));
  front.focus({ preventScroll: true });
}

async function rate(rating: Review["rating"]) {
  if (saving || revealed.hidden || !cards[index]) return;
  saving = true;
  ratingGroup.inert = true;
  element("toast").hidden = true;
  const card = cards[index];
  try {
    const now = new Date();
    const schedule = nextSchedule(card, rating, now);
    const recorded = await db.recordReview(card, schedule, {
      id: crypto.randomUUID(), cardId: card.id, reviewedAt: now.getTime(), rating,
    });
    if (recorded) sessionRatings[rating - 1]++;
    else notify("This card was already handled in another tab.");
    index++;
    showCard();
  } catch (error) {
    notify(message(error, "Could not save your rating."), true);
  } finally {
    saving = false;
    ratingGroup.inert = false;
  }
}

input.addEventListener("input", () => { check.disabled = !input.value.trim(); });
revealButton.addEventListener("click", () => { if (!checking) reveal(); });
answerForm.addEventListener("submit", async (event) => {
  event.preventDefault();
  const card = cards[index];
  const answer = input.value.trim();
  if (checking || !card || !answer || !revealed.hidden) return;
  checking = input.disabled = check.disabled = revealButton.disabled = true;
  check.textContent = "Checking…";
  element("toast").hidden = true;
  try {
    const { provider, config, mock } = await createRuntime();
    showDemoBanner(mock);
    const grade = await checkAnswer(provider, config.cloudModel, cardFront(card, false), card.back, answer);
    reveal(grade, mock);
  } catch (error) {
    notify(message(error, "Could not check your answer."), true);
  } finally {
    checking = input.disabled = check.disabled = revealButton.disabled = false;
    check.textContent = "Check";
  }
});

window.addEventListener("keydown", (event) => {
  if (event.repeat || event.ctrlKey || event.metaKey || event.altKey || checking || study.hidden) return;
  if (event.target instanceof HTMLElement && event.target.closest("input, textarea, button, a, [contenteditable]")) return;
  if (event.key === " " && revealed.hidden) {
    event.preventDefault();
    reveal();
  }
  if (event.key === "Enter" && revealed.hidden && input.value.trim()) {
    event.preventDefault();
    answerForm.requestSubmit();
  }
  if (/^[1-4]$/u.test(event.key) && !revealed.hidden) {
    event.preventDefault();
    void rate(Number(event.key) as Review["rating"]);
  }
});

async function start() {
  const [all, deck] = await Promise.all([db.all("cards"), deckId ? db.get("decks", deckId) : undefined]);
  if (deckId) {
    element("all-due").hidden = false;
    if (!deck) {
      status.textContent = "This deck could not be found.";
      return;
    }
    document.querySelector("h1")!.textContent = deck.name;
    document.title = `${deck.name} review · Margin`;
  }
  cards = dueCards(all, deckId);
  if (!cards.length) {
    status.hidden = true;
    const next = all.filter((card) => !deckId || card.deckId === deckId)
      .reduce((earliest, card) => Math.min(earliest, dueAt(card)), Infinity);
    element("caught-up").hidden = false;
    if (Number.isFinite(next)) {
      const time = new Intl.DateTimeFormat(undefined, { dateStyle: "medium", timeStyle: "short" }).format(next);
      element("next-due").textContent = `Next review ${time}`;
    } else {
      element("empty-heading").textContent = "No flashcards yet";
      element("next-due").textContent = "Generate and save cards in the Margin side panel to start studying.";
    }
    return;
  }
  status.hidden = false;
  status.textContent = `${cards.length} ${cards.length === 1 ? "card" : "cards"} due`;
  status.className = "sr-only";
  study.hidden = element("session-progress").hidden = element("shortcuts").hidden = false;
  showCard();
}

void start().catch(() => { status.textContent = "Margin could not load your flashcards."; });

