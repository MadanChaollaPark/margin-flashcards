function routeBadge(label: string, style: string, reason: string): HTMLElement {
  const details = document.createElement("details");
  details.className = "route";
  const summary = document.createElement("summary");
  summary.className = `badge ${style}`;
  summary.textContent = label;
  summary.title = reason;
  const explanation = document.createElement("p");
  explanation.className = "hint";
  explanation.textContent = reason;
  details.append(summary, explanation);
  return details;
}

function updateSaveBar() {
  if (!cards.length) expandCapture(true);
  element("save-bar").hidden = !cards.length;
  element("empty-preview").hidden = !!cards.length;
  const count = `${cards.length} ${cards.length === 1 ? "card" : "cards"}`;
  element("preview-count").textContent = cards.length ? count : "";
  accept.textContent = `Save ${count} to ${deck.selectedOptions[0]?.textContent ?? "deck"}`;
  actions.className = "row card-actions";
  actions.append(edit, remove);
  const top = document.createElement("div");
  top.className = "row card-top";
  const local = card.route.source === "on_device";
  const keptLocal = local && /sensitive|privacy mode|require on-device/iu.test(card.route.reason);
  const label = keptLocal ? "Kept local" : local ? "On-device" : "Cloud";
  top.append(routeBadge(card.route.simulated ? `Simulated · ${label}` : label,
    keptLocal ? "private" : local ? "device" : "cloud", card.route.reason), actions);
  container.append(top, summary, editor);
  return container;
}

